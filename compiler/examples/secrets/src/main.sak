// milestone: M3
// needs: none (runs and tests pass today)
// mode: run
// covers: Import LetStmt TupleLit
// expect-exit@native: 75
// expect-stderr@native: `Http` is not available on target `native`

// Design §15.11. The commented-out line is the negative case;
// `tests/ui/V2031_secret_interpolated.sak` checks it. Difference from the design text:
// `Request` and `HttpError` come from `std/request` and `std/response`, and `main` is added: it
// replays the charge from `tests/fixtures/billing.jsonl` (a synthetic cassette, see
// `tests/fixtures/README.md`) with a demo `BILLING_TOKEN`, so the example runs offline; the
// token is sent as a secret header, which the cassette never records or matches. `main`
// declares `Http` (the cassette forwards a miss), so the native target, which has no `Http`
// host, refuses it at startup with exit 75 (RFC 0002 §7, design §17.271 (9)).

import std/decimal.{Decimal}
import std/fs.{Fs}
import std/http.{Http}
import std/path.{Path}
import std/request.{Request}
import std/response.{HttpError}
import std/url.{Url}

pub fn call_billing(amount: Decimal) -> Unit ! {Env, Http, Log, Fail<HttpError>} {
  let token = Env.secret("BILLING_TOKEN").expect("BILLING_TOKEN")
  let req = Http.bearer(Request.post_json(Url.from("https://billing/charge"), amount), token)
  // ok: Decimal is Show; `to_string` is its display form
  Log.event(Level.Info, "charging {Decimal.to_string(amount)}", [])
  // Log.event(Level.Info, "token {token}", [])            // V2031: Secret<String> is not Show
  let _ = Http.send(req)
}

pub fn main() -> Unit ! {Console, Fs, Http, Log} {
  let amount = Decimal.parse("12.34").unwrap_or(Decimal.zero())
  let demo = Env.of(Map.of([("BILLING_TOKEN", "demo-token")]))
  with demo, Http.recording(Path.of("tests/fixtures/billing.jsonl")) {
    match try { call_billing(amount) } {
      Ok(_) => Console.print("charged {Decimal.to_string(amount)}"),
      Err(HttpError { reason, .. }) => Console.print("billing failed: {reason}"),
    }
  }
}

test "the recorded charge replays without the token" {
  let amount = Decimal.parse("12.34").unwrap_or(Decimal.zero())
  with Fs.rooted(Test.fixtures()),
      Env.of(Map.of([("BILLING_TOKEN", "demo-token")])),
      Log.captured(),
      Http.scripted([]),
      Http.recording(Path.of("billing.jsonl")) {
    expect_eq(try { call_billing(amount) }, Ok(()))
    expect(!List.any(Test.output_lines(), fn(l) { String.contains(l, "demo-token") }))
  }
}
