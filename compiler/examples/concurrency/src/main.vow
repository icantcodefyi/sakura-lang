// milestone: M3
// needs: Task handlers and untrusted_* externals in runtime/js, Fail escaping a test (§17.30)
// mode: test
// covers: Import NameList RecordLit TupleLit Lambda WithExpr

// Design §15.10. Difference from the design text: `HttpError` and `Response` come from
// `std/response` (one home module per type, see compiler/std/INDEX.md), and `policy` is
// annotated: from the lambda alone its error type would be just `RateLimited`.

import std/http.{Any, Http, RateLimited}
import std/response.{HttpError, Response}
import std/retry.{Policy, retry}
import std/task.{Timeout, timeout}
import std/url.{Url}

fn fetch_both(a: Url, b: Url) -> (String, String)
  ! {Clock, Http, Random, Task, Fail<HttpError | RateLimited | Timeout>}
{
  let policy: Policy<HttpError | RateLimited> = Policy {
    retry_on: fn(e) {
      match e {
        RateLimited { .. } => true,
        _ => false,
      }
    },
    max_attempts: 3,
    backoff: Duration.millis(200),
    jitter: true,
    deadline: None,
  }
  timeout(Duration.seconds(5), fn() {
    Task.scope(fn(s) {
      let fa = Task.spawn(s, fn() {
        retry(policy, fn() { Response.text(Http.get(a), 1_000_000).trust(@trust("display only")) })
      })
      let fb = Task.spawn(s, fn() {
        retry(policy, fn() { Response.text(Http.get(b), 1_000_000).trust(@trust("display only")) })
      })
      (Task.join(fa), Task.join(fb))
    })
  })
}

test "deterministic under virtual time" {
  with Http.scripted([(Any, Response.status(200, "x"))]),
      Clock.virtual(),
      Random.seeded(1),
      Task.deterministic(1) {
    expect_eq(fetch_both(Url.from("https://a"), Url.from("https://b")), ("x", "x"))
  }
}
