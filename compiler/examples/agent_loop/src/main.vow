// milestone: M3
// needs: std/ai Agent.run, @tool and Tool.of, url"…" templates, std/http
// mode: check
// covers: Attribute ErrorDecl TaggedStr Lambda RecordLit

// Design §15.8. Checked only: an offline test needs a scripted tool-call format for
// `Llm.scripted`, which design §10.7 does not define yet. Differences from the design
// text: no call-site type arguments (§3.2 rule 1), and `.with_user(…)` (not in §10.7)
// is a record update of `ai.Request`.

import std/ai
import std/ai.{Agent, Limits, Model, Prompt, Tool}
import std/http.{Response, Status}

type Answer = { summary: String, sources: List<Url> }
error SearchDown

@tool("Search the internal knowledge base; returns up to 5 snippets")
fn kb_search(query: String) -> List<String> ! {Http, Fail<SearchDown | HttpError | DecodeError>} {
  let resp = Http.get(url"https://kb.internal/search?q={query}")
  if resp.status != Status.of(200) { fail SearchDown }
  let snippets: List<String> = Response.json(resp, 100_000)
  snippets
}

pub fn research(question: Untrusted<String>) -> Answer
  ! {Llm, Http, Budget, Fail<LlmError | ToolError | BudgetExceeded>}
{
  let base: ai.Request<Answer> = Llm.request("Answer with cited sources only.", "")
  let req = ai.Request { ..base, user: Prompt.of([Untrusted(question)]) }
  Agent.run(Llm.with_tools(req, [Tool.of(kb_search)], 8), [Tool.of(kb_search)], fn(_partial) { false })
}

pub fn main() -> Unit ! {Console, Env, Http, Fail<LlmError | ToolError | BudgetExceeded>} {
  let key = Env.secret("ANTHROPIC_API_KEY").expect("set ANTHROPIC_API_KEY")
  with Llm.anthropic(key, Model.default()), Budget.limits(Limits { tokens: 60_000, usd: 2.0, calls: 20 }) {
    let a = research(Untrusted.of("What is our refund policy for annual plans?"))
    Console.print(a.summary)
  }
}
