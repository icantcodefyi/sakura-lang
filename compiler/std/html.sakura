// HTML built so that text is always escaped (design §4.11, §10.4, M3). An `Html` value is
// only made by escaping text, by joining other `Html` values, or by `raw` with a `@trust`
// reason, so markup from outside the program cannot reach a page unescaped. In `html"…"` an
// interpolated `Html` value is markup and any other value goes through `from`, as escaped text
// (design §17.77).

pub opaque type Html = Html(String)

/// `s` as text: `& < > " '` are escaped.
pub fn text(s: String) -> Html { Html(escape(s)) }

/// Untrusted text, escaped; the safe way to show it.
pub fn untrusted(u: Untrusted<String>) -> Html {
  text(Untrusted.trust(u, @trust("escaped as HTML text")))
}

/// Markup inserted as it is. `sakura audit` lists every `@trust` reason.
pub fn raw(markup: String, reason: Trust) -> Html { Html(markup) }

/// `v` shown as escaped text; what `html"…"` applies to an interpolated value that is not
/// `Html` (design §17.77). An interpolated `Untrusted<T>` is converted as its wrapped value,
/// so `html"{u}"` is the escaped raw text, like `untrusted(u)` (design §17.101).
pub fn from<T: Show>(v: T) -> Html { text(show(v)) }

pub fn concat(parts: List<Html>) -> Html { Html(List.join(List.map(parts, to_string), "")) }

pub fn to_string(h: Html) -> String {
  match h {
    Html(s) => s,
  }
}

/// `html"<p>Hello, {name}</p>"`: the literal parts are markup; each argument is already
/// `Html` (an `Html` value as is, anything else through `from`).
pub fn template(parts: List<String>, args: List<Html>) -> Html {
  var out = parts.first().unwrap_or("")
  for pair in List.enumerate(args) {
    out = out + to_string(pair.1) + parts[pair.0 + 1].unwrap_or("")
  }
  Html(out)
}

fn escape(s: String) -> String {
  let amp = String.replace(s, "&", "&amp;")
  let lt = String.replace(amp, "<", "&lt;")
  let gt = String.replace(lt, ">", "&gt;")
  let quot = String.replace(gt, "\"", "&quot;")
  String.replace(quot, "'", "&#39;")
}

test "text is escaped, markup is kept" {
  let name = "<script>alert('x') & \"y\"</script>"
  let page = html"<p>Hi, {name}</p>"
  expect_eq(
    to_string(page),
    "<p>Hi, &lt;script&gt;alert(&#39;x&#39;) &amp; &quot;y&quot;&lt;/script&gt;</p>",
  )
  let list = concat([
    raw("<ul>", @trust("constant markup")),
    text("a<b"),
    raw("</ul>", @trust("constant markup")),
  ])
  expect_eq(to_string(list), "<ul>a&lt;b</ul>")
}

test "a page composes Html fragments as markup and escapes everything else" {
  let title = html"<h1>{"Tom & Jerry"}</h1>"
  let body = Untrusted.of("<img src=x onerror=alert(1)>")
  let banner = raw("<hr class=\"x\">", @trust("constant markup"))
  let count = 3
  let page = html"<main>{title}{banner}<p>{untrusted(body)}</p><p>{count} items</p></main>"
  expect_eq(
    to_string(page),
    "<main><h1>Tom &amp; Jerry</h1><hr class=\"x\"><p>&lt;img src=x onerror=alert(1)&gt;</p><p>3 items</p></main>",
  )
  let direct = html"<p>{body}</p>"
  expect_eq(to_string(direct), "<p>&lt;img src=x onerror=alert(1)&gt;</p>")
}

test "an Untrusted interpolation is escaped text, never markup (design §17.101)" {
  expect_eq(to_string(html"<p>{Untrusted.of("<b>x")}</p>"), "<p>&lt;b&gt;x</p>")
  // An `Untrusted<Html>` goes through `from` like any other value: its shown form, escaped.
  let markup = Untrusted.of(raw("<b>x</b>", @trust("test markup")))
  expect_eq(to_string(html"<p>{markup}</p>"), "<p>Html(&quot;&lt;b&gt;x&lt;/b&gt;&quot;)</p>")
}
