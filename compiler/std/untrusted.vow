// Data from outside the deployment: request bodies, file text, free-text model output
// (design §6.4). `Untrusted` is compiler-known; this module is its home.
// needs M3: `trust(u, @trust("reason"))` (the compiler-known `Trust`, design §17.16),
// `validate` into a refined type, `check` and `len`.

/// Marks `value` as untrusted. For tests and host adapters.
@external(js, "vow_runtime", "untrusted_of")
pub fn of<T>(value: T) -> Untrusted<T>
