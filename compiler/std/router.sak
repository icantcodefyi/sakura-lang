// Request routing (design §10.4, M3). A router is data: routes are matched in the order they
// were added, and `handle` is an ordinary function, so route handlers are tested by calling
// them or the router directly, without a server.

import std/request.{Delete, Get, Method, Patch, Post, Put, Request}
import std/response.{Response, Status}
import std/url.{Url}

/// `e` is what the route handlers perform (design §4.4).
pub opaque type Router<e> = { routes: List<Route<e>> }

type Route<e> = { method: Method, pattern: List<String>, run: fn(Request) -> Response ! e }

pub fn new<e>() -> Router<e> { Router { routes: [] } }

/// Adds a route. A `pattern` segment `:name` matches any one segment and is available to the
/// handler as `Request.param(req, "name")`.
pub fn route<e>(
  r: Router<e>,
  method: Method,
  pattern: String,
  h: fn(Request) -> Response ! e,
) -> Router<e>
{ Router { routes: r.routes.push(Route { method, pattern: segments(pattern), run: h }) } }

pub fn get<e>(r: Router<e>, pattern: String, h: fn(Request) -> Response ! e) -> Router<e> {
  route(r, Get, pattern, h)
}

pub fn post<e>(r: Router<e>, pattern: String, h: fn(Request) -> Response ! e) -> Router<e> {
  route(r, Post, pattern, h)
}

pub fn put<e>(r: Router<e>, pattern: String, h: fn(Request) -> Response ! e) -> Router<e> {
  route(r, Put, pattern, h)
}

pub fn delete<e>(r: Router<e>, pattern: String, h: fn(Request) -> Response ! e) -> Router<e> {
  route(r, Delete, pattern, h)
}

/// The response of the first route matching `req`'s method and path, with its path
/// parameters set; 405 when only the method differs, 404 when no path matches.
pub fn handle<e>(r: Router<e>, req: Request) -> Response ! e {
  let path = segments(Url.path(req.url))
  var path_matched = false
  for rt in r.routes {
    match bind(rt.pattern, path) {
      Some(params) if rt.method == req.method => {
        let h = rt.run
        return h(Request { ..req, params })
      },
      Some(_) => { path_matched = true },
      None => (),
    }
  }
  if path_matched {
    Response.status(405, "method not allowed")
  } else {
    Response.status(404, "not found")
  }
}

fn segments(path: String) -> List<String> {
  List.filter(String.split(path, "/"), fn(s) { s != "" })
}

/// The parameters if `path` matches `pattern`.
fn bind(pattern: List<String>, path: List<String>) -> Option<List<(String, String)>> {
  if List.len(pattern) != List.len(path) {
    None
  } else {
    var params: List<(String, String)> = []
    var ok = true
    for pair in List.zip(pattern, path) {
      if String.starts_with(pair.0, ":") {
        params = params.push((String.slice(pair.0, 1, String.len(pair.0)), pair.1))
      } else if pair.0 != pair.1 {
        ok = false
      }
    }
    if ok { Some(params) } else { None }
  }
}

fn show_user(req: Request) -> Response ! {Console} {
  Console.print("user {Request.param(req, "id").unwrap_or("?")}")
  Response.status(200, "user")
}

test "routes match by method and path, with parameters" {
  let r = new().get("/users/:id", show_user).post("/users", fn(_) { Response.status(201, "made") })
  expect_eq(handle(r, Request.of(Get, Url.from("/users/7?x=1"))).status, Status.from(200))
  expect_output(["user 7"])
  expect_eq(handle(r, Request.post("/users", "")).status, Status.from(201))
  expect_eq(handle(r, Request.of(Patch, Url.from("/users"))).status, Status.from(405))
  expect_eq(handle(r, Request.of(Get, Url.from("/nope"))).status, Status.from(404))
}
