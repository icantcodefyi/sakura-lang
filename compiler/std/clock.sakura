// Time as an effect. Prelude effect. Code that reads the clock says so in its row,
// and tests swap the handler for a deterministic one.

import std/duration.{Duration}
import std/instant.{Instant}

pub effect Clock {
  /// Wall-clock time (UTC).
  fn now() -> Instant
  /// Time since the handler was installed; never goes backwards.
  fn monotonic() -> Duration
  /// Suspends for `d` (returns at once for `d <= 0`).
  fn sleep(d: Duration) -> Unit
}

/// Root handler over the host clock and timers.
@external(js, "sakura_runtime", "clock_host")
pub fn host() -> Handler<Clock>

/// Time stands still at `at`; `sleep` returns immediately. The test default uses
/// `Clock.fixed(Instant.from_unix_millis(0))`.
pub fn fixed(at: Instant) -> Handler<Clock> {
  handler Clock {
    fn now() { at }
    fn monotonic() { Duration.millis(0) }
    fn sleep(d) {}
  }
}

/// Virtual time starting at the Unix epoch: `sleep(d)` parks the task until nothing else can
/// run, then advances `now` and `monotonic` by `d`; sleepers wake in virtual-time order. Use it
/// to test timeouts and backoff.
pub fn virtual() -> Handler<Clock> {
  handler Clock {
    var elapsed = 0
    fn now() { Instant.from_unix_millis(elapsed) }
    fn monotonic() { Duration.millis(elapsed) }
    fn sleep(d) { elapsed = clock_virtual_sleep(elapsed, d.to_millis()) }
  }
}

/// `now + max(ms, 0)`, once every other runnable task has run (runtime/js/ABI.md §6).
@external(js, "sakura_runtime", "clock_virtual_sleep")
fn clock_virtual_sleep(now: Int, ms: Int) -> Int

test "fixed clock never moves" {
  let at = Instant.from_unix_millis(42)
  let seen = with fixed(at) {
    Clock.sleep(Duration.seconds(10))
    (Clock.now(), Clock.monotonic())
  }
  expect_eq(seen, (at, Duration.millis(0)))
}

test "virtual clock advances only by sleeping" {
  let seen = with virtual() {
    let before = Clock.now()
    Clock.sleep(Duration.seconds(3))
    Clock.sleep(Duration.millis(-50))
    (before, Clock.now(), Clock.monotonic())
  }
  expect_eq(
    seen,
    (Instant.from_unix_millis(0), Instant.from_unix_millis(3000), Duration.millis(3000)),
  )
}
