// Data from outside the deployment: request bodies, file text, free-text model output
// (design §6.4). `Untrusted` is compiler-known; this module is its home. It is `Show`, so it
// can be logged, but templates accept it only as a bound parameter or escaped text.

import std/core.{Violation}

/// Marks `value` as untrusted. For tests and host adapters.
@external(js, "sakura_runtime", "untrusted_of")
pub fn of<T>(value: T) -> Untrusted<T>

/// Checks the value against the refined type `V` named by the expected type, e.g.
/// `let e: Email = Untrusted.validate(body)?`. Compiler-known (design §17.71): `V` must refine
/// `T` (`V5003` otherwise) and the call runs `V.validate` on the value; the external is never
/// called.
@external(js, "sakura_runtime", "untrusted_validate")
pub fn validate<T, V>(u: Untrusted<T>) -> Result<V, Violation>

/// Releases the value without checking it. `sakura audit` lists every `@trust` reason.
pub fn trust<T>(u: Untrusted<T>, reason: Trust) -> T { inner(u) }

/// The value if `pred` holds; otherwise a `Violation` naming `clause`.
pub fn check<T>(u: Untrusted<T>, clause: String, pred: fn(T) -> Bool) -> Result<T, Violation> {
  let v = inner(u)
  if pred(v) { Ok(v) } else {
    Err(Violation { type_name: "Untrusted", clause, value_summary: "<untrusted>" })
  }
}

/// `String.len` of the value, so a size limit can be checked before validating.
pub fn len(u: Untrusted<String>) -> Int { String.len(inner(u)) }

@external(js, "sakura_runtime", "untrusted_value")
fn inner<T>(u: Untrusted<T>) -> T
