// JSON values and codecs. Construct and match values qualified (`Json.String(s)`,
// `Json.Object(m)`): the variant names `Bool` and `String` would otherwise collide with
// the prelude types. Typed encode/decode use the derived `Schema` codec (milestone M3).

pub type Json = Null
  | Bool(Bool)
  | Number(Float)
  | String(String)
  | Array(List<Json>)
  | Object(Map<String, Json>)

/// Where and why decoding failed. `path` is a JSON Pointer such as `/items/0/email`.
pub error DecodeError(path: String, message: String)

/// Compact JSON for any `Schema` value; refined fields encode as their base type.
@external(js, "sakura_runtime", "json_encode")
pub fn encode<T: Schema>(value: T) -> String

/// Parses and checks `text` against `T`'s schema, including every refinement. Text that is not
/// JSON fails as `parse` does, with path `""` and message `"malformed JSON"` (or `"JSON nested
/// too deeply"`). A JSON number where an `Int` is expected that is not integral is found as
/// `"a number"`, and one beyond ±(2^53 − 1) as `"a number outside the Int range"`. Members of
/// an object that `T` does not declare are ignored; a program that must refuse them decodes to
/// `Json` and checks the keys. A repeated key keeps its last value.
@external(js, "sakura_runtime", "json_decode")
pub fn decode<T: Schema>(text: String) -> Result<T, DecodeError>

/// `text` as a `Json` value. Any syntax error fails with path `""` and message
/// `"malformed JSON"`, or `"JSON nested too deeply"` past the backend's nesting limit: the
/// message never quotes the input or names a position, and is the same on every backend. A
/// repeated key keeps its last value at its first position.
@external(js, "sakura_runtime", "json_parse")
pub fn parse(text: String) -> Result<Json, DecodeError>

/// The JSON Schema (draft 2020-12) of `T`, with the refinements JSON Schema can state.
/// `witness` only names `T`: `let w: Option<Ticket> = None`, then `Json.schema(w)`.
@external(js, "sakura_runtime", "json_schema")
pub fn schema<T: Schema>(witness: Option<T>) -> Json

/// `j` as JSON text (`JSON.stringify(j, null, indent)`): compact, as `encode`, for `None` or an
/// indent under 1; otherwise one element or member per line, nested `indent` spaces a level (at
/// most 10), `": "` after each key, and `[]`/`{}` for empty containers. Member order, numbers
/// and string escapes are `encode`'s.
pub fn render(j: Json, indent: Option<Int>) -> String {
  let text = encode(j)
  let n = match indent {
    Some(k) if k > 0 => Int.min(k, 10),
    _ => 0,
  }
  if n == 0 { return text }
  let pad = String.repeat(" ", n)
  // Re-indent `encode`'s text, which has no whitespace outside strings.
  var out: List<String> = []
  var depth = 0
  var in_string = false
  var escaped = false
  var opened = false
  for c in String.chars(text) {
    if in_string {
      out = out.push(c)
      if escaped {
        escaped = false
      } else if c == "\\" {
        escaped = true
      } else if c == "\"" {
        in_string = false
      }
    } else if opened && (c == "]" || c == "\}") {
      opened = false
      out = out.push(c)
    } else {
      if opened {
        opened = false
        depth = depth + 1
        out = out.push("\n" + String.repeat(pad, depth))
      }
      if c == "[" || c == "\{" {
        out = out.push(c)
        opened = true
      } else if c == "]" || c == "\}" {
        depth = depth - 1
        out = out.push("\n" + String.repeat(pad, depth) + c)
      } else if c == "," {
        out = out.push(",\n" + String.repeat(pad, depth))
      } else if c == ":" {
        out = out.push(": ")
      } else {
        out = out.push(c)
        in_string = c == "\""
      }
    }
  }
  List.join(out, "")
}

/// The member `key` of an object; `None` for other values or a missing key.
pub fn get(j: Json, key: String) -> Option<Json> {
  match j {
    Json.Object(members) => Map.get(members, key),
    _ => None,
  }
}

/// The member `key` when it is a string.
pub fn get_string(j: Json, key: String) -> Option<String> {
  match get(j, key) {
    Some(Json.String(s)) => Some(s),
    _ => None,
  }
}

test "get and get_string read object members" {
  let j = Json.Object(Map.of([("id", Json.String("u1")), ("n", Json.Number(2.0))]))
  expect_eq(get(j, "n"), Some(Json.Number(2.0)))
  expect_eq(get_string(j, "id"), Some("u1"))
  expect_eq(get_string(j, "n"), None)
  expect_eq(get(Json.Null, "id"), None)
}

test "render indents like JSON.stringify" {
  let j = Json.Object(
    Map.of([
      ("a", Json.Array([Json.Number(1.0), Json.Array([]), Json.Object(Map.empty())])),
      ("b:\"\\", Json.String("x,\\\"]\\")),
    ]),
  )
  expect_eq(render(j, None), encode(j))
  expect_eq(render(j, Some(0)), encode(j))
  expect_eq(render(Json.Array([]), Some(2)), "[]")
  expect_eq(render(Json.Null, Some(2)), "null")
  expect_eq(
    render(j, Some(2)),
    "\{\n  \"a\": [\n    1,\n    [],\n    \{\}\n  ],\n  \"b:\\\"\\\\\": \"x,\\\\\\\"]\\\\\"\n\}",
  )
}
