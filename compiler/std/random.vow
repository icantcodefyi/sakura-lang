// Randomness as an effect. Prelude effect. `Random.seeded(n)` is the test default and
// gives the same sequence on every backend.

import std/uuid.{Uuid}

pub effect Random {
  /// Uniform in `[lo, hi]`, inclusive.
  fn int(lo: Int, hi: Int) -> Int requires lo <= hi
  /// Uniform in `[0, 1)`.
  fn float() -> Float
  fn bytes(n: Int) -> Bytes requires n >= 0
  /// Version 4 (random) UUID.
  fn uuid() -> Uuid
}

/// Root handler over the host's cryptographically secure generator.
@external(js, "vow_runtime", "random_host")
pub fn host() -> Handler<Random>

// Park–Miller "minimal standard" generator: state in [1, 2^31 - 2], products stay below
// 2^47 so the arithmetic is exact on every backend including JS.
let modulus = 2_147_483_647

fn step(state: Int) -> Int { state * 48_271 % modulus }

/// Deterministic generator for tests and simulations. Not for secrets.
/// ponytail: one 31-bit draw per call, so `int` over spans wider than 2^31 - 1 only
/// reaches part of the span and has modulo bias; draw twice if tests need wide spans.
pub fn seeded(seed: Int) -> Handler<Random> {
  handler Random {
    var state = 1 + Int.abs(seed % (modulus - 1))
    fn int(lo, hi) {
      state = step(state)
      lo + (state - 1) % (hi - lo + 1)
    }
    fn float() {
      state = step(state)
      Int.to_float(state - 1) / Int.to_float(modulus - 1)
    }
    fn bytes(n) {
      var out: List<Int> = []
      for _ in 0..n {
        state = step(state)
        out = out.push(state % 256)
      }
      Bytes.from_list(out)
    }
    fn uuid() {
      var text = ""
      for i in 0..32 {
        state = step(state)
        let nibble = if i == 12 { 4 } else if i == 16 { 8 + state % 4 } else { state % 16 }
        text = text + hex_digit(nibble)
        if i == 7 || i == 11 || i == 15 || i == 19 { text = text + "-" }
      }
      Uuid.Uuid(text)
    }
  }
}

fn hex_digit(n: Int) -> String {
  String.chars("0123456789abcdef")[n].unwrap_or("0")
}

test "seeded draws are reproducible and in range" {
  let draw = fn() { [Random.int(1, 6), Random.int(1, 6), Random.int(1, 6), Random.int(1, 6)] }
  let a = with seeded(7) { draw() }
  let b = with seeded(7) { draw() }
  let c = with seeded(8) { draw() }
  expect_eq(a, b)
  expect(a != c)
  expect(a.all(fn(x) { x >= 1 && x <= 6 }))
}

test "seeded float, bytes and uuid have the right shape" {
  with seeded(1) {
    let f = Random.float()
    expect(f >= 0.0 && f < 1.0)
    expect_eq(Bytes.len(Random.bytes(5)), 5)
    let u = Uuid.to_string(Random.uuid())
    expect_eq(String.len(u), 36)
    expect_eq(Uuid.parse(u).map(Uuid.to_string), Ok(u))
    expect_eq(String.slice(u, 14, 15), "4")
  }
}
