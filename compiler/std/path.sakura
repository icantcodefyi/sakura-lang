// Relative filesystem paths (design §10.3). A `Path` has no leading `/` and no `..`
// segment, so a handler rooted at a directory cannot be escaped through one. It is a
// refinement rather than an opaque type so that `Cli.parse` and `Json.decode` can read one
// from a string and check it (design §15.6 parses `--input notes.txt` into a `Path`).

pub type Path = String where is_relative(it)

/// Non-empty, no leading `/`, and no `..` segment. Written inside the scalar fragment
/// (design §17.87), so the checker decides every `Path` literal at compile time.
@total
pub fn is_relative(s: String) -> Bool {
  s != ""
    && !String.starts_with(s, "/")
    && s != ".."
    && !String.starts_with(s, "../")
    && !String.ends_with(s, "/..")
    && !String.contains(s, "/../")
}

/// `s` without `.` and empty segments: `of("data/./notes.txt")` is `data/notes.txt`, and
/// `of("./")` is `.`.
pub fn of(s: String) -> Path
  requires is_relative(s)
{
  Path.from(normalize(s))
}

/// `p` followed by the segments of `rest`.
pub fn join(p: Path, rest: String) -> Path
  requires is_relative(rest)
{
  Path.from(normalize(p + "/" + rest))
}

pub fn to_string(p: Path) -> String { p }

fn normalize(s: String) -> String {
  let segs = List.filter(String.split(s, "/"), fn(seg) { seg != "" && seg != "." })
  if segs == [] { "." } else { List.join(segs, "/") }
}

test "of drops empty and dot segments" {
  expect_eq(to_string(of("data/./notes.txt")), "data/notes.txt")
  expect_eq(to_string(of("./")), ".")
  expect_eq(to_string(join(of("data"), "a/b.txt")), "data/a/b.txt")
  expect_eq(join(of("."), "x"), of("x"))
}

test "absolute paths and parent segments are not relative" {
  expect(!is_relative("/etc/passwd"))
  expect(!is_relative("data/../../etc"))
  expect(!is_relative(""))
  expect(!is_relative(".."))
  expect(!is_relative("a/.."))
  expect(!is_relative("a/../b"))
  expect(is_relative("a..b"))
  expect(is_relative("a/..b/c.."))
  expect_defect(fn() { of("../x") })
}
