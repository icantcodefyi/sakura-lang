// SQL databases as an effect (design §10.2, §4.11, M3). A `Query<R>` comes from the
// `sql"…"` template, which sends every interpolated value as a bound parameter, never as
// SQL text. `R` is the row type, decoded by its `Schema` (named by the binding's annotation).
// Each interpolated value is converted with `SqlValue.from` (design §4.11).

import std/fs.{Fs}
import std/path.{Path}

pub type SqlValue = Null | Int(Int) | Float(Float) | Text(String) | Blob(Bytes)

/// The parameter for a value interpolated into `sql"…"` (design §4.11): its JSON form as a
/// SQL value. Strings, refined strings and `Untrusted<String>` are `Text`, whole numbers
/// `Int`, other numbers `Float`, `Bool` is `0`/`1`, `None` is `Null`; anything else is its
/// JSON text. A `SqlValue` is passed as is.
pub fn from<T: Schema>(value: T) -> SqlValue {
  match Json.parse(Json.encode(value)) {
    Ok(Json.Null) => Null,
    Ok(Json.Bool(b)) => Int(if b { 1 } else { 0 }),
    Ok(Json.Number(n)) => match Float.to_int_checked(n) {
      Some(i) if Int.to_float(i) == n => Int(i),
      _ => Float(n),
    },
    Ok(Json.String(s)) => Text(s),
    _ => Text(Json.encode(value)),
  }
}

/// Built only by `template`, so a query's text never contains an interpolated value.
pub opaque type Query<R> = { text: String, params: List<SqlValue> }

pub error SqlError(message: String)

pub effect Sql {
  fn query<R: Schema>(q: Query<R>) -> List<R> ! {Fail<SqlError>}
  /// Rows affected.
  fn execute(q: Query<Unit>) -> Int ! {Fail<SqlError>}
  /// Runs `body` in a transaction: committed when it returns, rolled back when it fails.
  fn transaction<T, e>(body: fn() -> T ! {Sql | e}) -> T ! {Fail<SqlError> | e}
}

/// The `sql"…"` tag: the literal `parts` joined by `?` placeholders, one per argument.
pub fn template<R>(parts: List<String>, args: List<SqlValue>) -> Query<R> {
  Query { text: List.join(parts, "?"), params: args }
}

/// Executes each statement in order.
pub fn migrate(statements: List<Query<Unit>>) -> Unit ! {Sql, Fail<SqlError>} {
  for s in statements { let _ = Sql.execute(s) }
}

/// SQLite database file at `path`, through the installed `Fs` handler's directory.
@external(js, "sakura_runtime", "sql_sqlite")
pub fn sqlite(path: Path) -> Handler<Sql, {Fs}>

/// A fresh in-memory SQLite database; the test default.
@external(js, "sakura_runtime", "sql_memory")
pub fn memory() -> Handler<Sql>

test "template binds arguments as parameters" {
  let q: Query<Unit> = template(
    ["select * from users where id = ", " and name = ", ""],
    [Int(1), Text("a")],
  )
  expect_eq(q.text, "select * from users where id = ? and name = ?")
  expect_eq(q.params, [Int(1), Text("a")])
}

test "an Untrusted interpolation is a bound parameter (design §17.101)" {
  with memory() {
    let _ = Sql.execute(sql"create table users (name text)")
    let _ = Sql.execute(sql"insert into users (name) values ({"ada"})")
    expect_eq(Sql.execute(sql"update users set name = name where name = {Untrusted.of("ada")}"), 1)
    expect_eq(
      Sql.execute(sql"update users set name = name where name = {Untrusted.of("x' or 1=1 --")}"),
      0,
    )
  }
}
