// Files as an effect (design §10.2, M3). Authority is the handler's directory: every path
// is relative to it (`Path` cannot hold `..` or a leading `/`) and the host rejects
// symlinks that escape it (design §6.1).

import std/path.{Path}
import std/stream.{Done, Next, Sink, Source}
import std/untrusted

/// A directory capability. External: only `Fs.root()` and `Dir.subdir` produce one.
pub type Dir

pub type Entry = { name: String, is_dir: Bool }

/// `Write` creates or truncates the file, `Append` creates it or writes after its end.
pub type Mode = Read | Write | Append

/// An open file, valid only inside the `with_file` body that received it (design §6.7). The
/// body runs under the handlers of its perform site (design §5.5), so `Fs.read_chunk` and
/// `Fs.write_chunk` inside it reach the handler that opened the file. A resource: the body may
/// not return it or store it in handler state (`V6003`, design §8.4).
@resource
pub opaque type File = { id: Int, path: Path, mode: Mode }

/// `path` is relative to the handler's directory; `reason` is the host's message.
pub error FsError(path: String, reason: String)

pub effect Fs {
  /// The handler's directory, for attenuation with `Dir.subdir` and `Fs.rooted`.
  fn root() -> Dir
  fn read(path: Path) -> Bytes ! {Fail<FsError>}
  /// The file as UTF-8 text; invalid UTF-8 is an `FsError`.
  fn read_text(path: Path) -> Untrusted<String> ! {Fail<FsError>}
  /// Creates or replaces the file.
  fn write(path: Path, data: Bytes) -> Unit ! {Fail<FsError>}
  /// Entries sorted by name.
  fn list(dir: Path) -> List<Entry> ! {Fail<FsError>}
  fn exists(path: Path) -> Bool
  /// Opens `path`, runs `body` with the file and closes it on every exit: return, `fail`,
  /// defect or cancellation.
  fn with_file<T, e>(path: Path, mode: Mode, body: fn(File) -> T ! e) -> T ! {Fail<FsError> | e}
  /// Up to `max` bytes from the current position; empty at the end of the file.
  fn read_chunk(file: File, max: Int) -> Bytes
    ! {Fail<FsError>}
    requires max > 0
  /// Writes at the end of the file; fails for a file opened with `Read`.
  fn write_chunk(file: File, data: Bytes) -> Unit ! {Fail<FsError>}
}

/// The root handler the host installs for a `main` that declares `Fs`: the package
/// directory, limited to the manifest's `fs.read`/`fs.write` lists. A path outside them fails
/// `FsError` with reason `"not in the manifest's fs.<read|write> list"` (a `SqlError` wraps it
/// behind the file's name).
pub fn host() -> Handler<Fs> { rooted(fs_root()) }

/// A handler confined to `dir`.
pub fn rooted(dir: Dir) -> Handler<Fs> {
  handler Fs {
    fn root() { dir }
    fn read(path) { ok_or_fail(path, fs_read(dir, Path.to_string(path))) }
    fn read_text(path) {
      let bytes = ok_or_fail(path, fs_read(dir, Path.to_string(path)))
      untrusted.of(
        ok_or_fail(
          path,
          String.from_bytes(bytes).map_err(fn(e) { "invalid UTF-8 at byte {e.offset}" }),
        ),
      )
    }
    fn write(path, data) { ok_or_fail(path, fs_write(dir, Path.to_string(path), data)) }
    fn list(p) { ok_or_fail(p, fs_list(dir, Path.to_string(p))) }
    fn exists(path) { fs_exists(dir, Path.to_string(path)) }
    fn with_file(path, mode, body) {
      let id = ok_or_fail(path, file_open(dir, Path.to_string(path), mode))
      file_closing(id, fn() { body(File { id, path, mode }) })
    }
    fn read_chunk(file, max) { read_file(file, max) }
    fn write_chunk(file, data) { write_file(file, data) }
  }
}

/// The directory `name` inside `d`; fails if it is missing or a symlink out of `d`. `name` is
/// a relative path of one or more segments (`"data/clean"`); the manifest's grant is checked on
/// the directory this opens, so narrow in one call to the granted directory.
pub fn subdir(d: Dir, name: String) -> Dir ! {Fail<FsError>} {
  match fs_subdir(d, name) {
    Ok(sub) => sub,
    Err(reason) => fail FsError { path: name, reason },
  }
}

/// Test handler over in-memory `files` (design §17.119): `rooted` over a directory in a store
/// of its own, so `root()`, `Dir.subdir` and `Fs.rooted` compose exactly as on the host. Every
/// handler over the store sees each write at once, `with_file` included; installing this value
/// twice shares the files, evaluating `Fs.memory(…)` again starts afresh. The directories are
/// those some file is inside; `memory_tree` also takes empty ones. No manifest `[permissions]`
/// apply.
pub fn memory(files: List<(Path, Bytes)>) -> Handler<Fs> {
  rooted(fs_memory_root(files.map(fn(f) { (f.0, Some(f.1)) })))
}

/// What `memory_tree` puts at a path: a file with its bytes, or a directory (empty unless
/// another entry is inside it).
pub type MemoryEntry = Contents(Bytes) | Directory

/// `memory` over files and directories (design §17.292 (7)):
/// `Fs.memory_tree([(Path.of("out"), MemoryEntry.Directory)])` starts with an empty `out` a
/// test can write into. A directory's parents exist too.
pub fn memory_tree(entries: List<(Path, MemoryEntry)>) -> Handler<Fs> {
  rooted(
    fs_memory_root(
      entries.map(fn(e) {
        match e.1 {
          MemoryEntry.Contents(b) => (e.0, Some(b)),
          MemoryEntry.Directory => (e.0, None),
        }
      }),
    ),
  )
}

fn read_file(file: File, max: Int) -> Bytes ! {Fail<FsError>} {
  ok_or_fail(file.path, file_read(file.id, max))
}

fn write_file(file: File, data: Bytes) -> Unit ! {Fail<FsError>} {
  if file.mode == Read {
    fail FsError { path: Path.to_string(file.path), reason: "opened for reading" }
  }
  ok_or_fail(file.path, file_write(file.id, data))
}

/// Every chunk from the current position to the end.
pub fn read_all(file: File) -> Bytes ! {Fs, Fail<FsError>} {
  var out: List<Int> = []
  var chunk = Fs.read_chunk(file, 65_536)
  while Bytes.len(chunk) > 0 {
    out = List.concat(out, to_list(chunk))
    chunk = Fs.read_chunk(file, 65_536)
  }
  Bytes.from_list(out)
}

/// The file at `path`, failing `FsError` with reason `"larger than <limit> bytes"` once it holds
/// more than `limit` bytes; it reads at most `limit + 1` of them. Text goes through
/// `String.from_bytes`.
pub fn read_up_to(path: Path, limit: Int) -> Bytes
  ! {Fs, Fail<FsError>}
  requires limit >= 0
{
  Fs.with_file(path, Read, fn(file) {
    var parts: List<Bytes> = []
    var n = 0
    var chunk = Fs.read_chunk(file, Int.min(65_535, limit) + 1)
    while Bytes.len(chunk) > 0 {
      n = n + Bytes.len(chunk)
      if n > limit {
        fail FsError { path: Path.to_string(path), reason: "larger than {limit} bytes" }
      }
      parts = List.push(parts, chunk)
      chunk = Fs.read_chunk(file, Int.min(65_535, limit - n) + 1)
    }
    Bytes.concat(parts)
  })
}

/// The file from its current position as a source of chunks of up to `chunk` bytes, ending
/// at the first empty read. A view: pulling it reads the file, so it is valid only inside the
/// `with_file` body that received the file (`V6003`).
pub fn file_source(file: File, chunk: Int) -> Source<Bytes, {Fs, Fail<FsError>}>
  requires chunk > 0
{
  Source {
    pull: fn() {
      let b = Fs.read_chunk(file, chunk)
      if Bytes.len(b) == 0 { Done } else { Next(b, file_source(file, chunk)) }
    },
  }
}

/// A sink writing each item at the end of the file (`Fs.write_chunk`). `close` writes
/// nothing: `with_file` closes the file. A view, scoped like `file_source`.
pub fn file_sink(file: File) -> Sink<Bytes, {Fs, Fail<FsError>}> {
  Sink {
    write: fn(b) {
      Fs.write_chunk(file, b)
      file_sink(file)
    },
    close: fn() { () },
  }
}

fn to_list(b: Bytes) -> List<Int> {
  List.filter_map(List.range(0, Bytes.len(b)), fn(i) { Bytes.get(b, i) })
}

fn ok_or_fail<T>(path: Path, r: Result<T, String>) -> T ! {Fail<FsError>} {
  match r {
    Ok(v) => v,
    Err(reason) => fail FsError { path: Path.to_string(path), reason },
  }
}

@external(js, "sakura_runtime", "fs_root")
fn fs_root() -> Dir

/// The root of a fresh in-memory store holding `entries`: a file for `Some(bytes)`, a
/// directory for `None` (`Fs.memory`, `Fs.memory_tree`).
@external(js, "sakura_runtime", "fs_memory_root")
fn fs_memory_root(entries: List<(Path, Option<Bytes>)>) -> Dir

@external(js, "sakura_runtime", "fs_subdir")
fn fs_subdir(d: Dir, name: String) -> Result<Dir, String>

@external(js, "sakura_runtime", "fs_read")
fn fs_read(d: Dir, path: String) -> Result<Bytes, String>

@external(js, "sakura_runtime", "fs_write")
fn fs_write(d: Dir, path: String, data: Bytes) -> Result<Unit, String>

@external(js, "sakura_runtime", "fs_list")
fn fs_list(d: Dir, path: String) -> Result<List<Entry>, String>

@external(js, "sakura_runtime", "fs_exists")
fn fs_exists(d: Dir, path: String) -> Bool

/// A file in `d`, opened per `mode`; the id indexes the runtime's open-file table.
@external(js, "sakura_runtime", "file_open")
fn file_open(d: Dir, path: String, mode: Mode) -> Result<Int, String>

/// Runs `body`, then closes file `id` however `body` ends.
@external(js, "sakura_runtime", "file_closing")
fn file_closing<T, e>(id: Int, body: fn() -> T ! e) -> T ! e

@external(js, "sakura_runtime", "file_read")
fn file_read(id: Int, max: Int) -> Result<Bytes, String>

@external(js, "sakura_runtime", "file_write")
fn file_write(id: Int, data: Bytes) -> Result<Unit, String>
