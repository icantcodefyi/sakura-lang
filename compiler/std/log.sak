// Structured logging as an effect. Prelude effect.

import std/json.{Json}

pub type Level = Debug | Info | Warn | Error

pub effect Log {
  fn event(level: Level, message: String, fields: List<(String, Json)>) -> Unit
}

/// Root handler: one line per event on stderr, `Warn message key=json …`, each field's value
/// as compact JSON text.
@external(js, "sakura_runtime", "log_stderr")
pub fn stderr() -> Handler<Log>

/// The root handler the host installs for a `main` that declares `Log`: same as `stderr()`.
pub fn host() -> Handler<Log> { stderr() }

/// Root handler: one JSON object per line on stderr (`level`, `message`, then fields).
@external(js, "sakura_runtime", "log_json")
pub fn json() -> Handler<Log>

/// Test default: each event becomes a captured line `Warn message key=json …`, each field's
/// value as compact JSON text (`Json.encode`), as `stderr()` writes it:
/// `Info manual.search hits=3 id="drill-press-belt-slip" ok=true tags=["a","b"]`.
pub fn captured() -> Handler<Log, {Test}> {
  handler Log {
    fn event(level, message, fields) {
      let rendered = List.map(fields, fn(kv) { " {kv.0}={Json.encode(kv.1)}" })
      Test.output("{level} {message}{List.join(rendered, "")}")
    }
  }
}
