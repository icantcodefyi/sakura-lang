// HTTP client as an effect (design §10.2, §10.4, M3). The manifest's `net` list limits the
// host handler (§6.2); `Http.scoped(hosts)` attenuates by data; there is no `Net` effect.
// `Http.recording(path)` replays cassettes (design §17.73). `Http.stream` reads a response as
// it arrives (design §17.88). Every handler here follows redirects with one loop, `follow`
// (RFC 0002 §2.4, design §17.263 (4), §17.271).

import std/duration.{Duration}
import std/fs.{Dir, Fs}
import std/path.{Path}
import std/request.{
  Bytes,
  Empty,
  Error,
  Follow,
  Get,
  Head,
  Manual,
  Method,
  Payload,
  Post,
  Redirect,
  Request,
  Text,
}
import std/response.{HttpError, Response, Status}
import std/stream.{Done, Next, Source}
import std/url.{Url}

/// For `Http.scripted`: `Any`, a request path (`Path("/search")`), or a method.
pub type Matcher = Any | Path(String) | Method(Method)

/// A 429 response; `retry_after` comes from its `Retry-After` seconds.
pub error RateLimited(retry_after: Option<Duration>)

/// The bytes of a response as they arrive, read with `Http.read_chunk`. External and a
/// resource: valid only inside the `Http.stream` callback that received it (design §17.88).
@resource
pub type Body

/// The status and headers of a streamed response, and its body.
pub type Incoming = { status: Status, headers: List<(String, String)>, body: Body }

pub effect Http {
  /// Sends `req` and returns any response, including 4xx and 5xx; fails only when no
  /// response arrives.
  fn send(req: Request) -> Response ! {Fail<HttpError>}
  /// Sends `req`, waits for the status and headers, and runs `body` with them; the connection
  /// is released when `body` returns, fails, defects or is cancelled. Chunk boundaries are not
  /// stable: treat the body as a byte stream.
  fn stream<T, e>(req: Request, body: fn(Incoming) -> T ! e) -> T ! {Fail<HttpError> | e}
  /// Up to `max` bytes of the body; empty at the end. Fails when the connection drops or after
  /// the `stream` callback has left.
  fn read_chunk(body: Body, max: Int) -> Bytes
    ! {Fail<HttpError>}
    requires max > 0
}

/// The body as a source of chunks of up to `chunk` bytes (`response.body`), ending at the
/// first empty read. A view: pulling it reads the body, so it is valid only inside the
/// `Http.stream` callback that received the body (`V6003`).
pub fn body_source(body: Body, chunk: Int) -> Source<Bytes, {Http, Fail<HttpError>}>
  requires chunk > 0
{
  Source {
    pull: fn() {
      let b = Http.read_chunk(body, chunk)
      if Bytes.len(b) == 0 { Done } else { Next(b, body_source(body, chunk)) }
    },
  }
}

pub fn get(url: Url) -> Response ! {Http, Fail<HttpError | RateLimited>} {
  rate_limited(Http.send(Request.of(Method.Get, url)))
}

pub fn post_json<T: Schema>(url: Url, body: T) -> Response ! {Http, Fail<HttpError | RateLimited>} {
  rate_limited(Http.send(Request.post_json(url, body)))
}

/// `req` with `("authorization", "Bearer <token>")` added to its `secret_headers`, which host
/// handlers send and nothing shows, matches or records.
pub fn bearer(req: Request, token: Secret<String>) -> Request {
  let value = Secret.map(token, fn(t) { "Bearer " + t }, @trust("bearer header"))
  Request { ..req, secret_headers: List.push(req.secret_headers, ("authorization", value)) }
}

/// The root handler the host installs for a `main` that declares `Http`: `fetch`, limited
/// to the manifest's `net` list, which is checked on every send. A response body arrives as
/// `Bytes` (`Empty` when it has no bytes). Redirects follow `req.redirect` (`follow`): each
/// hop is its own send, so its `host:port` is checked against `net` before it is fetched. A
/// host outside the list fails `HttpError { status: None, reason: "<host:port> is not in the
/// manifest's net list" }`.
pub fn host() -> Handler<Http> {
  handler Http {
    fn send(req) { follow(req, req, 0, fn(r) { ok_or_fail(http_send(r)) }) }
    fn stream(req, body) {
      follow_stream(
        req,
        req,
        0,
        fn(r, k) {
          let incoming = ok_or_fail(http_stream_open(r))
          http_stream_closing(incoming.body, fn() { k(incoming) })
        },
        body,
      )
    }
    fn read_chunk(b, max) { ok_or_fail(http_stream_read(b, max)) }
  }
}

/// Forwards to the enclosing `Http` only for requests to the listed `host:port` entries (a
/// URL without a port means 443 for `https` and 80 otherwise); others fail
/// `HttpError { status: None, reason: "<host:port> is outside Http.scoped" }`.
/// It follows redirects itself (`follow`), forwarding each hop with `redirect: Manual`, so
/// every hop is checked against this list before it is forwarded.
pub fn scoped(hosts: List<String>) -> Handler<Http, {Http}> {
  handler Http {
    fn send(req) {
      follow(req, req, 0, fn(r) {
        allowed(hosts, r)
        Http.send(r)
      })
    }
    fn stream(req, body) {
      follow_stream(
        req,
        req,
        0,
        fn(r, k) {
          allowed(hosts, r)
          Http.stream(r, k)
        },
        body,
      )
    }
    fn read_chunk(b, max) { Http.read_chunk(b, max) }
  }
}

// Redirects (RFC 0002 §2.4, design §17.263 (4), §17.271), as Fetch's HTTP-redirect fetch.
let max_redirects = 20

let body_headers = ["content-encoding", "content-language", "content-location", "content-type"]

/// What one hop of `follow_stream` ends with: the callback's value, or the next hop.
type Leg<T> = Answered(T) | Hop(Request)

/// `send(at)` with `redirect: Manual`, then the hops `req.redirect` asks for, each through
/// `send`; `hops` is the number followed before `at` (design §17.263 (4), §17.271).
fn follow<e>(
  req: Request,
  at: Request,
  hops: Int,
  send: fn(Request) -> Response ! {Fail<HttpError> | e},
) -> Response
  ! {Fail<HttpError> | e}
{
  let resp = send(Request { ..at, redirect: Manual })
  match next_hop(req.redirect, at, hops, resp.status, resp.headers) {
    None => resp,
    Some(next) => follow(req, next, hops + 1, send),
  }
}

/// `follow` for `Http.stream`: `open(at, k)` runs `k` while the answer is open and closes it
/// when `k` returns, so a 3xx body is closed before the next hop opens.
fn follow_stream<T, e>(
  req: Request,
  at: Request,
  hops: Int,
  open: fn(Request, fn(Incoming) -> Leg<T> ! {Fail<HttpError> | e}) -> Leg<T> ! {Fail<HttpError> | e},
  body: fn(Incoming) -> T ! e,
) -> T
  ! {Fail<HttpError> | e}
{
  let step = open(Request { ..at, redirect: Manual }, fn(i) {
    match next_hop(req.redirect, at, hops, i.status, i.headers) {
      None => Answered(body(i)),
      Some(next) => Hop(next),
    }
  })
  match step {
    Answered(value) => value,
    Hop(next) => follow_stream(req, next, hops + 1, open, body),
  }
}

/// The request after an answer to `at` with `status` and `headers`, or `None` when the answer
/// is the result: not a redirect (301, 302, 303, 307, 308), `Manual`, or no `location`. `Error`
/// fails with the status; after 20 hops, a location that does not resolve against `at.url` or is
/// not `http`/`https` fails. A hop to another origin (scheme, host or port) drops `authorization`
/// and every `secret_headers` entry; a 303, or a 301/302 after a `POST`, becomes a `GET` with no
/// body and none of Fetch's request-body headers (`content-type`, `-encoding`, `-language`,
/// `-location`).
fn next_hop(
  mode: Redirect,
  at: Request,
  hops: Int,
  status: Status,
  headers: List<(String, String)>,
) -> Option<Request>
  ! {Fail<HttpError>}
{
  let code: Int = status
  if !List.contains([301, 302, 303, 307, 308], code) { return None }
  match mode {
    Manual => { return None },
    Error => fail HttpError { status: Some(status), reason: "unexpected redirect" },
    Follow => {},
  }
  let location = match List.find(headers, fn(h) { String.to_lower(h.0) == "location" }) {
    Some(h) => h.1,
    None => { return None },
  }
  if hops == max_redirects { fail HttpError { status: None, reason: "too many redirects" } }
  let resolved = match Url.parse(at.url) {
    Ok(from) => Url.resolve(from, location).map(fn(to) { (from, to) }),
    Err(e) => Err(e),
  }
  let (from, to) = match resolved {
    Ok(pair) => pair,
    Err(_) => fail HttpError { status: None, reason: "invalid redirect location {location}" },
  }
  if to.scheme != "http" && to.scheme != "https" {
    fail HttpError { status: None, reason: "redirect to {to.scheme}: refused" }
  }
  let cross = Url.origin(from) != Url.origin(to)
  let secret = List.map(at.secret_headers, fn(h) { String.to_lower(h.0) })
  let to_get = (code == 303 && at.method != Head) || (code <= 302 && at.method == Post)
  let dropped = fn(name: String) -> Bool {
    let n = String.to_lower(name)
    (cross && (n == "authorization" || List.contains(secret, n)))
      || (to_get && List.contains(body_headers, n))
  }
  Some(Request {
    ..at,
    method: if to_get { Get } else { at.method },
    url: Url.to_url(to),
    headers: List.filter(at.headers, fn(h) { !dropped(h.0) }),
    body: if to_get { Empty } else { at.body },
    secret_headers: if cross { [] } else { at.secret_headers },
  })
}

fn allowed(hosts: List<String>, req: Request) -> Unit ! {Fail<HttpError>} {
  let target = host_port(req.url)
  if !List.contains(hosts, target) {
    fail HttpError { status: None, reason: "{target} is outside Http.scoped" }
  }
}

fn host_port(u: Url) -> String {
  match Url.host(u) {
    None => "",
    Some(h) => if String.contains(h, ":") {
      h
    } else if String.starts_with(u, "https://") {
      "{h}:443"
    } else {
      "{h}:80"
    },
  }
}

/// Replays the cassette at `path` (JSON Lines, inside the installed `Fs` handler's directory,
/// usually `with Fs.rooted(Test.fixtures())`): a request whose method, url, headers and body
/// match a recorded exchange gets its response, its body as `host()` gives it; identical
/// requests replay in recorded order, the last one repeating. Each redirect hop is its own
/// exchange (`follow`), so a cassette without 3xx exchanges replays as before. A miss fails
/// with `HttpError` naming `sakura test --record`, under which it is forwarded to the
/// enclosing `Http` and appended. `secret_headers` are never written and never part of the
/// match (design §17.57, §17.73). Three rules (§17.122): the file's first line is
/// `{"schema_version":"1.0","kind":"cassette"}`, written on the first append and required by
/// `open`; a request whose `headers` hold `authorization`, `proxy-authorization`, `x-api-key`,
/// `api-key`, `x-auth-token` or `cookie` (any case) fails with `HttpError` before any replay or
/// forward (put it in `secret_headers`, `Http.bearer`); a `set-cookie` response header is
/// stored and replayed as `<redacted>`. The URL and body are stored verbatim, a body that is
/// not UTF-8 as Base64 (`body_base64`, `response_body_base64`); a `Text` and a `Bytes` request
/// body with the same bytes match. A response body, sent or streamed, is recorded only up to
/// 16 MiB (16,777,216 bytes): past it `send` or `stream` fails with `HttpError` naming the
/// limit and the exchange is not appended.
pub fn recording(path: Path) -> Handler<Http, {Fs, Http}> { replaying(cassette(path)) }

/// A cassette file, read on first use. `Llm.recording` opens one per installation and replays
/// each call through it, so its exchanges advance in order across calls (design §17.102).
pub opaque type Cassette = { path: Path, id: Int }

pub fn cassette(path: Path) -> Cassette { Cassette { path, id: 0 } }

/// `c` with its file read; an open cassette as it is. Written `Cassette.open(c)` or `c.open()`.
/// A file whose first line is not a version 1 cassette header fails, naming the file.
pub fn open(c: Cassette) -> Cassette ! {Fs, Fail<HttpError>} {
  if c.id != 0 { return c }
  Cassette { path: c.path, id: ok_or_fail(http_recording_open(Fs.root(), Path.to_string(c.path))) }
}

/// `recording` over the cassette `c`: one already open is not read again.
pub fn replaying(c: Cassette) -> Handler<Http, {Fs, Http}> {
  handler Http {
    var cur = c
    fn send(req) {
      cur = open(cur)
      let id = cur.id
      follow(req, req, 0, fn(r) {
        match http_recording_lookup(id, r) {
          Ok(Some(resp)) => resp,
          Ok(None) => {
            let resp = Http.send(r)
            if Bytes.len(payload_bytes(resp.body)) > max_recorded_body {
              fail too_large_to_record()
            }
            ok_or_fail(http_recording_append(id, r, resp))
            resp
          },
          Err(reason) => fail HttpError { status: None, reason },
        }
      })
    }
    fn stream(req, body) {
      cur = open(cur)
      let id = cur.id
      follow_stream(
        req,
        req,
        0,
        fn(r, k) {
          let incoming = match ok_or_fail(http_recording_lookup_stream(id, r)) {
            Some(incoming) => incoming,
            None => {
              // Recording: read the whole body from the enclosing `Http`, store it, replay it.
              let got = Http.stream(r, fn(i) { (i.status, i.headers, read_body(i.body)) })
              ok_or_fail(http_recording_append_stream(id, r, got.0, got.1, got.2))
              Incoming { status: got.0, headers: got.1, body: http_body_of(got.2) }
            },
          }
          http_stream_closing(incoming.body, fn() { k(incoming) })
        },
        body,
      )
    }
    fn read_chunk(b, max) { ok_or_fail(http_stream_read(b, max)) }
  }
}

// A cassette is a checked-in file (§17.205 (2), §17.209 (4)).
let max_recorded_body = 16_777_216

fn too_large_to_record() -> HttpError {
  HttpError {
    status: None,
    reason: "response body over 16 MiB: sakura test --record stores at most 16,777,216 bytes of a response body",
  }
}

fn read_body(b: Body) -> Bytes ! {Http, Fail<HttpError>} {
  var parts: List<Bytes> = []
  var n = 0
  var chunk = Http.read_chunk(b, 65_536)
  while Bytes.len(chunk) > 0 {
    n = n + Bytes.len(chunk)
    if n > max_recorded_body { fail too_large_to_record() }
    parts = List.push(parts, chunk)
    chunk = Http.read_chunk(b, 65_536)
  }
  Bytes.concat(parts)
}

fn ok_or_fail<T>(r: Result<T, String>) -> T ! {Fail<HttpError>} {
  match r {
    Ok(v) => v,
    Err(reason) => fail HttpError { status: None, reason },
  }
}

/// The bytes on the wire for `p`: `Text` as UTF-8.
fn payload_bytes(p: Payload) -> Bytes {
  match p {
    Empty => Bytes.from_list([]),
    Text(s) => String.to_bytes(s),
    Bytes(b) => b,
  }
}

/// Test handler: the response of the first matching entry; no match is an `HttpError`. A
/// scripted 3xx with a `location` header is a redirect, followed as `host()` does (`follow`).
pub fn scripted(script: List<(Matcher, Response)>) -> Handler<Http> {
  handler Http {
    fn send(req) { follow(req, req, 0, fn(r) { scripted_response(script, r) }) }
    fn stream(req, body) {
      follow_stream(
        req,
        req,
        0,
        fn(r, k) {
          let resp = scripted_response(script, r)
          let b = http_body_of(payload_bytes(resp.body))
          http_stream_closing(b, fn() {
            k(Incoming { status: resp.status, headers: resp.headers, body: b })
          })
        },
        body,
      )
    }
    fn read_chunk(b, max) { ok_or_fail(http_stream_read(b, max)) }
  }
}

fn scripted_response(script: List<(Matcher, Response)>, req: Request) -> Response
  ! {Fail<HttpError>}
{
  match List.find(script, fn(entry) { matches(entry.0, req) }) {
    Some(entry) => entry.1,
    None =>
      fail HttpError { status: None, reason: "no scripted response for {req.method} {req.url}" },
  }
}

fn matches(m: Matcher, req: Request) -> Bool {
  match m {
    Any => true,
    Path(p) => Url.path(req.url) == p,
    Method(method) => req.method == method,
  }
}

fn rate_limited(resp: Response) -> Response ! {Fail<RateLimited>} {
  if resp.status == Status.from(429) {
    let header = List.find(resp.headers, fn(h) { String.to_lower(h.0) == "retry-after" })
    let seconds = header.map(fn(h) { String.parse_int(h.1) })
    let after = match seconds {
      Some(Some(s)) => Some(Duration.seconds(s)),
      _ => None,
    }
    fail RateLimited { retry_after: after }
  }
  resp
}

@external(js, "sakura_runtime", "http_send")
fn http_send(req: Request) -> Result<Response, String>

@external(js, "sakura_runtime", "http_stream_open")
fn http_stream_open(req: Request) -> Result<Incoming, String>

@external(js, "sakura_runtime", "http_stream_closing")
fn http_stream_closing<T, e>(body: Body, k: fn() -> T ! e) -> T ! e

@external(js, "sakura_runtime", "http_stream_read")
fn http_stream_read(body: Body, max: Int) -> Result<Bytes, String>

@external(js, "sakura_runtime", "http_body_of")
fn http_body_of(bytes: Bytes) -> Body

@external(js, "sakura_runtime", "http_recording_lookup_stream")
fn http_recording_lookup_stream(id: Int, req: Request) -> Result<Option<Incoming>, String>

@external(js, "sakura_runtime", "http_recording_append_stream")
fn http_recording_append_stream(
  id: Int,
  req: Request,
  status: Status,
  headers: List<(String, String)>,
  body: Bytes,
) -> Result<Unit, String>

@external(js, "sakura_runtime", "http_recording_open")
fn http_recording_open(dir: Dir, path: String) -> Result<Int, String>

@external(js, "sakura_runtime", "http_recording_lookup")
fn http_recording_lookup(id: Int, req: Request) -> Result<Option<Response>, String>

@external(js, "sakura_runtime", "http_recording_append")
fn http_recording_append(id: Int, req: Request, resp: Response) -> Result<Unit, String>

test "scripted matches by path and method" {
  let script = [
    (Path("/a"), Response.status(200, "a")),
    (Method(Method.Post), Response.status(201, "p")),
  ]
  with scripted(script) {
    expect_eq(try { get(Url.from("https://x/a?q=1")).body }, Ok(Text("a")))
    expect_eq(try { Http.send(Request.post("/b", "")).status }, Ok(Status.from(201)))
    expect((try { get(Url.from("https://x/c")) }).is_err())
  }
}

test "429 is RateLimited with its Retry-After" {
  let limited = Response { ..Response.status(429, ""), headers: [("Retry-After", "2")] }
  with scripted([(Any, limited)]) {
    expect_fail(
      fn() { get(Url.from("/x")) },
      RateLimited { retry_after: Some(Duration.seconds(2)) },
    )
  }
}

test "scoped forwards only listed hosts" {
  let ok = Response.status(200, "ok")
  with scripted([(Any, ok)]), scoped(["api.example.com:443", "localhost:8080"]) {
    expect_eq(
      try { Http.send(Request.of(Method.Get, Url.from("https://api.example.com/v1"))) },
      Ok(ok),
    )
    expect_eq(try { Http.send(Request.of(Method.Get, Url.from("http://localhost:8080/"))) }, Ok(ok))
    expect((try { Http.send(Request.of(Method.Get, Url.from("https://evil.example/"))) }).is_err())
  }
}

test "bearer adds a secret header and leaves headers alone" {
  let req = bearer(Request.of(Method.Get, Url.from("https://a/")), Secret.of("t"))
  expect_eq(req.headers, [])
  expect_eq(List.len(req.secret_headers), 1)
  expect_eq(List.map(req.secret_headers, fn(h) { h.0 }), ["authorization"])
}

test "scripted and scoped stream a body as one chunk" {
  let ok = Response.status(200, "hello")
  with scripted([(Any, ok)]), scoped(["a.example:443"]) {
    let got = try {
      Http.stream(
        Request.of(Method.Get, Url.from("https://a.example/x")),
        fn(i) {
          let first = Http.read_chunk(i.body, 3)
          let rest = Http.read_chunk(i.body, 100)
          (
            i.status,
            String.from_bytes(first),
            String.from_bytes(rest),
            Bytes.len(Http.read_chunk(i.body, 100)),
          )
        },
      )
    }
    expect_eq(got, Ok((Status.from(200), Ok("hel"), Ok("lo"), 0)))
    let denied = try {
      Http.stream(Request.of(Method.Get, Url.from("https://b.example/")), fn(i) { i.status })
    }
    expect(denied.is_err())
  }
}

test "recording refuses a credential in ordinary headers" {
  let leaky = Request {
    ..Request.of(Method.Get, Url.from("https://a.example/x")),
    headers: [("Authorization", "Bearer x")],
  }
  with Fs.rooted(Test.fixtures()),
      scripted([(Any, Response.status(200, "forwarded"))]),
      recording(Path.of("absent.jsonl")) {
    match try { Http.send(leaky) } {
      Err(HttpError { status, reason }) => {
        expect_eq(status, None)
        expect_eq(
          reason,
          "header Authorization belongs in secret_headers (Http.bearer); not recorded",
        )
      },
      other => expect_eq("{other}", "an HttpError"),
    }
    let streamed = try { Http.stream(leaky, fn(i) { i.status }) }
    expect(streamed.is_err())
    let plain = try { Http.send(Request.of(Method.Get, Url.from("https://a.example/x"))) }
    expect(String.contains("{plain}", "no recording for GET https://a.example/x"))
    expect(!Fs.exists(Path.of("absent.jsonl")))
  }
}
