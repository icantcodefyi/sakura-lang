/// The outcome of a computation that can fail with a value of type `E`.
/// Prefer `Fail<E>` in signatures; `Result` is for storing or inspecting failures
/// (`try { … }` produces one, `r?` turns one back into `Fail<E>`).
pub type Result<A, E> = Ok(A) | Err(E)

/// Applies `f` to the `Ok` value; `Err` passes through.
pub fn map<A, B, E, e>(r: Result<A, E>, f: fn(A) -> B ! e) -> Result<B, E> ! e {
  match r {
    Ok(a) => Ok(f(a)),
    Err(err) => Err(err),
  }
}

/// Applies `f` to the `Err` value; `Ok` passes through.
pub fn map_err<A, E, F>(r: Result<A, E>, f: fn(E) -> F) -> Result<A, F> {
  match r {
    Ok(a) => Ok(a),
    Err(err) => Err(f(err)),
  }
}

/// The `Ok` value, or `default`.
pub fn unwrap_or<A, E>(r: Result<A, E>, default: A) -> A {
  match r {
    Ok(a) => a,
    Err(_) => default,
  }
}

/// The `Ok` value; `Err(e)` becomes `fail e`. `r?` is sugar for this.
pub fn raise<A, E>(r: Result<A, E>) -> A ! {Fail<E>} {
  match r {
    Ok(a) => a,
    Err(err) => fail err,
  }
}

@total
pub fn is_ok<A, E>(r: Result<A, E>) -> Bool {
  match r {
    Ok(_) => true,
    Err(_) => false,
  }
}

@total
pub fn is_err<A, E>(r: Result<A, E>) -> Bool {
  match r {
    Ok(_) => false,
    Err(_) => true,
  }
}

/// The `Ok` value as `Some`; `Err` is `None`.
@total
pub fn ok<A, E>(r: Result<A, E>) -> Option<A> {
  match r {
    Ok(a) => Some(a),
    Err(_) => None,
  }
}

/// The `Err` value as `Some`; `Ok` is `None`.
@total
pub fn err<A, E>(r: Result<A, E>) -> Option<E> {
  match r {
    Ok(_) => None,
    Err(e) => Some(e),
  }
}

error Bad(code: Int)

test "map and map_err touch one side only" {
  let ok: Result<Int, Bad> = Ok(2)
  let err: Result<Int, Bad> = Err(Bad { code: 7 })
  expect_eq(ok.map(fn(x) { x + 1 }), Ok(3))
  expect_eq(err.map(fn(x) { x + 1 }), Err(Bad { code: 7 }))
  expect_eq(err.map_err(fn(b) { b.code }), Err(7))
}

test "unwrap_or, is_ok, is_err" {
  let err: Result<Int, Bad> = Err(Bad { code: 1 })
  expect_eq(err.unwrap_or(0), 0)
  expect_eq(err.is_err(), true)
  expect_eq(err.is_ok(), false)
}

test "ok and err keep one side as an Option" {
  let ok: Result<Int, Bad> = Ok(2)
  let err: Result<Int, Bad> = Err(Bad { code: 4 })
  expect_eq(ok.ok(), Some(2))
  expect_eq(ok.err(), None)
  expect_eq(err.ok(), None)
  expect_eq(err.err(), Some(Bad { code: 4 }))
}

test "raise and ? rethrow the error" {
  let err: Result<Int, Bad> = Err(Bad { code: 3 })
  expect_eq(try { err.raise() }, Err(Bad { code: 3 }))
  expect_eq(try { err? }, Err(Bad { code: 3 }))
}
