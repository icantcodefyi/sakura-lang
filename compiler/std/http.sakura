// HTTP client as an effect (design §10.2, §10.4, M3). The manifest's `net` list limits the
// host handler (§6.2); `Http.scoped(hosts)` attenuates by data; there is no `Net` effect.
// `Http.recording(path)` replays cassettes (design §17.73). `Http.stream` reads a response as
// it arrives (design §17.88).

import std/duration.{Duration}
import std/fs.{Dir, Fs}
import std/path.{Path}
import std/request.{Method, Request}
import std/response.{HttpError, Response, Status}
import std/url.{Url}

/// For `Http.scripted`: `Any`, a request path (`Path("/search")`), or a method.
pub type Matcher = Any | Path(String) | Method(Method)

/// A 429 response; `retry_after` comes from its `Retry-After` seconds.
pub error RateLimited(retry_after: Option<Duration>)

/// The bytes of a response as they arrive, read with `Http.read_chunk`. External and a
/// resource: valid only inside the `Http.stream` callback that received it (design §17.88).
@resource
pub type Body

/// The status and headers of a streamed response, and its body.
pub type Incoming = { status: Status, headers: List<(String, String)>, body: Body }

pub effect Http {
  /// Sends `req` and returns any response, including 4xx and 5xx; fails only when no
  /// response arrives.
  fn send(req: Request) -> Response ! {Fail<HttpError>}
  /// Sends `req`, waits for the status and headers, and runs `body` with them; the connection
  /// is released when `body` returns, fails, defects or is cancelled. Chunk boundaries are not
  /// stable: treat the body as a byte stream.
  fn stream<T, e>(req: Request, body: fn(Incoming) -> T ! e) -> T ! {Fail<HttpError> | e}
  /// Up to `max` bytes of the body; empty at the end. Fails when the connection drops or after
  /// the `stream` callback has left.
  fn read_chunk(body: Body, max: Int) -> Bytes ! {Fail<HttpError>}
    requires max > 0
}

pub fn get(url: Url) -> Response ! {Http, Fail<HttpError | RateLimited>} {
  rate_limited(Http.send(Request.of(Method.Get, url)))
}

pub fn post_json<T: Schema>(url: Url, body: T) -> Response ! {Http, Fail<HttpError | RateLimited>} {
  rate_limited(Http.send(Request.post_json(url, body)))
}

/// `req` with `("authorization", "Bearer <token>")` added to its `secret_headers`, which host
/// handlers send and nothing shows, matches or records.
pub fn bearer(req: Request, token: Secret<String>) -> Request {
  let value = Secret.map(token, fn(t) { "Bearer " + t })
  Request { ..req, secret_headers: List.push(req.secret_headers, ("authorization", value)) }
}

/// The root handler the host installs for a `main` that declares `Http`: `fetch`, limited
/// to the manifest's `net` list.
pub fn host() -> Handler<Http> {
  handler Http {
    fn send(req) { ok_or_fail(http_send(req)) }
    fn stream(req, body) {
      let incoming = ok_or_fail(http_stream_open(req))
      http_stream_closing(incoming.body, fn() { body(incoming) })
    }
    fn read_chunk(b, max) { ok_or_fail(http_stream_read(b, max)) }
  }
}

/// Forwards to the enclosing `Http` only for requests to the listed `host:port` entries (a
/// URL without a port means 443 for `https` and 80 otherwise); others fail with `HttpError`.
pub fn scoped(hosts: List<String>) -> Handler<Http, {Http}> {
  handler Http {
    fn send(req) {
      allowed(hosts, req)
      Http.send(req)
    }
    fn stream(req, body) {
      allowed(hosts, req)
      Http.stream(req, body)
    }
    fn read_chunk(b, max) { Http.read_chunk(b, max) }
  }
}

fn allowed(hosts: List<String>, req: Request) -> Unit ! {Fail<HttpError>} {
  let target = host_port(req.url)
  if !List.contains(hosts, target) {
    fail HttpError { status: None, reason: "{target} is outside Http.scoped" }
  }
}

fn host_port(u: Url) -> String {
  match Url.host(u) {
    None => "",
    Some(h) => if String.contains(h, ":") { h } else if String.starts_with(u, "https://") { "{h}:443" } else { "{h}:80" },
  }
}

/// Replays the cassette at `path` (JSON Lines, inside the installed `Fs` handler's directory,
/// usually `with Fs.rooted(Test.fixtures())`): a request whose method, url, headers and body
/// match a recorded exchange gets its response; identical requests replay in recorded order,
/// the last one repeating. A miss fails with `HttpError` naming `sakura test --record`, under
/// which it is forwarded to the enclosing `Http` and appended. `secret_headers` are never
/// written and never part of the match (design §17.57, §17.73).
pub fn recording(path: Path) -> Handler<Http, {Http, Fs}> { replaying(cassette(path)) }

/// A cassette file, read on first use. `Llm.recording` opens one per installation and replays
/// each call through it, so its exchanges advance in order across calls (design §17.102).
pub opaque type Cassette = { path: Path, id: Int }

pub fn cassette(path: Path) -> Cassette { Cassette { path, id: 0 } }

/// `c` with its file read; an open cassette as it is.
pub fn open(c: Cassette) -> Cassette ! {Fs, Fail<HttpError>} {
  if c.id != 0 { return c }
  Cassette { path: c.path, id: ok_or_fail(http_recording_open(Fs.root(), Path.to_string(c.path))) }
}

/// `recording` over the cassette `c`: one already open is not read again.
pub fn replaying(c: Cassette) -> Handler<Http, {Http, Fs}> {
  handler Http {
    var cur = c
    fn send(req) {
      cur = open(cur)
      let id = cur.id
      match http_recording_lookup(id, req) {
        Ok(Some(resp)) => resp,
        Ok(None) => {
          let resp = Http.send(req)
          ok_or_fail(http_recording_append(id, req, resp))
          resp
        }
        Err(reason) => fail HttpError { status: None, reason },
      }
    }
    fn stream(req, body) {
      cur = open(cur)
      let id = cur.id
      let incoming = match ok_or_fail(http_recording_lookup_stream(id, req)) {
        Some(incoming) => incoming,
        None => {
          // Recording: read the whole body from the enclosing `Http`, store it, replay it.
          let got = Http.stream(req, fn(i) { (i.status, i.headers, read_body(i.body)) })
          ok_or_fail(http_recording_append_stream(id, req, got.0, got.1, got.2))
          Incoming { status: got.0, headers: got.1, body: http_body_of(got.2) }
        }
      }
      http_stream_closing(incoming.body, fn() { body(incoming) })
    }
    fn read_chunk(b, max) { ok_or_fail(http_stream_read(b, max)) }
  }
}

fn read_body(b: Body) -> Bytes ! {Http, Fail<HttpError>} {
  var out: List<Int> = []
  var chunk = Http.read_chunk(b, 65_536)
  while Bytes.len(chunk) > 0 {
    out = List.concat(out, List.filter_map(List.range(0, Bytes.len(chunk)), fn(i) { Bytes.get(chunk, i) }))
    chunk = Http.read_chunk(b, 65_536)
  }
  Bytes.from_list(out)
}

fn ok_or_fail<T>(r: Result<T, String>) -> T ! {Fail<HttpError>} {
  match r {
    Ok(v) => v,
    Err(reason) => fail HttpError { status: None, reason },
  }
}

/// Test handler: the response of the first matching entry; no match is an `HttpError`.
pub fn scripted(script: List<(Matcher, Response)>) -> Handler<Http> {
  handler Http {
    fn send(req) { scripted_response(script, req) }
    fn stream(req, body) {
      let resp = scripted_response(script, req)
      let b = http_body_of(String.to_bytes(resp.body))
      http_stream_closing(b, fn() { body(Incoming { status: resp.status, headers: resp.headers, body: b }) })
    }
    fn read_chunk(b, max) { ok_or_fail(http_stream_read(b, max)) }
  }
}

fn scripted_response(script: List<(Matcher, Response)>, req: Request) -> Response ! {Fail<HttpError>} {
  match List.find(script, fn(entry) { matches(entry.0, req) }) {
    Some(entry) => entry.1,
    None => fail HttpError { status: None, reason: "no scripted response for {req.method} {req.url}" },
  }
}

fn matches(m: Matcher, req: Request) -> Bool {
  match m {
    Any => true,
    Path(p) => Url.path(req.url) == p,
    Method(method) => req.method == method,
  }
}

fn rate_limited(resp: Response) -> Response ! {Fail<RateLimited>} {
  if resp.status == Status.from(429) {
    let header = List.find(resp.headers, fn(h) { String.to_lower(h.0) == "retry-after" })
    let seconds = header.map(fn(h) { String.parse_int(h.1) })
    let after = match seconds {
      Some(Some(s)) => Some(Duration.seconds(s)),
      _ => None,
    }
    fail RateLimited { retry_after: after }
  }
  resp
}

@external(js, "sakura_runtime", "http_send")
fn http_send(req: Request) -> Result<Response, String>

@external(js, "sakura_runtime", "http_stream_open")
fn http_stream_open(req: Request) -> Result<Incoming, String>

@external(js, "sakura_runtime", "http_stream_closing")
fn http_stream_closing<T, e>(body: Body, k: fn() -> T ! e) -> T ! e

@external(js, "sakura_runtime", "http_stream_read")
fn http_stream_read(body: Body, max: Int) -> Result<Bytes, String>

@external(js, "sakura_runtime", "http_body_of")
fn http_body_of(bytes: Bytes) -> Body

@external(js, "sakura_runtime", "http_recording_lookup_stream")
fn http_recording_lookup_stream(id: Int, req: Request) -> Result<Option<Incoming>, String>

@external(js, "sakura_runtime", "http_recording_append_stream")
fn http_recording_append_stream(id: Int, req: Request, status: Status, headers: List<(String, String)>, body: Bytes) -> Result<Unit, String>

@external(js, "sakura_runtime", "http_recording_open")
fn http_recording_open(dir: Dir, path: String) -> Result<Int, String>

@external(js, "sakura_runtime", "http_recording_lookup")
fn http_recording_lookup(id: Int, req: Request) -> Result<Option<Response>, String>

@external(js, "sakura_runtime", "http_recording_append")
fn http_recording_append(id: Int, req: Request, resp: Response) -> Result<Unit, String>

test "scripted matches by path and method" {
  let script = [(Path("/a"), Response.status(200, "a")), (Method(Method.Post), Response.status(201, "p"))]
  with scripted(script) {
    expect_eq(try { get(Url.from("https://x/a?q=1")).body }, Ok("a"))
    expect_eq(try { Http.send(Request.post("/b", "")).status }, Ok(Status.from(201)))
    expect((try { get(Url.from("https://x/c")) }).is_err())
  }
}

test "429 is RateLimited with its Retry-After" {
  let limited = Response { ..Response.status(429, ""), headers: [("Retry-After", "2")] }
  with scripted([(Any, limited)]) {
    expect_fail(fn() { get(Url.from("/x")) }, RateLimited { retry_after: Some(Duration.seconds(2)) })
  }
}

test "scoped forwards only listed hosts" {
  let ok = Response.status(200, "ok")
  with scripted([(Any, ok)]), scoped(["api.example.com:443", "localhost:8080"]) {
    expect_eq(try { Http.send(Request.of(Method.Get, Url.from("https://api.example.com/v1"))) }, Ok(ok))
    expect_eq(try { Http.send(Request.of(Method.Get, Url.from("http://localhost:8080/"))) }, Ok(ok))
    expect((try { Http.send(Request.of(Method.Get, Url.from("https://evil.example/"))) }).is_err())
  }
}

test "bearer adds a secret header and leaves headers alone" {
  let req = bearer(Request.of(Method.Get, Url.from("https://a/")), Secret.of("t"))
  expect_eq(req.headers, [])
  expect_eq(List.len(req.secret_headers), 1)
  expect_eq(List.map(req.secret_headers, fn(h) { h.0 }), ["authorization"])
}

test "scripted and scoped stream a body as one chunk" {
  let ok = Response.status(200, "hello")
  with scripted([(Any, ok)]), scoped(["a.example:443"]) {
    let got = try {
      Http.stream(Request.of(Method.Get, Url.from("https://a.example/x")), fn(i) {
        let first = Http.read_chunk(i.body, 3)
        let rest = Http.read_chunk(i.body, 100)
        (i.status, String.from_bytes(first), String.from_bytes(rest), Bytes.len(Http.read_chunk(i.body, 100)))
      })
    }
    expect_eq(got, Ok((Status.from(200), Ok("hel"), Ok("lo"), 0)))
    let denied = try { Http.stream(Request.of(Method.Get, Url.from("https://b.example/")), fn(i) { i.status }) }
    expect(denied.is_err())
  }
}
