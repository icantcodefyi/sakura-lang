/// Renders any `Show` value in the stable format used by interpolation and snapshots:
/// valid Sakura Lang expression syntax (`User { id: 1, name: "a" }`, `Some([1, 2])`,
/// `Map.of([("a", 1)])`). Compiler intrinsic.
@external(js, "sakura_runtime", "show")
pub fn show<A: Show>(a: A) -> String

/// Why a value failed a refinement: `Percent.validate(101)` is
/// `Err(Violation { type_name: "Percent", clause: "it <= 100", value_summary: "101" })`.
/// `clause` is the source text of the failing top-level conjunct of the `where` clause (the
/// whole predicate when it is not an `&&` chain). In the prelude.
pub type Violation = { type_name: String, clause: String, value_summary: String }

/// The type of `@trust("reason")` (design §6.4, §17.16), accepted only by `Untrusted.trust`,
/// `Secret.expose` and `Html.raw`. Compiler-known and in the prelude; declared here only as
/// its home. It has no constructor, and a `Trust` cannot be stored or returned (`V6001`).
pub type Trust
