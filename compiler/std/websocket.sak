// WebSocket client as an effect (RFC 0002 §1, §3, §6, §7; design §17.262 (2), §17.279; plan
// `web-apis.md` phase 8). There are no event listeners: every web event is a value `receive`
// returns, a message or the close, so control flow is a `match` and nothing runs after the
// `connect` callback ends. The manifest's `net` list limits the host handler, `ws` on port 80
// and `wss` on 443 by default, checked like `Http`'s; the opening handshake follows no
// redirect. `WebSocket.scripted(script)` is the deterministic peer for tests. Client only: a
// server upgrade is not part of `std/serve`.

import std/stream.{Done, Next, Source}
import std/url.{Url}

/// A message: text (UTF-8 on the wire) or bytes.
pub type Message = Text(String) | Binary(Bytes)

/// How the connection ended (`CloseEvent`): the close code, the reason, and whether the
/// closing handshake completed. A connection that dropped is 1006 with `clean` false; a
/// received message over `max_message` is 1009, invalid UTF-8 text 1007 and a protocol error
/// 1002, each with `clean` false.
pub type CloseInfo = { code: Int, reason: String, clean: Bool }

/// What `receive` returns: a message, or the close (returned again by every later `receive`).
pub type Received = Data(Message) | Closed(CloseInfo)

/// `Connect`: no connection opened, and why (a host outside `net`, a URL that is not `ws` or
/// `wss`, a handshake answered with anything but 101, a network failure). `MessageTooLarge`:
/// `send` of a message over `max_message`. `NotOpen`: `send` after the close. `Failed`: the
/// host could not run the operation, or a scripted peer has no step for it.
pub type SocketReason = Connect(String) | MessageTooLarge | NotOpen | Failed(String)

pub error SocketError(reason: SocketReason)

/// The opening handshake's subprotocols (in preference order) and extra headers, and the largest
/// message, in bytes, either side may carry (`max_message`, at least 1).
pub type Options = { subprotocols: List<String>, headers: List<(String, String)>, max_message: Int }

/// No subprotocols, no extra headers, messages up to 16 MiB (16,777,216 bytes; RFC 0002 §6).
pub fn options() -> Options { Options { subprotocols: [], headers: [], max_message: 16_777_216 } }

/// An open connection, valid only inside the `connect` callback that received it (`V6003`).
@resource
pub opaque type Socket = { id: Int, protocol: String, max_message: Int }

/// The subprotocol the server chose, `""` when none.
pub fn protocol(sock: Socket) -> String { sock.protocol }

pub effect WebSocket {
  /// Opens a connection to `url` (`ws://` or `wss://`, no fragment), runs `body` with it, and
  /// closes it with 1001 when `body` returns, fails, defects or is cancelled, unless it is closed
  /// already.
  fn connect<T, e>(url: String, options: Options, body: fn(Socket) -> T ! e) -> T
    ! {Fail<SocketError> | e}
    requires options.max_message > 0
  /// Sends one message; waits while the connection's send buffer is full.
  fn send(sock: Socket, message: Message) -> Unit ! {Fail<SocketError>}
  /// The next message, waiting for it, or the close. The host holds at most 64 received
  /// messages and stops reading the connection until `receive` takes one.
  fn receive(sock: Socket) -> Received ! {Fail<SocketError>}
  /// Starts the closing handshake with `code` (1000, or 3000 to 4999) and `reason` (at most 123
  /// bytes); messages that arrive meanwhile are still received, then the close. A host closes
  /// the connection itself when the peer has not answered within 5 seconds (1006). A second
  /// close does nothing.
  fn close(sock: Socket, code: Int, reason: String) -> Unit
    ! {Fail<SocketError>}
    requires closable(code, reason)
}

/// Whether `close` accepts `code` and `reason` (the WebSocket standard's `close()` rules).
@total
pub fn closable(code: Int, reason: String) -> Bool {
  (code == 1000 || (code >= 3000 && code <= 4999)) && String.len(reason) <= 123
}

/// The messages of `sock` as a source, ending at the close. A view: pulling it receives, so it
/// is valid only inside the `connect` callback that received the socket (`V6003`).
pub fn messages(sock: Socket) -> Source<Message, {WebSocket, Fail<SocketError>}> {
  Source {
    pull: fn() {
      match WebSocket.receive(sock) {
        Data(m) => Next(m, messages(sock)),
        Closed(_) => Done,
      }
    },
  }
}

/// The root handler the host installs for a `main` that declares `WebSocket`: an RFC 6455
/// client over the host's TCP and TLS, limited to the manifest's `net` list, checked before the
/// connection opens.
pub fn host() -> Handler<WebSocket> {
  handler WebSocket {
    fn connect(url, options, body) {
      positive(options.max_message)
      let target = checked_url(url)
      let opened = match ws_connect(target, options) {
        Ok(o) => o,
        Err(reason) => fail SocketError { reason: Connect(reason) },
      }
      let sock = Socket { id: opened.0, protocol: opened.1, max_message: options.max_message }
      ws_closing(sock.id, fn() { body(sock) })
    }
    fn send(sock, message) {
      fits(sock, message)
      match ws_send(sock.id, message) {
        Ok(true) => {},
        Ok(false) => fail SocketError { reason: NotOpen },
        Err(reason) => fail SocketError { reason: Failed(reason) },
      }
    }
    fn receive(sock) { host_ok(ws_receive(sock.id)) }
    fn close(sock, code, reason) {
      close_args(code, reason)
      host_ok(ws_close(sock.id, code, reason))
    }
  }
}

/// One step of a scripted peer. `Reply(expect, answer)`: the peer waits for the client to send
/// `expect`, then sends `answer`. `Push(message)`: the peer sends `message`. `Close(code,
/// reason)`: the peer closes.
pub type ScriptStep = Reply(Message, Message) | Push(Message) | Close(Int, String)

/// Test handler: each `connect` meets a peer that plays `script` from its first step, in order.
/// A send that is not the `expect` of the next `Reply`, or a `receive` with nothing sent and no
/// close, fails with `Failed` naming the step, where a real peer would leave the program
/// waiting. A message over `max_message` either way is handled as `host()` handles it, and so
/// are `close`, the close returned again, and `NotOpen` after it. The URL is checked as
/// `host()` checks it; `net` is not consulted, and the subprotocol is `""`.
pub fn scripted(script: List<ScriptStep>) -> Handler<WebSocket> {
  handler WebSocket {
    var peers: Map<Int, Peer> = Map.empty()
    var next = 0
    fn connect(url, options, body) {
      positive(options.max_message)
      let _ = checked_url(url)
      next = next + 1
      let id = next
      let peer = Peer { steps: script, inbox: [], closed: None, max_message: options.max_message }
      peers = Map.insert(peers, id, advance(peer))
      body(Socket { id, protocol: "", max_message: options.max_message })
    }
    fn send(sock, message) {
      fits(sock, message)
      let peer = peer_of(peers, sock)
      if peer.closed.is_some() { fail SocketError { reason: NotOpen } }
      let answer = match List.first(peer.steps) {
        Some(Reply(expect, answer)) if expect == message => answer,
        Some(step) =>
          fail SocketError {
            reason: Failed("the scripted peer expected {step}, not a send of {message}"),
          },
        None =>
          fail SocketError { reason: Failed("the script has no step for a send of {message}") },
      }
      let rest = List.slice(peer.steps, 1, List.len(peer.steps))
      peers = Map.insert(peers, sock.id, advance(deliver(Peer { ..peer, steps: rest }, answer)))
    }
    fn receive(sock) {
      let peer = peer_of(peers, sock)
      match List.first(peer.inbox) {
        Some(r) => {
          let rest = List.slice(peer.inbox, 1, List.len(peer.inbox))
          peers = Map.insert(peers, sock.id, Peer { ..peer, inbox: rest })
          r
        },
        None => match peer.closed {
          Some(info) => Closed(info),
          None => match List.first(peer.steps) {
            Some(step) =>
              fail SocketError {
                reason: Failed("the scripted peer has nothing to send before {step}"),
              },
            None => fail SocketError { reason: Failed("the script has no step left to receive") },
          },
        },
      }
    }
    fn close(sock, code, reason) {
      close_args(code, reason)
      let peer = peer_of(peers, sock)
      if !peer.closed.is_some() {
        let info = CloseInfo { code, reason, clean: true }
        let closed = Peer {
          ..peer,
          steps: [],
          inbox: List.push(peer.inbox, Closed(info)),
          closed: Some(info),
        }
        peers = Map.insert(peers, sock.id, closed)
      }
    }
  }
}

// The operations' preconditions, checked in each handler as they are declared (`D020`).
fn positive(max_message: Int) -> Unit
  requires max_message > 0
{}

fn close_args(code: Int, reason: String) -> Unit
  requires closable(code, reason)
{}

/// A scripted peer's state: the steps left, the messages the client has not received yet, the
/// close once it is queued, and the connection's `max_message`.
type Peer = {
  steps: List<ScriptStep>,
  inbox: List<Received>,
  closed: Option<CloseInfo>,
  max_message: Int,
}

fn peer_of(peers: Map<Int, Peer>, sock: Socket) -> Peer ! {Fail<SocketError>} {
  match Map.get(peers, sock.id) {
    Some(p) => p,
    None => fail SocketError { reason: Failed("not a scripted socket") },
  }
}

/// `peer` after the `Push` and `Close` steps at its front, which need no send.
fn advance(peer: Peer) -> Peer {
  if peer.closed.is_some() { return peer }
  let rest = List.slice(peer.steps, 1, List.len(peer.steps))
  match List.first(peer.steps) {
    Some(Push(m)) => advance(deliver(Peer { ..peer, steps: rest }, m)),
    Some(Close(code, reason)) => {
      let info = CloseInfo { code, reason, clean: true }
      Peer { ..peer, steps: [], inbox: List.push(peer.inbox, Closed(info)), closed: Some(info) }
    },
    _ => peer,
  }
}

/// `peer` with `m` queued for the client, or closed with 1009 when `m` is over `max_message`.
fn deliver(peer: Peer, m: Message) -> Peer {
  if size(m) > peer.max_message {
    let info = CloseInfo { code: 1009, reason: "message too large", clean: false }
    Peer { ..peer, steps: [], inbox: List.push(peer.inbox, Closed(info)), closed: Some(info) }
  } else {
    Peer { ..peer, inbox: List.push(peer.inbox, Data(m)) }
  }
}

/// The bytes `m` puts on the wire.
fn size(m: Message) -> Int {
  match m {
    Text(s) => String.len(s),
    Binary(b) => Bytes.len(b),
  }
}

fn fits(sock: Socket, m: Message) -> Unit ! {Fail<SocketError>} {
  if size(m) > sock.max_message { fail SocketError { reason: MessageTooLarge } }
}

/// `url` parsed and serialized, when it is a `ws` or `wss` URL without a fragment.
fn checked_url(url: String) -> String ! {Fail<SocketError>} {
  let parts = match Url.parse(url) {
    Ok(p) => p,
    Err(e) => fail SocketError { reason: Connect("invalid URL {url}: {e.reason}") },
  }
  if parts.scheme != "ws" && parts.scheme != "wss" {
    fail SocketError { reason: Connect("{parts.scheme}: is not ws or wss") }
  }
  if parts.fragment.is_some() {
    fail SocketError { reason: Connect("a WebSocket URL has no fragment") }
  }
  Url.to_string(parts)
}

fn host_ok<T>(r: Result<T, String>) -> T ! {Fail<SocketError>} {
  match r {
    Ok(v) => v,
    Err(reason) => fail SocketError { reason: Failed(reason) },
  }
}

/// Opens a connection to the serialized `url`: its id and the chosen subprotocol, or why not.
@external(js, "sakura_runtime", "ws_connect")
fn ws_connect(url: String, options: Options) -> Result<(Int, String), String>

/// The socket's table entry is closed by `file_close` on every exit of `body`, as a `File`'s.
@external(js, "sakura_runtime", "file_closing")
fn ws_closing<T, e>(id: Int, body: fn() -> T ! e) -> T ! e

/// `Ok(true)` when sent, `Ok(false)` after the close.
@external(js, "sakura_runtime", "ws_send")
fn ws_send(id: Int, message: Message) -> Result<Bool, String>

@external(js, "sakura_runtime", "ws_receive")
fn ws_receive(id: Int) -> Result<Received, String>

@external(js, "sakura_runtime", "ws_close")
fn ws_close(id: Int, code: Int, reason: String) -> Result<Unit, String>

test "scripted replies, pushes and closes in order" {
  let script = [Push(Text("hello")), Reply(Text("ping"), Text("pong")), Close(1000, "bye")]
  with scripted(script) {
    let got = try {
      WebSocket.connect("wss://example.test/", options(), fn(sock) {
        let first = WebSocket.receive(sock)
        WebSocket.send(sock, Text("ping"))
        (first, WebSocket.receive(sock), WebSocket.receive(sock), WebSocket.receive(sock))
      })
    }
    let bye = Closed(CloseInfo { code: 1000, reason: "bye", clean: true })
    expect_eq(got, Ok((Data(Text("hello")), Data(Text("pong")), bye, bye)))
  }
}

test "a URL that is not ws or wss is refused" {
  with scripted([]) {
    let got = try { WebSocket.connect("https://example.test/", options(), fn(_) { 0 }) }
    expect_eq(got, Err(SocketError { reason: Connect("https: is not ws or wss") }))
  }
}

test "closable follows the standard's close() rules" {
  expect(closable(1000, "") && closable(3000, "") && closable(4999, ""))
  expect(!closable(1001, "") && !closable(2999, "") && !closable(5000, ""))
  expect(!closable(1000, String.repeat("x", 124)))
}
