// HTTP servers (design §10.2, §10.4, M3). `listen` runs a router until the process stops;
// each request runs in its own task with the handlers installed around `listen`, and a
// handler's defect becomes a 500 with a redacted report, never a crashed server.
// needs M3: `[permissions] net` scoping of the address.

import std/request.{Get, Request}
import std/response.{Response}
import std/router.{Router}
import std/url.{Url}

pub type Address = { host: String, port: Int }

/// The server could not start or stopped (a port in use, `Serve.scripted` out of requests).
pub error ServeError(reason: String)

pub effect Serve {
  /// Answers requests with `handle` until stopped; `handle` runs under the handlers of this
  /// perform site (design §5.5).
  fn serve<e>(handle: fn(Request) -> Response ! e, addr: Address) -> Never ! {Fail<ServeError> | e}
}

/// Serves `router` on `addr`: `Serve.serve` with the router's dispatch as the handler.
pub fn listen<e>(router: Router<e>, addr: Address) -> Never ! {Serve, Fail<ServeError> | e} {
  Serve.serve(fn(req) { Router.handle(router, req) }, addr)
}

pub fn of(host: String, port: Int) -> Address
  requires port >= 0 && port <= 65_535
{ Address { host, port } }

/// Listens on the host network, within the manifest's `net` list.
pub fn host() -> Handler<Serve> {
  handler Serve {
    fn serve(handle, addr) { serve_listen(addr, handle) }
  }
}

/// Serves until the process stops, each request in its own task; a failure or defect in
/// `handle` becomes a 500 and the server keeps running.
@external(js, "sakura_runtime", "serve_listen")
fn serve_listen<e>(addr: Address, handle: fn(Request) -> Response ! e) -> Never
  ! {Fail<ServeError> | e}

/// Test handler: `serve` answers each of `requests` in order, writes
/// `"<METHOD> <path> -> <status> <body>"` to the test output, then fails with
/// `ServeError { reason: "no more requests" }`.
pub fn scripted(requests: List<Request>) -> Handler<Serve, {Test}> {
  handler Serve {
    fn serve(handle, addr) {
      for req in requests {
        let resp = handle(req)
        Test.output("{req.method} {Url.path(req.url)} -> {resp.status} {resp.body}")
      }
      fail ServeError { reason: "no more requests" }
    }
  }
}

test "scripted listen answers each request with the router" {
  let r = Router.new().get("/health", fn(_) { Response.status(200, "ok") })
  let reqs = [Request.of(Get, Url.from("/health")), Request.post("/health", "")]
  with scripted(reqs) {
    expect_fail(
      fn() { Serve.listen(r, of("127.0.0.1", 8080)) },
      ServeError { reason: "no more requests" },
    )
  }
  expect_output(["Get /health -> 200 ok", "Post /health -> 405 method not allowed"])
}
