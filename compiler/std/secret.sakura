// Credentials (design §6.4). `Secret` is compiler-known; this module is its home. A secret is
// not `Show`, `Eq`, `Ord` or `Schema`, so it cannot reach text, logs or serialized output;
// std sinks (`Http.bearer`, `Sql.postgres`) take it as it is. This prevents accidental
// disclosure only.

/// Wraps `value`. For tests and adapters; `Env.secret` is the usual source.
@external(js, "sakura_runtime", "secret_wrap")
pub fn of<T>(value: T) -> Secret<T>

/// The wrapped value, for an adapter that must hand it to a host API. `sakura audit` lists every
/// `@trust` reason.
pub fn expose<T>(s: Secret<T>, reason: Trust) -> T { reveal(s) }

@external(js, "sakura_runtime", "secret_expose")
fn reveal<T>(s: Secret<T>) -> T

/// Applies `f` inside the secret, so a derived credential stays secret.
pub fn map<T, U>(s: Secret<T>, f: fn(T) -> U) -> Secret<U> { of(f(reveal(s))) }

test "expose returns the wrapped value" {
  let token = of("s3cr3t")
  expect_eq(expose(token, @trust("test")), "s3cr3t")
}

test "map keeps the result secret" {
  let header = map(of("abc"), fn(t) { "Bearer " + t })
  expect_eq(expose(header, @trust("test")), "Bearer abc")
}
