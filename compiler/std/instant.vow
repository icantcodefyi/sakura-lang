// Points in UTC time, as milliseconds since 1970-01-01T00:00:00Z. Calendar math is
// pure Vow (proleptic Gregorian, Howard Hinnant's civil-date algorithms), so every
// backend formats and parses identically.

import std/duration.{Duration}

pub type Instant = Instant(Int)

pub error TimeError(input: String)

let ms_per_day = 86_400_000

pub fn from_unix_millis(ms: Int) -> Instant { Instant(ms) }

pub fn to_unix_millis(i: Instant) -> Int {
  match i { Instant(ms) => ms }
}

pub fn add(i: Instant, d: Duration) -> Instant {
  Instant(to_unix_millis(i) + d.to_millis())
}

/// `a - b` as a duration (negative when `a` is earlier).
pub fn diff(a: Instant, b: Instant) -> Duration {
  Duration.millis(to_unix_millis(a) - to_unix_millis(b))
}

/// RFC 3339 in UTC: `2026-10-17T09:30:00Z`, with `.mmm` only when milliseconds are
/// non-zero. Years outside 0000–9999 are not zero-padded.
pub fn format_iso(i: Instant) -> String {
  let ms = to_unix_millis(i)
  let days = floor_div(ms, ms_per_day)
  let rem = ms - days * ms_per_day
  let (y, m, d) = civil_from_days(days)
  let secs = rem / 1000
  let millis = rem % 1000
  let date = "{pad(y, 4)}-{pad(m, 2)}-{pad(d, 2)}"
  let time = "{pad(secs / 3600, 2)}:{pad(secs / 60 % 60, 2)}:{pad(secs % 60, 2)}"
  if millis == 0 { "{date}T{time}Z" } else { "{date}T{time}.{pad(millis, 3)}Z" }
}

/// Parses exactly `YYYY-MM-DDTHH:MM:SSZ` or `YYYY-MM-DDTHH:MM:SS.mmmZ` (UTC only, no
/// offsets, no leap seconds). Impossible dates such as Feb 30 are rejected.
pub fn parse(text: String) -> Result<Instant, TimeError> {
  let bad = Err(TimeError { input: text })
  let cs = String.chars(text)
  let n = List.len(cs)
  if n != 20 && n != 24 { return bad }
  let at = fn(i, c) { cs[i] == Some(c) }
  let shape = at(4, "-") && at(7, "-") && at(10, "T") && at(13, ":") && at(16, ":")
  let tail = if n == 20 { at(19, "Z") } else { at(19, ".") && at(23, "Z") }
  if !shape || !tail { return bad }
  let field = fn(start, end) { String.parse_int(List.join(List.slice(cs, start, end), "")) }
  let frac = if n == 24 { field(20, 23) } else { Some(0) }
  match (field(0, 4), field(5, 7), field(8, 10), field(11, 13), field(14, 16), field(17, 19), frac) {
    (Some(y), Some(mo), Some(d), Some(h), Some(mi), Some(s), Some(ms)) => {
      let days = days_from_civil(y, mo, d)
      let in_range = y >= 0 && h >= 0 && h <= 23 && mi >= 0 && mi <= 59 && s >= 0 && s <= 59 && ms >= 0
      if !in_range || civil_from_days(days) != (y, mo, d) { return bad }
      Ok(Instant(days * ms_per_day + ((h * 60 + mi) * 60 + s) * 1000 + ms))
    }
    _ => bad,
  }
}

fn pad(n: Int, width: Int) -> String {
  String.pad_left(Int.to_string(n), width, "0")
}

fn floor_div(a: Int, b: Int) -> Int {
  let q = a / b
  if a % b != 0 && (a < 0) != (b < 0) { q - 1 } else { q }
}

fn civil_from_days(days: Int) -> (Int, Int, Int) {
  let z = days + 719_468
  let era = floor_div(z, 146_097)
  let doe = z - era * 146_097
  let yoe = (doe - doe / 1460 + doe / 36_524 - doe / 146_096) / 365
  let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
  let mp = (5 * doy + 2) / 153
  let d = doy - (153 * mp + 2) / 5 + 1
  let m = if mp < 10 { mp + 3 } else { mp - 9 }
  let y = yoe + era * 400 + (if m <= 2 { 1 } else { 0 })
  (y, m, d)
}

fn days_from_civil(year: Int, m: Int, d: Int) -> Int {
  let y = if m <= 2 { year - 1 } else { year }
  let era = floor_div(y, 400)
  let yoe = y - era * 400
  let mp = if m > 2 { m - 3 } else { m + 9 }
  let doy = (153 * mp + 2) / 5 + d - 1
  let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
  era * 146_097 + doe - 719_468
}

test "epoch and known instants format" {
  expect_eq(format_iso(from_unix_millis(0)), "1970-01-01T00:00:00Z")
  expect_eq(format_iso(from_unix_millis(1_767_225_600_000)), "2026-01-01T00:00:00Z")
  expect_eq(format_iso(from_unix_millis(951_782_400_123)), "2000-02-29T00:00:00.123Z")
  expect_eq(format_iso(from_unix_millis(-1000)), "1969-12-31T23:59:59Z")
}

test "parse round-trips" {
  expect_eq(parse("2026-10-17T12:34:56Z").map(format_iso), Ok("2026-10-17T12:34:56Z"))
  expect_eq(parse("2026-10-17T12:34:56.789Z").map(format_iso), Ok("2026-10-17T12:34:56.789Z"))
  expect_eq(parse("1970-01-01T00:00:00Z"), Ok(from_unix_millis(0)))
}

test "parse rejects malformed and impossible dates" {
  expect_eq(parse("2026-02-30T00:00:00Z"), Err(TimeError { input: "2026-02-30T00:00:00Z" }))
  expect(parse("2024-02-29T00:00:00Z").is_ok())
  expect(parse("2023-02-29T00:00:00Z").is_err())
  expect(parse("2026-10-17 12:34:56Z").is_err())
  expect(parse("2026-10-17T24:00:00Z").is_err())
  expect(parse("2026-10-17T12:34:56+01:00").is_err())
  expect(parse("").is_err())
}

test "add and diff" {
  let t = from_unix_millis(1000)
  expect_eq(t.add(Duration.seconds(2)), from_unix_millis(3000))
  expect_eq(diff(from_unix_millis(500), t), Duration.millis(-500))
}
