/// Renders any `Show` value in the stable format used by interpolation and snapshots:
/// valid Vow expression syntax (`User { id: 1, name: "a" }`, `Some([1, 2])`,
/// `Map.of([("a", 1)])`). Compiler intrinsic.
@external(js, "vow_runtime", "show")
pub fn show<A: Show>(a: A) -> String

/// Why a value failed a refinement: `Percent.validate(101)` is
/// `Err(Violation { type_name: "Percent", clause: "it <= 100", value_summary: "101" })`.
/// `clause` is the source text of the failing conjunct.
pub type Violation = { type_name: String, clause: String, value_summary: String }
