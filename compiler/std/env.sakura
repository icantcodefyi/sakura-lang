// Environment variables as an effect. Prelude effect. Which keys a program may read is
// decided by the handler: the root handler only exposes the manifest's `env` list.

pub effect Env {
  fn get(key: String) -> Option<String>
  /// The value wrapped as a `Secret`, which cannot be shown, logged or serialized.
  fn secret(key: String) -> Option<Secret<String>>
}

/// The root handler the host installs for a `main` that declares `Env`: the process
/// environment. Limiting it to the manifest's `env` keys arrives with `[permissions]` (M3).
pub fn host() -> Handler<Env> {
  handler Env {
    fn get(key) { env_get(key) }
    fn secret(key) { env_get(key).map(fn(v) { wrap_secret(v) }) }
  }
}

@external(js, "sakura_runtime", "env_get")
fn env_get(key: String) -> Option<String>

@external(js, "sakura_runtime", "secret_wrap")
fn wrap_secret(value: String) -> Secret<String>

/// Test default: variables come from `vars` only.
pub fn of(vars: Map<String, String>) -> Handler<Env> {
  handler Env {
    fn get(key) { Map.get(vars, key) }
    fn secret(key) { Map.get(vars, key).map(fn(v) { wrap_secret(v) }) }
  }
}

/// Attenuates the enclosing `Env` handler to `keys`; other keys read as absent.
pub fn only(keys: List<String>) -> Handler<Env, {Env}> {
  handler Env {
    fn get(key) { if List.contains(keys, key) { Env.get(key) } else { None } }
    fn secret(key) { if List.contains(keys, key) { Env.secret(key) } else { None } }
  }
}

test "of serves the given map" {
  with of(Map.of([("HOME", "/home/a")])) {
    expect_eq(Env.get("HOME"), Some("/home/a"))
    expect_eq(Env.get("PATH"), None)
    expect(Env.secret("HOME").is_some())
  }
}

test "only hides keys outside the list" {
  with of(Map.of([("A", "1"), ("B", "2")])), only(["A"]) {
    expect_eq(Env.get("A"), Some("1"))
    expect_eq(Env.get("B"), None)
  }
}
