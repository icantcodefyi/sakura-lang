// HTTP requests (design §10.4, M3), the home module of `Request`. A separate module from
// `std/http` and `std/response` because `Request.json` and `Response.json` (and
// `Request.post_json` and `Http.post_json`) would otherwise be one name (§4.9).
// needs M3: `Schema` codecs in runtime/js for `post_json` and `json`.

import std/encoding.{Encoding, Errors}
import std/headers.{Headers}
import std/url.{Url}

/// `Connect` is a proxy verb and is not one.
pub type Method = Get | Head | Post | Put | Patch | Delete | Options | Trace

/// A request or response body (RFC 0002 §2.4). A host response arrives as `Bytes`;
/// `Response.text`, `json` and `bytes` read any of the three.
pub type Payload = Empty | Text(String) | Bytes(Bytes)

/// What a 3xx response does (Fetch's `redirect`): `Follow` sends the next hop, at most 20;
/// `Manual` returns the 3xx response; `Error` fails `HttpError` with its status.
pub type Redirect = Follow | Manual | Error

/// `secret_headers` (`Http.bearer` adds `authorization`) are sent by host handlers as headers
/// and are never shown, matched by `Http.scripted` or recorded (design §17.57). `params` are
/// the path parameters a `Router` matched (`:id` in `/users/:id`). `redirect` is `Follow` from
/// every builder.
pub type Request = {
  method: Method,
  url: Url,
  headers: List<(String, String)>,
  body: Payload,
  redirect: Redirect,
  secret_headers: List<(String, Secret<String>)>,
  params: List<(String, String)>,
}

/// The request body is not acceptable; `detail` is safe to return to the client.
pub error BadRequest(detail: String)

/// A request with no headers or body.
pub fn of(method: Method, url: Url) -> Request {
  Request {
    method,
    url,
    headers: [],
    body: Empty,
    redirect: Follow,
    secret_headers: [],
    params: [],
  }
}

/// A `POST` of `body` to `path`, for route handlers and their tests.
pub fn post(path: String, body: String) -> Request {
  Request { ..of(Post, Url.from(path)), body: Text(body) }
}

/// A `POST` of `body` encoded as JSON.
pub fn post_json<T: Schema>(url: Url, body: T) -> Request {
  Request {
    ..of(Post, url),
    headers: [("content-type", "application/json")],
    body: Text(Json.encode(body)),
  }
}

/// `req` with `body` (`fetch`'s `body` option).
pub fn with_payload(req: Request, body: Payload) -> Request { Request { ..req, body } }

/// `req` with the header `name` set to `value`: earlier pairs of that name (any case) are
/// removed and the pair is added at the end. Not validated here; `with_headers(try
/// Headers.of(…))` validates, and the host refuses an invalid pair at send.
pub fn with_header(req: Request, name: String, value: String) -> Request {
  let wanted = String.to_lower(name)
  let kept = List.filter(req.headers, fn(h) { String.to_lower(h.0) != wanted })
  Request { ..req, headers: List.push(kept, (name, value)) }
}

/// `req` with its headers replaced by `h`'s pairs, in order.
pub fn with_headers(req: Request, h: Headers) -> Request {
  Request { ..req, headers: Headers.to_list(h) }
}

/// The body's bytes (Fetch's `bytes()`): `Empty` as none, `Text` as UTF-8. A body over
/// `limit` bytes is `BadRequest`.
pub fn bytes(req: Request, limit: Int) -> Bytes ! {Fail<BadRequest>} {
  let b = match req.body {
    Empty => Bytes.from_list([]),
    Text(s) => String.to_bytes(s),
    Bytes(b) => b,
  }
  if Bytes.len(b) > limit { fail BadRequest { detail: "body exceeds {limit} bytes" } }
  b
}

/// The body as strict UTF-8 (Fetch's `text()` substitutes U+FFFD; a server refuses instead).
/// A body over `limit` bytes or one that is not UTF-8 is `BadRequest`.
pub fn text(req: Request, limit: Int) -> String ! {Fail<BadRequest>} {
  match Encoding.decode(bytes(req, limit), Encoding.Utf8, Errors.Fatal) {
    Ok(s) => s,
    Err(_) => fail BadRequest { detail: "body is not UTF-8" },
  }
}

/// The body decoded as `T` (named by the binding's annotation), refinements included.
/// A body over `limit` bytes, one that is not UTF-8 or one that does not decode is `BadRequest`.
pub fn json<T: Schema>(req: Request, limit: Int) -> T ! {Fail<BadRequest>} {
  match Json.decode(text(req, limit)) {
    Ok(value) => value,
    Err(e) => fail BadRequest { detail: "{e.path}: {e.message}" },
  }
}

/// The path parameter `name` if the router matched one, otherwise the query parameter `name`
/// (not percent-decoded).
pub fn param(req: Request, name: String) -> Option<String> {
  match List.find(req.params, fn(p) { p.0 == name }) {
    Some(p) => Some(p.1),
    None => Url.query_param(req.url, name),
  }
}

/// The first header called `name`, compared case-insensitively.
pub fn header(req: Request, name: String) -> Option<String> {
  let wanted = String.to_lower(name)
  List.find(req.headers, fn(h) { String.to_lower(h.0) == wanted }).map(fn(h) { h.1 })
}

test "post and param" {
  let req = post("/users?invite=abc", "\{\}")
  expect_eq(req.method, Post)
  expect_eq(param(req, "invite"), Some("abc"))
  expect_eq(param(Request { ..req, params: [("invite", "path")] }, "invite"), Some("path"))
  expect_eq(
    header(Request { ..req, headers: [("Content-Type", "text/plain")] }, "content-type"),
    Some("text/plain"),
  )
}

test "payload builders" {
  let req = of(Put, Url.from("https://a.example/f"))
    .with_header("Content-Type", "text/plain")
    .with_header("content-type", "application/octet-stream")
    .with_payload(Bytes(Bytes.from_list([0, 255])))
  expect_eq(req.headers, [("content-type", "application/octet-stream")])
  expect_eq(req.body, Bytes(Bytes.from_list([0, 255])))
  expect_eq(req.redirect, Follow)
  expect_eq(of(Options, Url.from("/")).body, Empty)
  let bad: Result<Int, BadRequest> = try { json(req, 10) }
  expect_eq(bad, Err(BadRequest { detail: "body is not UTF-8" }))
  let n: Result<Int, BadRequest> = try { json(post("/n", "42"), 10) }
  expect_eq(n, Ok(42))
}

test "bytes and text" {
  let bin = of(Put, Url.from("/f")).with_payload(Bytes(Bytes.from_list([0, 255])))
  expect_eq(try { bytes(bin, 2) }, Ok(Bytes.from_list([0, 255])))
  expect_eq(try { bytes(bin, 1) }, Err(BadRequest { detail: "body exceeds 1 bytes" }))
  expect_eq(try { text(bin, 2) }, Err(BadRequest { detail: "body is not UTF-8" }))
  expect_eq(try { text(post("/t", "h\u{E9}"), 3) }, Ok("h\u{E9}"))
  expect_eq(
    try { text(post("/t", "h\u{E9}"), 2) },
    Err(BadRequest { detail: "body exceeds 2 bytes" }),
  )
  expect_eq(try { bytes(of(Get, Url.from("/")), 0) }, Ok(Bytes.from_list([])))
}
