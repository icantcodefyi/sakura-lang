// 64-bit signed integers with checked arithmetic: overflow is Defect `D001`, division
// or remainder by zero is `D002`. On the JS backend values beyond ±(2^53 − 1) are
// Defect `D003` (design §4.1). `Int` is compiler-known; this module is its home.

@external(js, "vow_runtime", "int_to_float")
pub fn to_float(i: Int) -> Float

/// Decimal text, `-` for negatives. Same as `"{i}"`.
@external(js, "vow_runtime", "int_to_string")
pub fn to_string(i: Int) -> String

/// `a + b`, or `None` instead of an overflow defect.
@external(js, "vow_runtime", "int_checked_add")
pub fn checked_add(a: Int, b: Int) -> Option<Int>

/// `a + b` modulo 2^64 (two's complement). For hashing, not arithmetic.
@external(js, "vow_runtime", "int_wrapping_add")
pub fn wrapping_add(a: Int, b: Int) -> Int

/// Absolute value; `abs` of the minimum `Int` overflows (Defect `D001`).
@total
pub fn abs(i: Int) -> Int {
  if i < 0 { 0 - i } else { i }
}

@total
pub fn min(a: Int, b: Int) -> Int {
  if a <= b { a } else { b }
}

@total
pub fn max(a: Int, b: Int) -> Int {
  if a >= b { a } else { b }
}

pub fn clamp(i: Int, lo: Int, hi: Int) -> Int
  requires lo <= hi
{
  min(max(i, lo), hi)
}

/// `base` to the power `exp`, by squaring; overflow is Defect `D001`.
pub fn pow(base: Int, exp: Int) -> Int
  requires exp >= 0
{
  var result = 1
  var b = base
  var n = exp
  while n > 0 {
    if n % 2 == 1 { result = result * b }
    n = n / 2
    if n > 0 { b = b * b }
  }
  result
}

test "abs, min, max, clamp" {
  expect_eq(abs(-4), 4)
  expect_eq(abs(4), 4)
  expect_eq(min(2, 9), 2)
  expect_eq(max(2, 9), 9)
  expect_eq(clamp(15, 0, 10), 10)
  expect_eq(clamp(-3, 0, 10), 0)
  expect_eq(clamp(5, 0, 10), 5)
}

test "pow" {
  expect_eq(pow(2, 10), 1024)
  expect_eq(pow(-3, 3), -27)
  expect_eq(pow(7, 0), 1)
  expect_eq(pow(1, 1_000_000_000), 1)
}

test "division truncates toward zero" {
  expect_eq(7 / 2, 3)
  expect_eq(-7 / 2, -3)
  expect_eq(-7 % 2, -1)
}

test "conversions" {
  expect_eq(to_string(-12), "-12")
  expect_eq(to_float(3), 3.0)
  expect_eq(checked_add(1, 2), Some(3))
}

test "overflow and division by zero are defects" {
  expect_defect(fn() { pow(10, 30) })
  let zero = 0
  expect_defect(fn() { 1 / zero })
  expect_defect(fn() { clamp(1, 5, 0) })
}
