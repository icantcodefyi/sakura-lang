// Files as an effect (design §10.2, M3). Authority is the handler's directory: every path
// is relative to it (`Path` cannot hold `..` or a leading `/`) and the host rejects
// symlinks that escape it (design §6.1).
// needs M3: the `file_*` externals behind `with_file` and `File`.

import std/path.{Path}
import std/untrusted

/// A directory capability. External: only `Fs.root()` and `Dir.subdir` produce one.
pub type Dir

pub type Entry = { name: String, is_dir: Bool }

/// `Write` creates or truncates the file, `Append` creates it or writes after its end.
pub type Mode = Read | Write | Append

/// An open file, valid only inside the `with_file` body that received it (design §6.7). It is
/// the capability: `File.read_chunk` and `File.write_chunk` need no `Fs` handler, because a
/// clause's callback cannot reach the clause's own handler (design §5.5).
pub opaque type File = { id: Int, path: Path, mode: Mode }

/// `path` is relative to the handler's directory; `reason` is the host's message.
pub error FsError(path: String, reason: String)

pub effect Fs {
  /// The handler's directory, for attenuation with `Dir.subdir` and `Fs.rooted`.
  fn root() -> Dir
  fn read(path: Path) -> Bytes ! {Fail<FsError>}
  /// The file as UTF-8 text; invalid UTF-8 is an `FsError`.
  fn read_text(path: Path) -> Untrusted<String> ! {Fail<FsError>}
  /// Creates or replaces the file.
  fn write(path: Path, data: Bytes) -> Unit ! {Fail<FsError>}
  /// Entries sorted by name.
  fn list(dir: Path) -> List<Entry> ! {Fail<FsError>}
  fn exists(path: Path) -> Bool
  /// Opens `path`, runs `body` with the file and closes it on every exit: return, `fail`,
  /// defect or cancellation.
  fn with_file<T, e>(path: Path, mode: Mode, body: fn(File) -> T ! e) -> T ! {Fail<FsError> | e}
}

/// The root handler the host installs for a `main` that declares `Fs`: the package
/// directory, limited to the manifest's `fs.read`/`fs.write` lists.
pub fn host() -> Handler<Fs> { rooted(fs_root()) }

/// A handler confined to `dir`.
pub fn rooted(dir: Dir) -> Handler<Fs> {
  handler Fs {
    fn root() { dir }
    fn read(path) { ok_or_fail(path, fs_read(dir, Path.to_string(path))) }
    fn read_text(path) {
      let bytes = ok_or_fail(path, fs_read(dir, Path.to_string(path)))
      untrusted.of(ok_or_fail(path, String.from_bytes(bytes).map_err(fn(e) { "invalid UTF-8 at byte {e.offset}" })))
    }
    fn write(path, data) { ok_or_fail(path, fs_write(dir, Path.to_string(path), data)) }
    fn list(p) { ok_or_fail(p, fs_list(dir, Path.to_string(p))) }
    fn exists(path) { fs_exists(dir, Path.to_string(path)) }
    fn with_file(path, mode, body) { awaiting_runtime(path) }
  }
}

/// The directory `name` inside `d`; fails if it is missing or a symlink out of `d`.
pub fn subdir(d: Dir, name: String) -> Dir ! {Fail<FsError>} {
  match fs_subdir(d, name) {
    Ok(sub) => sub,
    Err(reason) => fail FsError { path: name, reason },
  }
}

/// Test handler over in-memory files; `write` updates them. `root()` is a directory with
/// no host access, so `Fs.rooted(Fs.root())` inside it fails every operation. A file opened
/// with `with_file` is written back when the body returns, and not at all if it fails.
pub fn memory(files: List<(Path, Bytes)>) -> Handler<Fs> {
  handler Fs {
    var store = Map.of(List.map(files, fn(f) { (Path.to_string(f.0), f.1) }))
    fn root() { fs_detached_root() }
    fn read(path) { found(path, Map.get(store, Path.to_string(path))) }
    fn read_text(path) {
      let bytes = found(path, Map.get(store, Path.to_string(path)))
      untrusted.of(ok_or_fail(path, String.from_bytes(bytes).map_err(fn(e) { "invalid UTF-8 at byte {e.offset}" })))
    }
    fn write(path, data) { store = Map.insert(store, Path.to_string(path), data) }
    fn list(dir) {
      let prefix = if Path.to_string(dir) == "." { "" } else { "{Path.to_string(dir)}/" }
      let names = List.filter_map(Map.keys(store), fn(k) {
        if String.starts_with(k, prefix) { Some(String.slice(k, String.len(prefix), String.len(k))) } else { None }
      })
      let entries = List.map(names, fn(n) {
        match String.split(n, "/") {
          [file] => Entry { name: file, is_dir: false },
          parts => Entry { name: List.first(parts).unwrap_or(n), is_dir: true },
        }
      })
      List.sort_by(List.unique(entries), fn(e) { e.name })
    }
    fn exists(path) { Map.contains(store, Path.to_string(path)) }
    fn with_file(path, mode, body) { awaiting_runtime(path) }
  }
}

// ponytail: until runtime/js has the `file_*` externals, `with_file` fails in both handlers;
// then `Fs.rooted`'s clause becomes `host_file(dir, path, mode, body)` and `Fs.memory`'s
// `let r = buffer_file(store, path, mode, body)`, `store = r.1`, `r.0`.
fn awaiting_runtime<T>(path: Path) -> T ! {Fail<FsError>} {
  fail FsError { path: Path.to_string(path), reason: "with_file needs runtime support (M3)" }
}

fn host_file<T, e>(dir: Dir, path: Path, mode: Mode, body: fn(File) -> T ! e) -> T ! {Fail<FsError> | e} {
  let id = ok_or_fail(path, file_open(dir, Path.to_string(path), mode))
  file_closing(id, fn() { body(File { id, path, mode }) })
}

/// `body`'s result and the store with the file written back (unchanged for `Read`).
fn buffer_file<T, e>(store: Map<String, Bytes>, path: Path, mode: Mode, body: fn(File) -> T ! e)
  -> (T, Map<String, Bytes>)
  ! {Fail<FsError> | e}
{
  let key = Path.to_string(path)
  let initial = match mode {
    Read => found(path, Map.get(store, key)),
    Write => Bytes.from_list([]),
    Append => Map.get(store, key).unwrap_or(Bytes.from_list([])),
  }
  let id = file_buffer(initial)
  let result = file_closing(id, fn() { body(File { id, path, mode }) })
  let contents = file_contents(id)
  (result, if mode == Read { store } else { Map.insert(store, key, contents) })
}

/// Up to `max` bytes from the current position; empty at the end of the file.
pub fn read_chunk(file: File, max: Int) -> Bytes ! {Fail<FsError>}
  requires max > 0
{
  ok_or_fail(file.path, file_read(file.id, max))
}

/// Writes at the end of the file; fails for a file opened with `Read`.
pub fn write_chunk(file: File, data: Bytes) -> Unit ! {Fail<FsError>} {
  if file.mode == Read { fail FsError { path: Path.to_string(file.path), reason: "opened for reading" } }
  ok_or_fail(file.path, file_write(file.id, data))
}

/// Every chunk from the current position to the end.
pub fn read_all(file: File) -> Bytes ! {Fail<FsError>} {
  var out: List<Int> = []
  var chunk = read_chunk(file, 65_536)
  while Bytes.len(chunk) > 0 {
    out = List.concat(out, to_list(chunk))
    chunk = read_chunk(file, 65_536)
  }
  Bytes.from_list(out)
}

fn to_list(b: Bytes) -> List<Int> { List.filter_map(List.range(0, Bytes.len(b)), fn(i) { Bytes.get(b, i) }) }

fn ok_or_fail<T>(path: Path, r: Result<T, String>) -> T ! {Fail<FsError>} {
  match r {
    Ok(v) => v,
    Err(reason) => fail FsError { path: Path.to_string(path), reason },
  }
}

fn found(path: Path, o: Option<Bytes>) -> Bytes ! {Fail<FsError>} {
  match o {
    Some(b) => b,
    None => fail FsError { path: Path.to_string(path), reason: "not found" },
  }
}

@external(js, "vow_runtime", "fs_root")
fn fs_root() -> Dir

@external(js, "vow_runtime", "fs_detached_root")
fn fs_detached_root() -> Dir

@external(js, "vow_runtime", "fs_subdir")
fn fs_subdir(d: Dir, name: String) -> Result<Dir, String>

@external(js, "vow_runtime", "fs_read")
fn fs_read(d: Dir, path: String) -> Result<Bytes, String>

@external(js, "vow_runtime", "fs_write")
fn fs_write(d: Dir, path: String, data: Bytes) -> Result<Unit, String>

@external(js, "vow_runtime", "fs_list")
fn fs_list(d: Dir, path: String) -> Result<List<Entry>, String>

@external(js, "vow_runtime", "fs_exists")
fn fs_exists(d: Dir, path: String) -> Bool

/// A host file in `d`, opened per `mode`; the id indexes the runtime's open-file table.
@external(js, "vow_runtime", "file_open")
fn file_open(d: Dir, path: String, mode: Mode) -> Result<Int, String>

/// An in-memory file holding `initial`, positioned at its start, for `Fs.memory`.
@external(js, "vow_runtime", "file_buffer")
fn file_buffer(initial: Bytes) -> Int

/// Runs `body`, then closes file `id` however `body` ends. A closed buffer keeps its
/// contents for `file_contents`.
@external(js, "vow_runtime", "file_closing")
fn file_closing<T, e>(id: Int, body: fn() -> T ! e) -> T ! e

@external(js, "vow_runtime", "file_read")
fn file_read(id: Int, max: Int) -> Result<Bytes, String>

@external(js, "vow_runtime", "file_write")
fn file_write(id: Int, data: Bytes) -> Result<Unit, String>

/// The whole contents of buffer `id`, open or closed; the buffer is then released.
@external(js, "vow_runtime", "file_contents")
fn file_contents(id: Int) -> Bytes
