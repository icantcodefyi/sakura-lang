// UUIDs in canonical lowercase `8-4-4-4-12` hex form. A refinement rather than an opaque
// type (design §17.130): the invariant is a predicate over the text, so `Json.decode` and
// `Cli.parse` read a `Uuid` from a string and check it.

pub type Uuid = String where is_canonical(it)

pub error UuidError(input: String)

pub fn to_string(u: Uuid) -> String { u }

/// Accepts the `8-4-4-4-12` form in either case; stores it lowercase.
pub fn parse(text: String) -> Result<Uuid, UuidError> {
  match Uuid.validate(String.to_lower(text)) {
    Ok(u) => Ok(u),
    Err(_) => Err(UuidError { input: text }),
  }
}

/// For text already in canonical form, such as a generator's output: the generated `from`.
pub fn from_canonical(text: String) -> Uuid
  requires is_canonical(text)
{ Uuid.from(text) }

/// Lowercase hex in the `8-4-4-4-12` form.
@total
pub fn is_canonical(text: String) -> Bool {
  let cs = String.chars(text)
  List.len(cs) == 36
    && List.all(List.enumerate(cs), fn(ic) {
      if ic.0 == 8 || ic.0 == 13 || ic.0 == 18 || ic.0 == 23 {
        ic.1 == "-"
      } else {
        String.contains("0123456789abcdef", ic.1)
      }
    })
}

test "parse normalizes case and rejects junk" {
  let u = parse("123E4567-E89B-12D3-A456-426614174000")
  expect_eq(u.map(to_string), Ok("123e4567-e89b-12d3-a456-426614174000"))
  expect(parse("123e4567e89b12d3a456426614174000").is_err())
  expect(parse("123e4567-e89b-12d3-a456-42661417400g").is_err())
}
