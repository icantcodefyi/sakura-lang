---
== main
pub type Tool<e> = record
  name: String
  run: fn(Int) -> Int ! {| $0}
pub type Agent<T, e> = record
  goal: $0
  tools: List<app/main::Tool<{| $1}>>
  max_steps: Int
pub fn tool<e>(name: String, run: fn(Int) -> Int ! {| $0}) -> app/main::Tool<{| $0}>
  params name#0 run#1
  block
    record app/main::Tool
      name:
        local name#0
      run:
        local run#1
pub fn run<T, e>(a: app/main::Agent<$0, {| $1}>, input: Int) -> Int ! {| $1}
  params a#0 input#1
  block
    var mut acc#2
      local input#1
    for
      pat bind t#3
      field .tools
        local a#0
      block
        assign mut acc#2
          method .run
            local t#3
            local mut acc#2
    local mut acc#2
pub fn pure_agent() -> app/main::Agent<String, {}>
  block
    record app/main::Agent
      goal:
        string "double"
      tools:
        list
          call
            def app/main::tool
            string "double"
            lambda (x#0)
              block
                Mul
                  local x#0
                  int 2
      max_steps:
        int 1
pub fn main() -> Unit ! {std/console::Console}
  block
    let: app/main::Agent<String, {std/console::Console}>
      pat bind loud#1
      record app/main::Agent
        goal:
          string "print"
        tools:
          list
            call
              def app/main::tool
              string "print"
              lambda (x#0)
                block
                  call
                    def std/console::Console.print
                    interpolate ["", ""]
                      local x#0
                  local x#0
        max_steps:
          int 1
    let
      pat _
      call
        def app/main::run
        local loud#1
        call
          def app/main::run
          call
            def app/main::pure_agent
          int 1
