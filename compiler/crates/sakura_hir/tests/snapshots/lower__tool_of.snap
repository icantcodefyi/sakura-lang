import std/tool Tool=std/tool::Tool
@tool("Adds two numbers.")
pub fn add(a: Int, b: Int) -> Int
  params a#0 b#1
  block
    Add
      local a#0
      local b#1
@tool("Unquoted {a}")
fn templated(a: Int) -> Int
  params a#0
  block
    local a#0
@tool("Identity.")
fn generic<A>(a: $0) -> $0
  params a#0
  block
    local a#0
fn plain() -> Int
  block
    int 1
pub fn tools() -> Unit
  block
    let
      pat bind ok#1
      call
        def std/tool::from
        string "add"
        string "Adds two numbers."
        lambda (args#0: app/main::add$Args)
          call
            def app/main::add
            field .a
              local args#0
            field .b
              local args#0
    let
      pat bind no_attr#2
      <missing>
    let
      pat bind lambda#3
      <missing>
    let
      pat bind local#4
      <missing>
    let
      pat bind not_literal#5
      <missing>
    let
      pat bind generic#6
      <missing>
    let
      pat bind unresolved#7
