// examples/contracts/src/main.sak:15-18, `pct` specialised to a constant
fn discount_0(price: Int) -> Int
  requires price >= 0
  ensures result <= price
{ price - price * 0 / 100 }

fn discount_1(price: Int) -> Int
  requires price >= 0
  ensures result <= price
{ price - price * 1 / 100 }

fn discount_2(price: Int) -> Int
  requires price >= 0
  ensures result <= price
{ price - price * 25 / 100 }

fn discount_3(price: Int) -> Int
  requires price >= 0
  ensures result <= price
{ price - price * 50 / 100 }

fn discount_4(price: Int) -> Int
  requires price >= 0
  ensures result <= price
{ price - price * 100 / 100 }

