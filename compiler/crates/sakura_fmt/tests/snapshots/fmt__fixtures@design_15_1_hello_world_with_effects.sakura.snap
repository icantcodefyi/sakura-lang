// examples/hello/src/main.sakura
fn greet(name: String) -> Unit ! {Clock, Console} {
  let now = Clock.now()
  Console.print("hello, {name}; it is {Instant.format_iso(now)}")
}

pub fn main() -> Unit ! {Clock, Console} { greet("Sakura Lang") }
