type P = { a: Int, s: String }
type Shape = Dot | Num(Int) | Pair(Int, String)
error Oops(code: Int)
error Bad
effect Counter { fn next() -> Int }
effect Acc {
  fn add(x: Int) -> Unit ! {Fail<Bad>}
  fn total() -> Int
}
fn counter(start: Int) -> Handler<Counter> { handler Counter { var n = start; fn next() { n = n + 1; n } } }
fn doubling() -> Handler<Counter, {Counter}> {
  handler Counter { var k = 0; fn next() { k = k + 1; Counter.next() * 2 + k } }
}
fn acc(limit: Int) -> Handler<Acc, {Console}> {
  handler Acc {
    var t = 0
    fn add(x) { if x > limit { fail Bad }; t = t + x; Console.print("add {x} = {t}") }
    fn total() { t }
  }
}
effect Around { fn around<e>(x: Int, body: fn(Int) -> Int ! e) -> Int ! e }
fn around() -> Handler<Around, {Console}> {
  handler Around {
    var calls = 0
    fn around(x, body) { calls = calls + 1; Console.print("around {x} #{calls}"); body(x + calls) }
  }
}
fn widen() -> Handler<Around, {Around}> { handler Around { fn around(x, body) { Around.around(x * 2, body) + 1 } } }
fn h0(p0: Int) -> Int
{ let v8 = (match (P { ..(P { ..(P { a: (-9), s: "x y" }), s: "a" }), s: "<{p0}>" }) { P { a: 0, .. } => p0, P { a: v1, s: v2 } => List.fold([10, (-9)], v1, fn(v3, v4) { let v6 = (match List.last([(-1), 4503599627370496]) { Some(v5) => (P { a: (-3), s: "q\"" }), None => (P { a: 1, s: "back\\slash" }) }); let v7 = (P { ..v6, s: "x y" }); v1 }) }); if false { return ((match (try { if false { fail Oops { code: v8 } }; (P { a: (-5), s: "two\nlines" }) } catch { Oops { code: v9 } => (P { a: 2, s: "日本" }) }) { P { a: 1, .. } => ({ if false { return p0 }; v8 }), P { a: v10, s: v11 } => (v8 % (-7)) }) / 10) }; (Int.max((-10), (try { if true { fail Bad }; (-3) } catch { Bad => (-5) })) + p0) }
fn h1(p0: Int) -> Shape ! {Counter}
{ let v16 = (if (match (match Pair(3, "") { Dot => Pair((-3), "a"), Num(v12) => Dot, Pair(v12, v13) => Pair(7, "🦀") }) { Dot => (true && false), Num(v14) => (false || false), Pair(v14, v15) => true }) { p0 } else { Counter.next() }); Dot }
pub fn main() -> Unit ! {Console} {
  with counter((-5)), doubling() {
    with counter((-10)) {
      Console.print("{({ Dot })}")
    }
  }
  Console.print("{1}")
}
