type P = { a: Int, s: String }
type Shape = Dot | Num(Int) | Pair(Int, String)
error Oops(code: Int)
error Bad
effect Counter { fn next() -> Int }
effect Acc {
  fn add(x: Int) -> Unit ! {Fail<Bad>}
  fn total() -> Int
}
fn counter(start: Int) -> Handler<Counter> { handler Counter { var n = start; fn next() { n = n + 1; n } } }
fn doubling() -> Handler<Counter, {Counter}> {
  handler Counter { var k = 0; fn next() { k = k + 1; Counter.next() * 2 + k } }
}
fn acc(limit: Int) -> Handler<Acc, {Console}> {
  handler Acc {
    var t = 0
    fn add(x) { if x > limit { fail Bad }; t = t + x; Console.print("add {x} = {t}") }
    fn total() { t }
  }
}
effect Around { fn around<e>(x: Int, body: fn(Int) -> Int ! e) -> Int ! e }
fn around() -> Handler<Around, {Console}> {
  handler Around {
    var calls = 0
    fn around(x, body) { calls = calls + 1; Console.print("around {x} #{calls}"); body(x + calls) }
  }
}
fn widen() -> Handler<Around, {Around}> { handler Around { fn around(x, body) { Around.around(x * 2, body) + 1 } } }
fn h0(p0: String, p1: P) -> String
  ensures true
{ let v5 = (match (P { ..(match (P { a: (-8), s: "x y" }) { P { a: 0, .. } => (P { a: (-6), s: "q\"" }), P { a: v1, s: v2 } => (P { a: 4, s: "🦀" }) }), s: (if true { "日本" } else { "" }) }) { P { a: 1, .. } => Dot, P { a: v3, s: v4 } => Dot }); (match p1 { P { a: 2, .. } => List.join(List.map(List.flat_map([2, 10], fn(v6) { var v7 = List.range(0, 3); for v8 in -1..4 { if true { return List.range(0, 2) }; var v9 = p0; for v10 in -1..3 { if true { return v7 }; v9 = v9 + "q\"" }; v7 = List.push(v7, 4503599627370496) }; var v11 = p0; for v12 in [0] { if true { break }; let v13 = v5; v11 = v11 + v11 }; v7 }), fn(v14) { "sakura" }), "<{7}>"), P { a: v15, s: v16 } => "<{v15}>" }) }
pub fn main() -> Unit ! {Console} {
  Console.print("{List.filter_map((match Pair(6, List.join(List.map([(-7)], fn(v17) { "" }), "sakura")) { Dot => List.push(List.concat(List.range(0, 1), [10, 6, (-9)]), 8), Num(v18) => (match (match String.parse_int("42") { Some(v19) => Pair(4, "tab\t"), None => Num((-1)) }) { Dot => List.filter(List.range(0, 0), fn(v20) { false }), Num(v21) => [9, (-10)], Pair(v21, v22) => (if false { [4503599627370496, (-5), (-4)] } else { List.range(0, 3) }) }), Pair(v18, v23) => List.concat(List.map(List.enumerate([(-9)]), fn(v24) { let v25 = v24.0; let v26 = v24.1; v26 }), (match [(-4)] { [] => [4503599627370496], [v27] => [(-4), 4], [v27, v29, ..] => [9, 4, 10] })) }), fn(v30) { if false { Some(10) } else { None } })}")
  Console.print("{(try { if true { fail Oops { code: 3 } }; "" } catch { Oops { code: v31 } => "{(try { (with acc(5) { let v32 = ((P { a: (-3), s: "a" })).s; (try { if true { fail Bad }; Num(8) } catch { Bad => Dot }) }) })}" })}")
  with acc(6) {
    var v33 = ((with counter(2), doubling() { "<{4503599627370496}>" }) + "tab\t"); var v34 = 0; while v34 < 4 { v34 = v34 + 1; Console.print("{v33}"); v33 = v33 + "{(P { a: (-8), s: "🦀" })}" }
    with counter((-2)) {
      Console.print("{Num(Int.min(Counter.next(), Int.min((try { if true { fail Bad }; 0 } catch { Bad => 1 }), ((-1) - 4))))}")
    }
  }
  with around() {
    Console.print("{(-1)}")
    Console.print("{((-9) * List.sum((try { var v35 = ({ [0, (-10)] }); var v36 = 0; while v36 < 1 { v36 = v36 + 1; var v37 = (match (P { a: 4503599627370496, s: "back\\slash" }) { P { a: 0, .. } => v35, P { a: v38, s: v39 } => [(-6)] }); var v40 = 0; while v40 < 1 { v40 = v40 + 1; if (true || true) { fail Oops { code: Int.abs(v36) } }; Console.print("{Num((-7))}"); v37 = List.push(v37, String.len("")) }; v35 = List.push(v35, (match (P { a: (-5), s: "back\\slash" }) { P { a: 2, .. } => 8, P { a: v41, s: v42 } => v36 })) }; if (try { if true { fail Bad }; false } catch { Bad => true }) { fail Oops { code: (-8) } }; ({ let v43 = (P { a: 6, s: "a" }); v35 }) } catch { Oops { code: v44 } => List.range(0, 1) })))}")
  }
