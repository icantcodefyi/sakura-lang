type P = { a: Int, s: String }
type Shape = Dot | Num(Int) | Pair(Int, String)
error Oops(code: Int)
error Bad
effect Counter { fn next() -> Int }
effect Acc {
  fn add(x: Int) -> Unit ! {Fail<Bad>}
  fn total() -> Int
}
fn counter(start: Int) -> Handler<Counter> { handler Counter { var n = start; fn next() { n = n + 1; n } } }
fn doubling() -> Handler<Counter, {Counter}> {
  handler Counter { var k = 0; fn next() { k = k + 1; Counter.next() * 2 + k } }
}
fn acc(limit: Int) -> Handler<Acc, {Console}> {
  handler Acc {
    var t = 0
    fn add(x) { if x > limit { fail Bad }; t = t + x; Console.print("add {x} = {t}") }
    fn total() { t }
  }
}
effect Around { fn around<e>(x: Int, body: fn(Int) -> Int ! e) -> Int ! e }
fn around() -> Handler<Around, {Console}> {
  handler Around {
    var calls = 0
    fn around(x, body) { calls = calls + 1; Console.print("around {x} #{calls}"); body(x + calls) }
  }
}
fn widen() -> Handler<Around, {Around}> { handler Around { fn around(x, body) { Around.around(x * 2, body) + 1 } } }
fn h0(p0: Int, p1: Int) -> String ! {Counter}
{ if true { return (match (match List.last((match List.get([1, (-3), 3], p0) { Some(v1) => [2, 9, 4], None => [(-10)] })) { Some(v2) => Dot, None => Pair(p0, "héllo") }) { Dot => "", Num(v3) => "日本", Pair(v3, v4) => "q\"" }) }; "q\"" }
fn h1(p0: Int) -> Int ! {Counter, Console, Fail<Oops | Bad>}
{ ((({ var v5 = p0; var v6 = 0; while v6 < 1 { v6 = v6 + 1; v5 = v5 + (-10) }; v5 }) + (match (P { a: 10, s: "a" }) { P { a: 2, .. } => p0, P { a: v7, s: v8 } => (-9) })) + (with acc(9) { Acc.add(Counter.next()); 3 })) }
pub fn main() -> Unit ! {Console} {
  Console.print("{(if List.any(List.concat((if true { [3, 5, (-3)] } else { [(-4), (-10), 7] }), [9]), fn(v9) { ({ Console.print("{"{"日本"}"}"); let v10 = Pair((-6), "sakura"); (match [6, (-4), 2] { [] => false, [v11, ..v12] => false }) }) }) { (try { if false { fail Oops { code: (-10) } }; var v13 = (try { if ([1, (-2), 7] >= [(-8), 4503599627370496, (-6)]) { fail Bad }; ((P { a: (-4), s: "héllo" })).a } catch { Bad => ((P { a: 9, s: "two\nlines" })).a }); for v14 in 1..0 { if ("<{v13}>" == "{"a"}") { continue }; let v15 = true; v13 = v13 + ({ let v16 = Dot; let v17 = List.range(1, 5); (-9) }) }; Dot } catch { Oops { code: v18 } => Dot }) } else { Pair((try { if false { fail Oops { code: ((-1) - 8) } }; 10 } catch { Oops { code: v19 } => Int.abs(6) }), "{(try { (match (P { a: (-5), s: "" }) { P { a: 0, .. } => "a", P { a: v20, s: v21 } => v21 }) })}") })}")
  Console.print("{List.contains(List.map(List.enumerate(List.concat([(-10)], [1, (-7), (-7)])), fn(v22) { let v23 = v22.0; let v24 = v22.1; List.sum(List.unique([10])) }), (((if false { 6 } else { 10 }) + (10 / (-1))) % 9))}")
  let v25 = List.range(0, 5)
}
