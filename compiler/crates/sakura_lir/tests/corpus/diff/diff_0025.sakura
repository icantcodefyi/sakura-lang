type P = { a: Int, s: String }
type Shape = Dot | Num(Int) | Pair(Int, String)
error Oops(code: Int)
error Bad
effect Counter { fn next() -> Int }
effect Acc {
  fn add(x: Int) -> Unit ! {Fail<Bad>}
  fn total() -> Int
}
fn counter(start: Int) -> Handler<Counter> { handler Counter { var n = start; fn next() { n = n + 1; n } } }
fn doubling() -> Handler<Counter, {Counter}> {
  handler Counter { var k = 0; fn next() { k = k + 1; Counter.next() * 2 + k } }
}
fn acc(limit: Int) -> Handler<Acc, {Console}> {
  handler Acc {
    var t = 0
    fn add(x) { if x > limit { fail Bad }; t = t + x; Console.print("add {x} = {t}") }
    fn total() { t }
  }
}
effect Around { fn around<e>(x: Int, body: fn(Int) -> Int ! e) -> Int ! e }
fn around() -> Handler<Around, {Console}> {
  handler Around {
    var calls = 0
    fn around(x, body) { calls = calls + 1; Console.print("around {x} #{calls}"); body(x + calls) }
  }
}
fn widen() -> Handler<Around, {Around}> { handler Around { fn around(x, body) { Around.around(x * 2, body) + 1 } } }
fn h0(p0: Bool) -> Shape ! {Fail<Oops | Bad>}
  requires (match (if false { Dot } else { Dot }) { Dot => ((-3) > 10), Num(v1) if false => !(true), Num(v1) => true, Pair(v1, v2) => false })
  ensures ((if true { 0 } else { (-3) }) == String.len("tab\t"))
{ let v6 = ({ var v3 = (P { a: (match (P { a: 4, s: "héllo" }) { P { a: 1, .. } => 3, P { a: v4, s: v5 } => v4 }), s: "tab\t" }); v3.a = (-8); v3 }); Pair(List.len(({ List.range(0, 0) })), (match List.flat_map([3, (-7), 8], fn(v7) { let v8 = true; List.range(0, 3) }) { [] => "{(try { let v9 = List.range(0, 2); Pair((-6), "tab\t") })}", [v10] => ("" + "日本"), [v10, v12, ..] => List.join(List.map([(-2)], fn(v13) { if false { return "two\nlines" }; let v14 = v6; "tab\t" }), "tab\t") })) }
pub fn main() -> Unit ! {Console} {
  with counter((-4)), doubling() {
    Console.print("{(try { h0(true) })}")
    with around() {
      Console.print("{List.range(0, 0)}")
    }
    Console.print("{(try { h0(true) })}")
  }
}
