type P = { a: Int, s: String }
type Shape = Dot | Num(Int) | Pair(Int, String)
error Oops(code: Int)
error Bad
effect Counter { fn next() -> Int }
effect Acc {
  fn add(x: Int) -> Unit ! {Fail<Bad>}
  fn total() -> Int
}
fn counter(start: Int) -> Handler<Counter> { handler Counter { var n = start; fn next() { n = n + 1; n } } }
fn doubling() -> Handler<Counter, {Counter}> {
  handler Counter { var k = 0; fn next() { k = k + 1; Counter.next() * 2 + k } }
}
fn acc(limit: Int) -> Handler<Acc, {Console}> {
  handler Acc {
    var t = 0
    fn add(x) { if x > limit { fail Bad }; t = t + x; Console.print("add {x} = {t}") }
    fn total() { t }
  }
}
effect Around { fn around<e>(x: Int, body: fn(Int) -> Int ! e) -> Int ! e }
fn around() -> Handler<Around, {Console}> {
  handler Around {
    var calls = 0
    fn around(x, body) { calls = calls + 1; Console.print("around {x} #{calls}"); body(x + calls) }
  }
}
fn widen() -> Handler<Around, {Around}> { handler Around { fn around(x, body) { Around.around(x * 2, body) + 1 } } }
fn h0(p0: Int, p1: Int) -> Bool
  requires (String.len("q\"") % (p0 - 0) != 7) && true
{ let v1 = Num((-1)); false }
pub fn main() -> Unit ! {Console} {
  Console.print("{(match String.parse_int("x") { Some(v2) => ({ var v3 = (P { ..(P { a: 0, s: "two\nlines" }), s: "back\\slash" }); v3.a = List.sum([4503599627370496]); v3 }), None => (P { a: (-9), s: "🦀" }) })}")
  Console.print("{Pair(String.len((try { if (Dot != Dot) { fail Oops { code: 9 } }; ((P { a: (-2), s: "q\"" })).s } catch { Oops { code: v4 } => "日本" })), (try { if ((-5) == Int.max((-5), (-3))) { fail Oops { code: (-6) } }; var v5 = List.range(1, 2); for v6 in 0..2 { Console.print("{List.range(2, 4)}"); let v11 = (P { ..(try { if false { fail Oops { code: v6 } }; var v7 = v6; for v8 in List.range(0, 2) { let v9 = true; v7 = v7 + 3 }; (P { a: 6, s: "x y" }) } catch { Oops { code: v10 } => (P { a: 6, s: "🦀" }) }), s: "" }); v5 = List.push(v5, (try { if false { fail Oops { code: v6 } }; ((-9) / v6) } catch { Oops { code: v12 } => List.len(List.range(0, 2)) })) }; "q\"" } catch { Oops { code: v13 } => "日本" }))}")
  Console.print("{Pair((-2), "🦀")}")
  with counter(8) {
    with acc(7) {
      Console.print("{(try { Acc.add(Counter.next()) })}")
      Console.print("{Num(Counter.next())}")
      Console.print("{Pair(1, "")}")
    }
    Console.print("{((P { ..(P { a: 4503599627370496, s: "two\nlines" }), s: "héllo" }) != (P { a: 1, s: "日本" }))}")
  }
}
