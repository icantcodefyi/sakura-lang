type P = { a: Int, s: String }
type Shape = Dot | Num(Int) | Pair(Int, String)
error Oops(code: Int)
error Bad
effect Counter { fn next() -> Int }
effect Acc {
  fn add(x: Int) -> Unit ! {Fail<Bad>}
  fn total() -> Int
}
fn counter(start: Int) -> Handler<Counter> { handler Counter { var n = start; fn next() { n = n + 1; n } } }
fn doubling() -> Handler<Counter, {Counter}> {
  handler Counter { var k = 0; fn next() { k = k + 1; Counter.next() * 2 + k } }
}
fn acc(limit: Int) -> Handler<Acc, {Console}> {
  handler Acc {
    var t = 0
    fn add(x) { if x > limit { fail Bad }; t = t + x; Console.print("add {x} = {t}") }
    fn total() { t }
  }
}
effect Around { fn around<e>(x: Int, body: fn(Int) -> Int ! e) -> Int ! e }
fn around() -> Handler<Around, {Console}> {
  handler Around {
    var calls = 0
    fn around(x, body) { calls = calls + 1; Console.print("around {x} #{calls}"); body(x + calls) }
  }
}
fn widen() -> Handler<Around, {Around}> { handler Around { fn around(x, body) { Around.around(x * 2, body) + 1 } } }
fn h0(p0: Int, p1: Int) -> String ! {Counter}
  requires ((3 * 6) % (p1 - 0) != 7) && false
  ensures (match Num(0) { Dot => ([(-7)] >= [(-4), (-2), (-6)]), Num(v1) => !(true), Pair(v1, v2) => false })
{ (match (P { ..({ var v3 = (P { a: 3, s: "two\nlines" }); v3.a = (-3); v3 }), a: p0 }) { P { a: 2, .. } => "<{6}>", P { a: v4, s: v5 } => List.join(List.map((with counter(10) { if true { return "日本" }; let v6 = (P { a: 2, s: "🦀" }); [1, (-10), 6] }), fn(v7) { ({ "日本" }) }), "x y") }) }
fn h1(p0: Bool, p1: String) -> Int
{ if List.all(List.map(List.enumerate((match [9] { [] => [(-9), 3], [v8] => [8], [v8, v10, ..] => [(-7), (-7), (-9)] })), fn(v11) { let v12 = v11.0; let v13 = v11.1; (match (P { a: 9, s: "日本" }) { P { a: 2, .. } => v13, P { a: v14, s: v15 } => v12 }) }), fn(v16) { if !((true || false)) { return false }; (([(-5)] >= [5]) != (match [(-4)] { [] => p0, [v17] => true, [v17, v19, ..] => false })) }) { return (((0 - 10) - List.len([(-3)])) + 8) }; ((match (P { a: 6, s: p1 }) { P { a: 0, .. } => (P { a: 2, s: "two\nlines" }), P { a: v20, s: v21 } => (match (P { a: 5, s: "sakura" }) { P { a: 1, .. } => (P { a: (-10), s: "sakura" }), P { a: v22, s: v23 } => (P { a: (-4), s: "日本" }) }) })).a }
fn h2(p0: P) -> String
  requires false
{ let v24 = List.range(0, 2); if (false || !(true)) { return ("héllo" + ("日本" + (match [(-8), (-5)] { [] => "🦀", [v25, ..v26] => "a" }))) }; ((({ var v27 = p0; v27.a = (-3); v27 })).s + "") }
pub fn main() -> Unit ! {Console} {
  Console.print("{Dot}")
  with around() {
    with counter((-3)) {
      Console.print("{(match (P { ..(P { a: 0, s: "日本" }), a: List.sum(List.slice([(-5), 7], (-8), 7)) }) { P { a: 2, .. } => false, P { a: v28, s: v29 } => false })}")
      Console.print("{h2((P { ..(P { ..(P { a: 2, s: "a" }), s: "héllo" }), a: (-6) }))}")
      Console.print("{((P { ..(P { ..({ Console.print("{(-8)}"); let v30 = (P { a: 3, s: "🦀" }); v30 }), a: Int.max(6, 8) }), a: 7 })).s}")
    }
    Console.print("{h1(({ Console.print("{true}"); List.any(List.range(0, 2), fn(v31) { var v32 = [4, 1]; var v33 = 0; while v33 < 2 { v33 = v33 + 1; Console.print("{(-7)}"); if true { continue }; v32 = List.push(v32, (-1)) }; false }) }), "<{(match (P { a: 7, s: "tab\t" }) { P { a: 1, .. } => 6, P { a: v34, s: v35 } => v34 })}>")}")
    let v36 = false
  }
  Console.print("{List.concat([10, (-8), (-9)], [(Int.min((-3), (-5)) + 3)])}")
  Console.print("{h2((P { ..(P { ..(P { a: (-2), s: "" }), a: 3 }), a: (match Num(6) { Dot => 9, Num(v37) => v37, Pair(v37, v38) => (-9) }) }))}")
}
