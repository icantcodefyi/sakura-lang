type P = { a: Int, s: String }
type Shape = Dot | Num(Int) | Pair(Int, String)
error Oops(code: Int)
error Bad
effect Counter { fn next() -> Int }
effect Acc {
  fn add(x: Int) -> Unit ! {Fail<Bad>}
  fn total() -> Int
}
fn counter(start: Int) -> Handler<Counter> { handler Counter { var n = start; fn next() { n = n + 1; n } } }
fn doubling() -> Handler<Counter, {Counter}> {
  handler Counter { var k = 0; fn next() { k = k + 1; Counter.next() * 2 + k } }
}
fn acc(limit: Int) -> Handler<Acc, {Console}> {
  handler Acc {
    var t = 0
    fn add(x) { if x > limit { fail Bad }; t = t + x; Console.print("add {x} = {t}") }
    fn total() { t }
  }
}
effect Around { fn around<e>(x: Int, body: fn(Int) -> Int ! e) -> Int ! e }
fn around() -> Handler<Around, {Console}> {
  handler Around {
    var calls = 0
    fn around(x, body) { calls = calls + 1; Console.print("around {x} #{calls}"); body(x + calls) }
  }
}
fn widen() -> Handler<Around, {Around}> { handler Around { fn around(x, body) { Around.around(x * 2, body) + 1 } } }
fn h0(p0: P) -> P ! {Counter, Fail<Oops | Bad>}
{ var v1 = (match Dot { Dot => 3, Num(v2) => 1, Pair(v2, v3) => (match (try { if true { fail Bad }; [5, 4503599627370496] } catch { Bad => [7, (-7), (-10)] }) { [] => List.sum([7]), [v4] => Int.abs(v4), [v4, v6, ..] => (with counter(10), doubling() { if false { return p0 }; v6 }) }) }); for v7 in 0..4 { v1 = v1 + (match (if false { [(-8), 2, 2] } else { List.filter_map(List.range(0, 0), fn(v8) { if false { Some(0) } else { None } }) }) { [] => Counter.next(), [v9, ..v10] => (-10) }) }; (with doubling() { if ({ !(false) }) { return p0 }; (P { ..(try { if false { fail Bad }; var v11 = "x y"; for v12 in -1..1 { if true { return p0 }; v11 = v11 + "a" }; if true { return p0 }; (P { a: (-3), s: "tab\t" }) } catch { Bad => p0 }), s: List.join(List.map([(-5), 5], fn(v13) { var v14 = "two\nlines"; for v15 in -2..4 { let v16 = 2; v14 = v14 + "a" }; v14 }), "sakura") }) }) }
fn h1(p0: Int, p1: Int) -> P ! {Console}
{ (P { a: (-2), s: "two\nlines" }) }
pub fn main() -> Unit ! {Console} {
  with acc(7) {
    Console.print("{(with counter(4503599627370496) { (P { ..(P { ..(P { ..(P { a: 1, s: "two\nlines" }), a: (-6) }), s: ((P { a: (-6), s: "日本" })).s }), a: Counter.next() }) })}")
  }
  Console.print("{h1(1, (-8))}")
}
