type P = { a: Int, s: String }
type Shape = Dot | Num(Int) | Pair(Int, String)
error Oops(code: Int)
error Bad
effect Counter { fn next() -> Int }
effect Acc {
  fn add(x: Int) -> Unit ! {Fail<Bad>}
  fn total() -> Int
}
fn counter(start: Int) -> Handler<Counter> { handler Counter { var n = start; fn next() { n = n + 1; n } } }
fn doubling() -> Handler<Counter, {Counter}> {
  handler Counter { var k = 0; fn next() { k = k + 1; Counter.next() * 2 + k } }
}
fn acc(limit: Int) -> Handler<Acc, {Console}> {
  handler Acc {
    var t = 0
    fn add(x) { if x > limit { fail Bad }; t = t + x; Console.print("add {x} = {t}") }
    fn total() { t }
  }
}
effect Around { fn around<e>(x: Int, body: fn(Int) -> Int ! e) -> Int ! e }
fn around() -> Handler<Around, {Console}> {
  handler Around {
    var calls = 0
    fn around(x, body) { calls = calls + 1; Console.print("around {x} #{calls}"); body(x + calls) }
  }
}
fn widen() -> Handler<Around, {Around}> { handler Around { fn around(x, body) { Around.around(x * 2, body) + 1 } } }
fn h0(p0: Int) -> Int ! {Console}
{ Console.print("{true}"); let v1 = String.len("x y"); p0 }
fn h1(p0: Int, p1: Int) -> Int ! {Fail<Oops | Bad>}
{ (-1) }
fn h2(p0: Int, p1: Int) -> Int ! {Fail<Oops | Bad>}
{ Int.min(List.len(List.range(2, 0)), (-1)) }
pub fn main() -> Unit ! {Console} {
  with around() {
    Console.print("{(P { a: Around.around(8, fn(v2) { let v5 = (if ({ let v3 = v2; let v4 = false; v4 }) { ([(-1), 6] == [(-5), (-9)]) } else { ("x y" != "日本") }); var v6 = "<{(with counter((-7)) { v2 })}>"; for v7 in -1..1 { Console.print("{(-1)}"); v6 = v6 + (match List.get((match String.parse_int("42") { Some(v8) => [10, (-5), 4], None => [(-7), (-6), 6] }), ((-1) / (-3))) { Some(v9) => ((P { a: 7, s: "héllo" })).s, None => v6 }) }; (h0(v2) * Int.max(v2, (-6))) }), s: "back\\slash" })}")
    Console.print("{(P { ..(P { a: Around.around((-5), fn(v10) { if false { return v10 }; v10 }), s: ((P { a: 7, s: "sakura" })).s }), s: "héllo" })}")
  }
  Console.print("{h0(({ let v11 = Num(5); let v12 = ([7] >= List.range(0, 2)); List.len([8, (-2), 1]) }))}")
  with counter((-9)) {
    Console.print("{(try { h2((List.len([2]) / 8), Counter.next()) })}")
    with counter((-10)) {
      Console.print("{(try { Console.print("{List.sort_by([(-6), 8], fn(v13) { (2 % (try { if false { fail Oops { code: v13 } }; let v14 = Num((-4)); let v15 = Num((-4)); v13 } catch { Oops { code: v16 } => (-5) })) })}"); if ((P { a: (-3), s: "sakura" }) == (P { a: (if false { fail Oops { code: 2 } } else { 0 }), s: ("tab\t" + "") })) { fail Bad }; [(match Num(10) { Dot => Counter.next(), Num(v17) => (-1), Pair(v17, v18) => (v17 + v17) }), 0, (-4)] } catch { Oops { code: v19 } => List.concat(List.range(0, 0), List.map((if true { [6, 9] } else { List.range(0, 3) }), fn(v20) { Console.print("{(if false { [7] } else { [7, 8] })}"); Console.print("{List.range(0, 1)}"); (match [(-4)] { [] => v19, [v21] => v20, [v21, v23, ..] => 7 }) })), Bad => [(-7)] })}")
    }
    Console.print("{h0((if false { (7 - 4) } else { ((-3) % 6) }))}")
  }
  Console.print("{[({ let v25 = List.map([(-8), 5], fn(v24) { List.sum([8, 8]) }); (with acc(4) { Console.print("{false}"); Console.print("{("x y" + "tab\t")}"); h0((-5)) }) })]}")
}
