type P = { a: Int, s: String }
type Shape = Dot | Num(Int) | Pair(Int, String)
error Oops(code: Int)
error Bad
effect Counter { fn next() -> Int }
effect Acc {
  fn add(x: Int) -> Unit ! {Fail<Bad>}
  fn total() -> Int
}
fn counter(start: Int) -> Handler<Counter> { handler Counter { var n = start; fn next() { n = n + 1; n } } }
fn doubling() -> Handler<Counter, {Counter}> {
  handler Counter { var k = 0; fn next() { k = k + 1; Counter.next() * 2 + k } }
}
fn acc(limit: Int) -> Handler<Acc, {Console}> {
  handler Acc {
    var t = 0
    fn add(x) { if x > limit { fail Bad }; t = t + x; Console.print("add {x} = {t}") }
    fn total() { t }
  }
}
effect Around { fn around<e>(x: Int, body: fn(Int) -> Int ! e) -> Int ! e }
fn around() -> Handler<Around, {Console}> {
  handler Around {
    var calls = 0
    fn around(x, body) { calls = calls + 1; Console.print("around {x} #{calls}"); body(x + calls) }
  }
}
fn widen() -> Handler<Around, {Around}> { handler Around { fn around(x, body) { Around.around(x * 2, body) + 1 } } }
fn h0(p0: Int) -> Bool ! {Console}
{ var v1 = Int.abs(3); for v2 in -1..4 { if (List.filter_map(List.sort_by([6], fn(v3) { (-1) }), fn(v4) { if ([(-2), 10] < [(-3)]) { Some(v1) } else { None } }) < List.range(0, 5)) { return (false && (List.len(List.range(0, 2)) < (-4))) }; v1 = v1 + (({ let v5 = Num(v1); 4503599627370496 }) / 4) }; false }
fn h1(p0: Int, p1: Int) -> List<Int> ! {Fail<Oops | Bad>}
  requires (10 % (p0 - 0) != 7) && true
{ if ((List.sum(List.range(0, 0)) > String.len("🦀")) == true) { return [(try { if (false || false) { fail Bad }; let v8 = (match (P { a: 0, s: "q\"" }) { P { a: 1, .. } => [5, (-1), (-9)], P { a: v6, s: v7 } => List.range(0, 1) }); (p0 - p0) } catch { Bad => (match ([(-8), 6, (-7)])[p1] { Some(v9) => p0, None => 8 }) }), (-3)] }; let v10 = 0; [(-3)] }
pub fn main() -> Unit ! {Console} {
  with counter(6) {
    Console.print("{((Counter.next() - (match (P { ..(P { a: 9, s: "a" }), a: (-6) }) { P { a: 1, .. } => 4, P { a: v11, s: v12 } => 4 })) * Counter.next())}")
    Console.print("{h0((match (with around() { Dot }) { Dot => List.sum([(-7), 10]), Num(v13) => v13, Pair(v13, v14) => Int.min(v13, v13) }))}")
  }
  let v15 = (P { a: (-5), s: "x y" })
  Console.print("{!((((match List.range(0, 1) { [] => (-1), [v16] => (-8), [v16, v18, ..] => 4503599627370496 }) > Int.abs(3)) && ((match List.last(List.range(0, 0)) { Some(v19) => 9, None => 3 }) != 3)))}")
  Console.print("{h0(((-4) / (try { if true { fail Oops { code: (-9) } }; (-9) } catch { Oops { code: v20 } => 4 })))}")
}
