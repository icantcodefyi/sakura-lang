type P = { a: Int, s: String }
type Shape = Dot | Num(Int) | Pair(Int, String)
error Oops(code: Int)
error Bad
effect Counter { fn next() -> Int }
effect Acc {
  fn add(x: Int) -> Unit ! {Fail<Bad>}
  fn total() -> Int
}
fn counter(start: Int) -> Handler<Counter> { handler Counter { var n = start; fn next() { n = n + 1; n } } }
fn doubling() -> Handler<Counter, {Counter}> {
  handler Counter { var k = 0; fn next() { k = k + 1; Counter.next() * 2 + k } }
}
fn acc(limit: Int) -> Handler<Acc, {Console}> {
  handler Acc {
    var t = 0
    fn add(x) { if x > limit { fail Bad }; t = t + x; Console.print("add {x} = {t}") }
    fn total() { t }
  }
}
effect Around { fn around<e>(x: Int, body: fn(Int) -> Int ! e) -> Int ! e }
fn around() -> Handler<Around, {Console}> {
  handler Around {
    var calls = 0
    fn around(x, body) { calls = calls + 1; Console.print("around {x} #{calls}"); body(x + calls) }
  }
}
fn widen() -> Handler<Around, {Around}> { handler Around { fn around(x, body) { Around.around(x * 2, body) + 1 } } }
fn h0(p0: Int, p1: P) -> Int
{ if true { return (-9) }; let v6 = [String.len((p1).s), (-2), List.fold((try { if true { fail Oops { code: p0 } }; [(-6), 2, 4] } catch { Oops { code: v1 } => List.range(0, 3) }), List.len(List.range(0, 0)), fn(v2, v3) { if false { return String.len("tab\t") }; let v5 = (try { if false { fail Bad }; let v4 = [(-10)]; p1 } catch { Bad => p1 }); (v2 * (-5)) })]; (({ var v7 = ("a" + "tab\t"); for v8 in v6 { if (true == false) { continue }; v7 = v7 + (try { if false { fail Oops { code: (-3) } }; "q\"" } catch { Oops { code: v9 } => "sakura" }) }; let v10 = v6; (P { a: p0, s: "héllo" }) })).a }
fn h1(p0: Int, p1: Int) -> Int ! {Console}
  requires true
{ Console.print("{(9 / (match ((try { if true { fail Oops { code: p1 } }; let v11 = "a"; List.range(0, 3) } catch { Oops { code: v12 } => [3, (-4)] }))[List.fold([(-10), 3, 4503599627370496], p0, fn(v13, v14) { if false { return v13 }; let v15 = (P { a: (-5), s: "x y" }); (-10) })] { Some(v16) => 3, None => List.fold([8, 7], p1, fn(v17, v18) { var v19 = 1; var v20 = 0; while v20 < 1 { v20 = v20 + 1; let v21 = Pair((-3), "héllo"); Console.print("{(P { a: (-5), s: "日本" })}"); v19 = v19 + (-5) }; var v22 = List.range(0, 2); for v23 in -1..3 { v22 = List.push(v22, v17) }; 2 }) }))}"); let v29 = (String.len((match Dot { Dot => "", Num(v24) => "x y", Pair(v24, v25) => v25 })) <= List.fold(List.flat_map([0], fn(v26) { Console.print("{false}"); [4503599627370496, (-8), (-2)] }), (-5), fn(v27, v28) { (-7) })); ((-5) / (Int.abs(4503599627370496) + 1)) }
fn h2(p0: Int, p1: Bool) -> Int
{ var v30 = p0; for v31 in 0..2 { if (try { if (match List.last((match List.get(List.range(0, 2), p0) { Some(v32) => [(-3), 8], None => List.range(0, 1) })) { Some(v33) => true, None => (with counter(6) { var v34 = 4; for v35 in List.range(0, 3) { let v36 = p1; v34 = v34 + (-7) }; if p1 { return 3 }; true }) }) { fail Oops { code: String.len((try { if false { fail Oops { code: v30 } }; let v37 = p1; var v38 = "back\\slash"; var v39 = 0; while v39 < 0 { v39 = v39 + 1; v38 = v38 + v38 }; "q\"" } catch { Oops { code: v40 } => "back\\slash" })) } }; true } catch { Oops { code: v41 } => (List.sum(List.range(0, 2)) == String.len("🦀")) }) { return (-3) }; v30 = v30 + 10 }; var v42 = v30; for v43 in 2..1 { var v44 = "{(try { ((P { ..(P { a: (-3), s: "日本" }), a: 5 })).a })}"; for v45 in 1..3 { if p1 { continue }; v44 = v44 + (((if p1 { v44 } else { v44 }) + ((P { a: (-4), s: "日本" })).s) + (match List.range(-1, 0) { [] => v44, [v46] => (v44 + v44), [v46, v48, ..] => (try { if true { fail Bad }; v44 } catch { Bad => "two\nlines" }) })) }; v42 = v42 + (-5) }; (({ let v51 = (match (P { a: 8, s: "héllo" }) { P { a: 2, .. } => v30, P { a: v49, s: v50 } => 3 }); let v52 = (P { ..(P { a: (-8), s: "héllo" }), a: v30 }); (with counter((-9)), doubling() { v51 }) }) % (try { if (if p1 { p1 } else { false }) { fail Oops { code: Int.min(v42, v42) } }; (p0 * v30) } catch { Oops { code: v53 } => ((-9) + (-6)) })) }
pub fn main() -> Unit ! {Console} {
  Console.print("{h1(10, (-6))}")
  Console.print("{(with acc(0) { Console.print("{(-4)}"); "a" })}")
  with acc(2) {
    with counter(5) {
      Console.print("{true}")
      Console.print("{"{(try { Console.print("{Dot}"); Acc.add(((P { a: 4503599627370496, s: "x y" })).a); !(false) })}"}")
      Console.print("{Int.max(((P { ..(match Dot { Dot => (P { a: (-9), s: "🦀" }), Num(v54) if true => (P { a: (-3), s: "日本" }), Num(v54) => (P { a: 3, s: "x y" }), Pair(v54, v55) => (P { a: 4503599627370496, s: "q\"" }) }), s: "{"back\\slash"}" })).a, (({ let v56 = List.range(0, 1); ((P { a: (-10), s: "héllo" })).a }) - (({ var v57 = (P { a: (-6), s: "two\nlines" }); v57.a = (-1); v57 })).a))}")
    }
    with counter((-4)) {
      Console.print("{h0((match (with counter((-1)) { Dot }) { Dot => (-1), Num(v58) => 2, Pair(v58, v59) => ((P { a: 2, s: "tab\t" })).a }), (P { a: (-8), s: "" }))}")
      Console.print("{h2(((-4) - (with counter(9) { 4 })), ((match (P { a: (-5), s: "two\nlines" }) { P { a: 2, .. } => true, P { a: v60, s: v61 } => true }) && (false != false)))}")
    }
  }
}
