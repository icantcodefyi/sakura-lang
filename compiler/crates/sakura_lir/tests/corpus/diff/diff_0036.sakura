type P = { a: Int, s: String }
type Shape = Dot | Num(Int) | Pair(Int, String)
error Oops(code: Int)
error Bad
effect Counter { fn next() -> Int }
effect Acc {
  fn add(x: Int) -> Unit ! {Fail<Bad>}
  fn total() -> Int
}
fn counter(start: Int) -> Handler<Counter> { handler Counter { var n = start; fn next() { n = n + 1; n } } }
fn doubling() -> Handler<Counter, {Counter}> {
  handler Counter { var k = 0; fn next() { k = k + 1; Counter.next() * 2 + k } }
}
fn acc(limit: Int) -> Handler<Acc, {Console}> {
  handler Acc {
    var t = 0
    fn add(x) { if x > limit { fail Bad }; t = t + x; Console.print("add {x} = {t}") }
    fn total() { t }
  }
}
effect Around { fn around<e>(x: Int, body: fn(Int) -> Int ! e) -> Int ! e }
fn around() -> Handler<Around, {Console}> {
  handler Around {
    var calls = 0
    fn around(x, body) { calls = calls + 1; Console.print("around {x} #{calls}"); body(x + calls) }
  }
}
fn widen() -> Handler<Around, {Around}> { handler Around { fn around(x, body) { Around.around(x * 2, body) + 1 } } }
fn h0(p0: String, p1: Int) -> Int
  ensures !(false)
{ String.len(p0) }
fn h1(p0: Int) -> Int ! {Console, Fail<Oops | Bad>}
  requires ((p0 / 6) % (p0 - 0) != 7) && List.all((match Dot { Dot => [10, 0, 3], Num(v1) if false => [(-5), 4], Num(v1) => [1, 10], Pair(v1, v2) => List.range(0, 1) }), fn(v3) { (true || true) })
  ensures ((if true { false } else { false }) != true)
{ let v5 = Pair((-5), "{List.all(List.range(0, 3), fn(v4) { true })}"); p0 }
fn h2(p0: Int) -> Int
{ (with counter((-4)) { if List.contains(List.range(2, 0), Int.max(p0, p0)) { return ({ Counter.next() }) }; let v7 = (with counter(4) { if (match List.last([10, (-5), 3]) { Some(v6) => false, None => true }) { return ((-1) * p0) }; if false { return (7 * 2) }; Num(p0) }); List.len(List.unique(List.range(0, 1))) }) }
pub fn main() -> Unit ! {Console} {
  Console.print("{h2((List.len([7, (-7), 7]) + ((-1) % 6)))}")
}
