type P = { a: Int, s: String }
type Shape = Dot | Num(Int) | Pair(Int, String)
error Oops(code: Int)
error Bad
effect Counter { fn next() -> Int }
effect Acc {
  fn add(x: Int) -> Unit ! {Fail<Bad>}
  fn total() -> Int
}
fn counter(start: Int) -> Handler<Counter> { handler Counter { var n = start; fn next() { n = n + 1; n } } }
fn doubling() -> Handler<Counter, {Counter}> {
  handler Counter { var k = 0; fn next() { k = k + 1; Counter.next() * 2 + k } }
}
fn acc(limit: Int) -> Handler<Acc, {Console}> {
  handler Acc {
    var t = 0
    fn add(x) { if x > limit { fail Bad }; t = t + x; Console.print("add {x} = {t}") }
    fn total() { t }
  }
}
effect Around { fn around<e>(x: Int, body: fn(Int) -> Int ! e) -> Int ! e }
fn around() -> Handler<Around, {Console}> {
  handler Around {
    var calls = 0
    fn around(x, body) { calls = calls + 1; Console.print("around {x} #{calls}"); body(x + calls) }
  }
}
fn widen() -> Handler<Around, {Around}> { handler Around { fn around(x, body) { Around.around(x * 2, body) + 1 } } }
pub fn main() -> Unit ! {Console} {
  Console.print("{Dot}")
  Console.print("{({ let v1 = "{((3 % (-2)) != ((P { a: 0, s: "back\\slash" })).a)}"; var v2 = [(-6)]; for v3 in 1..4 { v2 = List.push(v2, (10 * (match (({ var v4 = (-6); for v5 in -1..1 { var v6 = 0; var v7 = 0; while v7 < 3 { v7 = v7 + 1; Console.print("{Dot}"); v6 = v6 + (-8) }; v4 = v4 + v5 }; var v8 = v4; var v9 = 0; while v9 < 0 { v9 = v9 + 1; if true { break }; v8 = v8 + 3 }; v2 }))[String.len("日本")] { Some(v10) => (with around() { 9 }), None => List.len([5]) }))) }; (P { ..(P { ..(P { ..(P { a: 7, s: "sakura" }), a: 9 }), a: (with acc(8) { 2 }) }), a: List.len((match (P { a: (-8), s: "héllo" }) { P { a: 2, .. } => [9, 3], P { a: v11, s: v12 } => List.range(0, 0) })) }) })}")
  Console.print("{List.filter_map(List.sort_by(List.filter_map(List.range(-1, 3), fn(v13) { if (try { if false { fail Oops { code: 1 } }; Console.print("{false}"); Console.print("{(P { a: 3, s: "a" })}"); false } catch { Oops { code: v14 } => false }) { Some(Int.max(v13, 2)) } else { None } }), fn(v15) { (try { if (v15 <= (-9)) { fail Oops { code: (-3) } }; List.sum([(-2), (-8), (-7)]) } catch { Oops { code: v16 } => (-2) }) }), fn(v17) { if ({ (List.sum([5]) == ((-9) + v17)) }) { Some((v17 - (if ([4503599627370496, (-10), 1] >= [9]) { (1 / 10) } else { (match List.range(0, 3) { [] => 0, [v18] => v18, [v18, v20, ..] => 9 }) }))) } else { None } })}")
}
