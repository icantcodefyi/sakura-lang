type P = { a: Int, s: String }
type Shape = Dot | Num(Int) | Pair(Int, String)
error Oops(code: Int)
error Bad
effect Counter { fn next() -> Int }
effect Acc {
  fn add(x: Int) -> Unit ! {Fail<Bad>}
  fn total() -> Int
}
fn counter(start: Int) -> Handler<Counter> { handler Counter { var n = start; fn next() { n = n + 1; n } } }
fn doubling() -> Handler<Counter, {Counter}> {
  handler Counter { var k = 0; fn next() { k = k + 1; Counter.next() * 2 + k } }
}
fn acc(limit: Int) -> Handler<Acc, {Console}> {
  handler Acc {
    var t = 0
    fn add(x) { if x > limit { fail Bad }; t = t + x; Console.print("add {x} = {t}") }
    fn total() { t }
  }
}
effect Around { fn around<e>(x: Int, body: fn(Int) -> Int ! e) -> Int ! e }
fn around() -> Handler<Around, {Console}> {
  handler Around {
    var calls = 0
    fn around(x, body) { calls = calls + 1; Console.print("around {x} #{calls}"); body(x + calls) }
  }
}
fn widen() -> Handler<Around, {Around}> { handler Around { fn around(x, body) { Around.around(x * 2, body) + 1 } } }
pub fn main() -> Unit ! {Console} {
  Console.print("{Pair(List.len(List.sort_by(List.range(0, 0), fn(v1) { Int.max(v1, v1) })), (if (match (with acc(2) { Console.print("{Num((-7))}"); Num((-9)) }) { Dot => true, Num(v2) if false => true, Num(v2) => false, Pair(v2, v3) => false }) { (match List.last((match List.range(0, 0) { [] => List.range(0, 3), [v4] => [8], [v4, v6, ..] => [(-4), 9] })) { Some(v7) => "q\"", None => ((P { a: 3, s: "sakura" })).s }) } else { (if true { (match Dot { Dot => "a", Num(v8) => "two\nlines", Pair(v8, v9) => "a" }) } else { (match (P { a: 8, s: "日本" }) { P { a: 2, .. } => "🦀", P { a: v10, s: v11 } => "tab\t" }) }) }))}")
  Console.print("{List.map(List.enumerate(List.map([6], fn(v12) { if List.any(List.range(-2, 4), fn(v13) { Console.print("{List.range(2, 2)}"); true }) { return ((v12 * 4) + (4503599627370496 - 4503599627370496)) }; let v14 = (P { ..(P { a: 8, s: "two\nlines" }), s: ("back\\slash" + "q\"") }); List.sum([3]) })), fn(v15) { let v16 = v15.0; let v17 = v15.1; (-4) })}")
  let v22 = (if true { (match (try { if false { fail Bad }; [3, 2, (-2)] } catch { Bad => [0, 8, 0] }) { [] => "héllo", [v18, ..v19] => (match (P { a: 9, s: "héllo" }) { P { a: 2, .. } => "tab\t", P { a: v20, s: v21 } => "" }) }) } else { "sakura" })
}
