expression: "check(&\n[(\"main\",\nr#\"\ntype P = { x: Int, y: Int }\nfn f(xs: List<Int>, p: P, o: Option<(Int, String)>) -> Int {\n  let total = match xs {\n    [] => 0,\n    [x] => x,\n    [first, second, ..rest] => first + second,\n  }\n  let P { x, .. } = p\n  match o {\n    Some((1 | 2, \"a\")) => -1,\n    Some((n, _)) => n,\n    None => x + total,\n  }\n}\nfn neg(n: Int) -> Bool { match n { -5 => true, _ => false } }\n\"#)])"
