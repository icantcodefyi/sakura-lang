// §17.165, §17.182 (3): a call to a declared function names it as written (`List.map`, or `fold`
// when imported bare), its home module and both counts.
import std/env
import std/list.{fold}

pub fn home() -> Option<String> ! {Env} { Env.get("A", "B") }

pub fn doubled() -> List<Int> { List.map([1, 2]) }

pub fn total() -> Int { fold([1, 2], 0) }
