// milestone: M3
// expect: V2032
// spec: RFC 0002 §2.9 ("`Secret` and `CryptoKey` cannot cross because they are not `Schema`"); plan web-apis.md phase 11
// Spec: https://html.spec.whatwg.org/multipage/structured-data.html#structuredserializeinternal

// A worker's messages cross through the `Schema` codec, which `Secret` does not have, so a
// worker whose inbox carries a `Secret` cannot be spawned: the secret never leaves its instance.
import std/worker.{Grants, Inbox, Outbox, Worker}

@worker
fn holder(_inbox: Inbox<Secret<String>>, _outbox: Outbox<Int>) -> Unit ! {Worker} {}

pub fn run() -> Unit ! {Worker} { let _ = Worker.spawn(holder, Grants.none(), fn(_w) { 1 }) }
