// milestone: M3
// expect: V1002 V1002 V1002
// §17.182 (2), §17.187: no std/list function is a near spelling of `count` or `size`, a prefix of
// either or an extension of either, so nothing is guessed (the std name is `len`); `slice`, two
// edits from `size`, is not offered. `map_e` has a prefix match on each side (`map`, `map_err`),
// so it gets none either.
import std/list
import std/result

pub fn count() -> Int { List.count([1]) }

pub fn size() -> Int { List.size([1]) }

pub fn mapped() -> Result<Int, String> { Result.map_e(Ok(1), fn(e) { e }) }
