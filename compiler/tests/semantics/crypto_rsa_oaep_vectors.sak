// milestone: M3
// spec: RFC 0002 §2.7
// Spec: https://www.rfc-editor.org/rfc/rfc8017#section-7.1

// RSA-OAEP (RFC 8017 §7.1, JOSE's RSA-OAEP-256: MGF1 of the same hash) with Project Wycheproof's
// 2048-bit private keys (`tests/vectors/rsa_oaep.txt`): two valid tests of each hash decrypt to the
// table's message under its label, and two invalid ones are `Padding`. `encrypt` takes the seed as
// its nonce (the hash's length), so a ciphertext is a function of its inputs: under the
// RSASSA-PKCS1-v1_5 table's first key, imported for RSA-OAEP, the same seed gives the same 256 bytes
// and another seed others, each decrypting back; another label is `Padding`, a plaintext over 190
// bytes (2,048 bits less two SHA-256 lengths and 2 bytes) is `Length`, a 31-byte seed is
// `Nonce(31)`, and decrypting with a seed is `Nonce(32)`.
// On native, which has no tier 2, `import_key` answers `Unavailable("RSA-OAEP")` (`.native.stdout`, RFC 0002 §2.7's declared difference). Generated from the tables.
import std/crypto
import std/crypto.{Algorithm, Digest, KeyFormat, Usage}

pub fn main() -> Unit ! {Console} {
  for (hash, id, result, pkcs8, label, message, ciphertext) in [
    (
      "Sha256",
      1,
      "valid",
      "",
      "",
      "",
      "",
    ),
    (
      "Sha256",
      2,
      "valid",
      "",
      "",
      "0000000000000000000000000000000000000000",
      "",
    ),
    (
      "Sha256",
      12,
      "invalid",
      "",
      "",
      "313233343030",
      "",
    ),
    (
      "Sha256",
      13,
      "invalid",
      "",
      "",
      "313233343030",
      "",
    ),
    (
      "Sha384",
      1,
      "valid",
      "",
      "",
      "",
      "",
    ),
    (
      "Sha384",
      2,
      "valid",
      "",
      "",
      "0000000000000000000000000000000000000000",
      "",
    ),
    (
      "Sha384",
      12,
      "invalid",
      "",
      "",
      "313233343030",
      "",
    ),
    (
      "Sha384",
      13,
      "invalid",
      "",
      "",
      "313233343030",
      "",
    ),
    (
      "Sha512",
      1,
      "valid",
      "",
      "",
      "",
      "",
    ),
    (
      "Sha512",
      2,
      "valid",
      "",
      "",
      "0000000000000000000000000000000000000000",
      "",
    ),
    (
      "Sha512",
      12,
      "invalid",
      "",
      "",
      "313233343030",
      "",
    ),
    (
      "Sha512",
      13,
      "invalid",
      "",
      "",
      "313233343030",
      "",
    ),
  ] {
    let alg = Algorithm.RsaOaep(digest(hash))
    match crypto.import_key(KeyFormat.Pkcs8, alg, [Usage.Decrypt], false, Secret.of(unhex(pkcs8))) {
      Ok(k) => {
        let opened = crypto.decrypt(k, Bytes.from_list([]), unhex(label), unhex(ciphertext))
        Console.print("{hash} tcId {id} {result} {opened.map(hex)} {opened == Ok(unhex(message))}")
      },
      Err(e) => Console.print("{hash} tcId {id} {e}"),
    }
  }
  let alg = Algorithm.RsaOaep(Digest.Sha256)
  let private = crypto.import_key(
    KeyFormat.Pkcs8,
    alg,
    [Usage.Decrypt],
    false,
    Secret.of(
      unhex(
        "",
      ),
    ),
  )
  let public = crypto.import_key(
    KeyFormat.Spki,
    alg,
    [Usage.Encrypt],
    true,
    Secret.of(
      unhex(
        "",
      ),
    ),
  )
  match (private, public) {
    (Ok(k), Ok(p)) => {
      let none = Bytes.from_list([])
      let seed = String.to_bytes("a seed of thirty-two bytes, once")
      let label = String.to_bytes("label")
      let msg = String.to_bytes("sealed for the private key")
      let a = crypto.encrypt(p, seed, label, msg)
      let b = crypto.encrypt(p, seed, label, msg)
      let c = crypto.encrypt(p, String.to_bytes("another seed of thirty-two bytes"), label, msg)
      Console.print("own {a.map(Bytes.len)} same seed {a == b} other seed {a != c}")
      match (a, c) {
        (Ok(a), Ok(c)) => {
          Console.print(
            "opens {crypto.decrypt(k, none, label, a) == Ok(msg)} {crypto.decrypt(k, none, label, c) == Ok(msg)}",
          )
          Console.print("other label {crypto.decrypt(k, none, String.to_bytes("lab"), a)}")
          Console.print("with a seed {crypto.decrypt(k, seed, label, a)}")
          Console.print("cut {crypto.decrypt(k, none, label, Bytes.slice(a, 1, 256))}")
        },
        _ => Console.print("own does not seal"),
      }
      let long = Bytes.from_list(List.map(List.range(0, 191), fn(i) { i % 256 }))
      Console.print(
        "190 bytes {crypto.encrypt(p, seed, none, Bytes.slice(long, 0, 190)).map(Bytes.len)}",
      )
      Console.print("191 bytes {crypto.encrypt(p, seed, none, long)}")
      Console.print("seed 31 {crypto.encrypt(p, Bytes.slice(seed, 0, 31), none, msg)}")
    },
    (Err(e), _) => Console.print("own {e}"),
    (_, Err(e)) => Console.print("own {e}"),
  }
}

fn digest(name: String) -> Digest {
  match name {
    "Sha256" => Digest.Sha256,
    "Sha384" => Digest.Sha384,
    _ => Digest.Sha512,
  }
}

fn hex(b: Bytes) -> String {
  let digits = "0123456789abcdef"
  var out = ""
  for i in 0..Bytes.len(b) {
    let x = Bytes.get(b, i).unwrap_or(0)
    out = out + String.slice(digits, x / 16, x / 16 + 1) + String.slice(digits, x % 16, x % 16 + 1)
  }
  out
}

fn unhex(s: String) -> Bytes {
  var out: List<Int> = []
  for i in 0..String.len(s) / 2 {
    out = out.push(
      nibble(String.slice(s, 2 * i, 2 * i + 1)) * 16
        + nibble(String.slice(s, 2 * i + 1, 2 * i + 2)),
    )
  }
  Bytes.from_list(out)
}

fn nibble(c: String) -> Int {
  var v = 0
  for d in 0..16 { if String.slice("0123456789abcdef", d, d + 1) == c { v = d } }
  v
}

/// `b` with bit 4 of byte `at` flipped.
fn flip(b: Bytes, at: Int) -> Bytes {
  let x = Bytes.get(b, at).unwrap_or(0)
  let y = if x / 16 % 2 == 1 { x - 16 } else { x + 16 }
  Bytes.concat([Bytes.slice(b, 0, at), Bytes.from_list([y]), Bytes.slice(b, at + 1, Bytes.len(b))])
}
