// milestone: M3
// spec: RFC 0002 §2.7
// Spec: https://www.rfc-editor.org/rfc/rfc8017#section-8.1

// RSA-PSS (RFC 8017 §8.1, JOSE's PS256, PS384 and PS512: MGF1 of the same hash and a salt of the
// hash's length) with Project Wycheproof's public keys (`tests/vectors/rsa_pss.txt`): two valid and
// two invalid tests of each key, `verify` answering what the table says. PSS salts at random, so a
// signature `sign` writes (under the RSASSA-PKCS1-v1_5 table's first key, imported for RSA-PSS)
// verifies but is not compared or printed; other data and a flipped bit do not verify.
// On native, which has no tier 2, `import_key` answers `Unavailable("RSA-PSS")` (`.native.stdout`, RFC 0002 §2.7's declared difference). Generated from the tables.
import std/crypto
import std/crypto.{Algorithm, Digest, KeyFormat, Usage}

pub fn main() -> Unit ! {Console} {
  for (hash, id, result, spki, data, signature) in [
    (
      "Sha256",
      1,
      "valid",
      "",
      "",
      "",
    ),
    (
      "Sha256",
      2,
      "valid",
      "",
      "0000000000000000000000000000000000000000",
      "",
    ),
    (
      "Sha256",
      62,
      "invalid",
      "",
      "313233343030",
      "",
    ),
    (
      "Sha256",
      63,
      "invalid",
      "",
      "313233343030",
      "",
    ),
    (
      "Sha384",
      1,
      "valid",
      "",
      "",
      "",
    ),
    (
      "Sha384",
      2,
      "valid",
      "",
      "0000000000000000000000000000000000000000",
      "",
    ),
    (
      "Sha384",
      94,
      "invalid",
      "",
      "313233343030",
      "",
    ),
    (
      "Sha384",
      95,
      "invalid",
      "",
      "313233343030",
      "",
    ),
    (
      "Sha512",
      1,
      "valid",
      "",
      "",
      "",
    ),
    (
      "Sha512",
      2,
      "valid",
      "",
      "0000000000000000000000000000000000000000",
      "",
    ),
    (
      "Sha512",
      131,
      "invalid",
      "",
      "313233343030",
      "",
    ),
    (
      "Sha512",
      132,
      "invalid",
      "",
      "313233343030",
      "",
    ),
  ] {
    let alg = Algorithm.RsaPss(digest(hash))
    match crypto.import_key(KeyFormat.Spki, alg, [Usage.Verify], true, Secret.of(unhex(spki))) {
      Ok(p) => Console.print("{hash} tcId {id} {result} {p.verify(unhex(signature), unhex(data))}"),
      Err(e) => Console.print("{hash} tcId {id} {e}"),
    }
  }
  let alg = Algorithm.RsaPss(Digest.Sha256)
  let private = crypto.import_key(
    KeyFormat.Pkcs8,
    alg,
    [Usage.Sign],
    false,
    Secret.of(
      unhex(
        "",
      ),
    ),
  )
  let public = crypto.import_key(
    KeyFormat.Spki,
    alg,
    [Usage.Verify],
    true,
    Secret.of(
      unhex(
        "",
      ),
    ),
  )
  match (private, public) {
    (Ok(k), Ok(p)) => {
      let msg = String.to_bytes("salted")
      let mine = with Random.seeded(0) { crypto.sign(k, msg) }
      Console.print(
        "own {Bytes.len(mine)} {p.verify(mine, msg)} other {p.verify(mine, String.to_bytes("other"))} flipped {p.verify(flip(mine, 9), msg)}",
      )
    },
    (Err(e), _) => Console.print("own {e}"),
    (_, Err(e)) => Console.print("own {e}"),
  }
}

fn digest(name: String) -> Digest {
  match name {
    "Sha256" => Digest.Sha256,
    "Sha384" => Digest.Sha384,
    _ => Digest.Sha512,
  }
}

fn hex(b: Bytes) -> String {
  let digits = "0123456789abcdef"
  var out = ""
  for i in 0..Bytes.len(b) {
    let x = Bytes.get(b, i).unwrap_or(0)
    out = out + String.slice(digits, x / 16, x / 16 + 1) + String.slice(digits, x % 16, x % 16 + 1)
  }
  out
}

fn unhex(s: String) -> Bytes {
  var out: List<Int> = []
  for i in 0..String.len(s) / 2 {
    out = out.push(
      nibble(String.slice(s, 2 * i, 2 * i + 1)) * 16
        + nibble(String.slice(s, 2 * i + 1, 2 * i + 2)),
    )
  }
  Bytes.from_list(out)
}

fn nibble(c: String) -> Int {
  var v = 0
  for d in 0..16 { if String.slice("0123456789abcdef", d, d + 1) == c { v = d } }
  v
}

/// `b` with bit 4 of byte `at` flipped.
fn flip(b: Bytes, at: Int) -> Bytes {
  let x = Bytes.get(b, at).unwrap_or(0)
  let y = if x / 16 % 2 == 1 { x - 16 } else { x + 16 }
  Bytes.concat([Bytes.slice(b, 0, at), Bytes.from_list([y]), Bytes.slice(b, at + 1, Bytes.len(b))])
}
