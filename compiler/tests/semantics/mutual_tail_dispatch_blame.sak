// milestone: M4
// expect-exit: 70
// expect-defect: D020
// covers: performance-r1 WS-P9b; design §17.192 (2), §17.115 (a contract-checking def hosts a dispatch join; a member's call of it is blamed)

fn down(n: Int) -> Int
  requires nonneg: n >= 0
{ if n == 0 { 0 } else if n % 2 == 0 { left(n - 1) } else { right(n - 1) } }

fn left(n: Int) -> Int { if n <= 1 { down(n - 2) } else { right(n - 1) } }

fn right(n: Int) -> Int { if n == 0 { 0 } else if n % 2 == 0 { down(n - 1) } else { left(n - 1) } }

pub fn main() -> Unit ! {Console} {
  Console.print("{down(1_000_000)} {right(4)}")
  Console.print("{down(2)}")
}
