// milestone: M3
// needs: requires/ensures/where runtime checks
// covers: Contract TypeDecl

type Percent = Int where it >= 0 && it <= 100

fn scale(p: Percent, total: Int) -> Int
  requires total >= 0
  ensures result <= total
{ total * p / 100 }

pub fn main() -> Unit ! {Console} { Console.print("{scale(Percent.from(50), 80)}") }
