// milestone: M4
// covers: performance-r1 WS-P21; design §17.273 (2) (a record updated round a loop reuses itself once it is a moved fresh record: `b !== r` excludes the element it started as, which its list still holds)

type Body = { x: Int, v: Int, tag: String }

fn at(bs: List<Body>, i: Int) -> Body { Option.expect(bs[i], "body index") }

// `b` starts as the element `bs[i]` and is rebuilt on every step; `bs[i]` is read on every
// step too, and must still be the element as it was until `b` is stored back.
fn drift(start: List<Body>, steps: Int) -> List<Body> {
  var bs = start
  var i = 0
  var seen = 0
  while i < List.len(bs) {
    var b = at(bs, i)
    var k = 0
    while k < steps {
      b = Body { ..b, x: b.x + 1, v: b.v + at(bs, i).x }
      k = k + 1
    }
    seen = seen + at(bs, i).x
    bs = List.set(bs, i, b)
    i = i + 1
  }
  List.push(bs, Body { x: seen, v: 0, tag: "seen" })
}

pub fn main() -> Unit ! {Console} {
  let bs = drift([Body { x: 1, v: 0, tag: "a" }, Body { x: 10, v: 0, tag: "b" }], 3)
  var out = ""
  for b in bs { out = "{out} {b.tag}{b.x}:{b.v}" }
  Console.print("bs{out}")
}
