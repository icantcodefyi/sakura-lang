// milestone: M4
// covers: performance-r1 WS-P21; design §17.290 (6) (i) (a record stored in a `Box` before it is rebuilt has a second holder: the rebuild allocates)

type Body = { x: Int, v: Int }

type Box = { body: Body }

fn at(bs: List<Body>, i: Int) -> Body { Option.expect(bs[i], "body index") }

// `b` starts as the element `start[0]` and is rebuilt on every step, but each step first puts
// it in a `Box`: reusing `b`'s record would change every box that holds it.
fn fill(start: List<Body>, steps: Int) -> List<Box> {
  var b = at(start, 0)
  var boxes: List<Box> = []
  var k = 0
  while k < steps {
    let box = Box { body: b }
    b = Body { ..b, v: b.v + 1 }
    boxes = List.push(boxes, box)
    k = k + 1
  }
  boxes
}

pub fn main() -> Unit ! {Console} {
  let boxes = fill([Body { x: 1, v: 0 }], 3)
  var out = ""
  for x in boxes { out = "{out} {x.body.v}" }
  Console.print("boxes{out}")
}
