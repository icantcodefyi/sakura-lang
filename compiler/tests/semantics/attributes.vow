// covers: Attribute Item
// known-bug: `vow test` needs the `wrap_secret` external in the JS runtime (REQUESTS.md, E to D)

@deprecated("use List.sum")
fn sum_old(xs: List<Int>) -> Int { List.sum(xs) }

@test_only
fn fixture() -> List<Int> { [1, 2] }

test "uses the fixture" { expect_eq(sum_old(fixture()), 3) }
