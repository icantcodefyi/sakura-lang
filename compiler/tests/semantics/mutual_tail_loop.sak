// milestone: M4
// covers: performance-r1 WS-P9; design §17.160 (5) (mutual tail calls share one loop)

fn is_even(n: Int) -> Bool { if n == 0 { true } else { is_odd(n - 1) } }

fn is_odd(n: Int) -> Bool { if n == 0 { false } else { is_even(n - 1) } }

// A three-state cycle with an accumulator: each def nests the other two.
fn red(n: Int, acc: Int) -> Int { if n == 0 { acc } else { green(n - 1, acc + 1) } }

fn green(n: Int, acc: Int) -> Int { if n == 0 { acc } else { amber(n - 1, acc + 2) } }

fn amber(n: Int, acc: Int) -> Int { if n == 0 { acc } else { red(n - 1, acc + 3) } }

// Not tail calls: these stay calls.
fn count_even(n: Int) -> Int { if n == 0 { 0 } else { 1 + count_odd(n - 1) } }

fn count_odd(n: Int) -> Int { if n == 0 { 0 } else { 1 + count_even(n - 1) } }

// Effectful members: the performs run in order from the merged loop.
fn ping(n: Int) -> Unit ! {Console} {
  if n == 0 {
    Console.print("done")
  } else {
    if n < 3 { Console.print("ping {n}") } else { () }
    pong(n - 1)
  }
}

fn pong(n: Int) -> Unit ! {Console} {
  if n == 0 {
    Console.print("done")
  } else {
    if n < 3 { Console.print("pong {n}") } else { () }
    ping(n - 1)
  }
}

// A generic member is not merged; the cycle still runs.
fn left<T>(n: Int, x: T) -> T { if n == 0 { x } else { right(n - 1, x) } }

fn right<T>(n: Int, x: T) -> T { if n == 0 { x } else { left(n - 1, x) } }

pub fn main() -> Unit ! {Console} {
  Console.print("{is_even(1_000_000)} {is_odd(1_000_001)} {is_even(7)}")
  Console.print("{red(1_000_000, 0)} {green(4, 0)} {amber(5, 0)}")
  Console.print("{count_even(10_000)} {count_odd(7)}")
  ping(1_000_000)
  ping(3)
  Console.print("{left(100_000, "x")}")
}
