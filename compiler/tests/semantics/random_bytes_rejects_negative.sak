// milestone: M3
// expect-exit: 70
// expect-defect: D020
// spec: design §7.2, §17.115, §17.286 (8)

// `Random.bytes(n)` requires `n >= 0`: a negative length is the performer's defect (`D020`,
// blaming this perform), checked before the handler draws.
pub fn main() -> Unit ! {Console} {
  with Random.seeded(7) {
    Console.print("{Bytes.len(Random.bytes(0))}")
    Console.print("{Bytes.len(Random.bytes(-1))}")
  }
}
