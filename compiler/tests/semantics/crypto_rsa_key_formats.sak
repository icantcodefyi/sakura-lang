// milestone: M3
// spec: RFC 0002 §2.7
// Spec: https://www.rfc-editor.org/rfc/rfc7518#section-6.3

// RSA key formats. The RSASSA-PKCS1-v1_5 table's first key (`tests/vectors/rsassa_pkcs1.txt`)
// reads as PKCS #8 and SPKI, and each half writes back the same DER and as a JWK (RFC 7518 §6.3)
// whose members (printed by name, sorted) include `alg` naming the algorithm (`RS256`, `PS384`, `RSA-OAEP-512`),
// which reads back to the same key; only member names are printed. `Raw` is no RSA format. Refused
// as `Malformed`: the DER cut or extended, a JWK whose `alg` names another algorithm, one with a
// leading zero byte in `n`, without its CRT members or with `oth`, a modulus of 1,024 bits, an
// even public exponent, and a private key that cannot sign (its modulus changed).
// On native, which has no tier 2, every import answers `Unavailable(...)` (`.native.stdout`, RFC 0002 §2.7's declared difference). Generated from the table.
import std/crypto
import std/crypto.{Algorithm, CryptoKey, Digest, KeyError, KeyFormat, Usage}

pub fn main() -> Unit ! {Console} {
  let pkcs8 = unhex(
    "",
  )
  let spki = unhex(
    "",
  )
  for alg in [
    Algorithm.RsassaPkcs1(Digest.Sha256),
    Algorithm.RsaPss(Digest.Sha384),
    Algorithm.RsaOaep(Digest.Sha512),
  ] {
    let (mine, theirs) = if alg == Algorithm.RsaOaep(Digest.Sha512) {
      ([Usage.Decrypt], [Usage.Encrypt])
    } else {
      ([Usage.Sign], [Usage.Verify])
    }
    let private = crypto.import_key(KeyFormat.Pkcs8, alg, mine, true, Secret.of(pkcs8))
    let public = crypto.import_key(KeyFormat.Spki, alg, theirs, true, Secret.of(spki))
    match (private, public) {
      (Ok(k), Ok(p)) => {
        Console.print(
          "{alg} der {crypto.export_key(k, KeyFormat.Pkcs8) == Ok(pkcs8)} {crypto.export_key(p, KeyFormat.Spki) == Ok(spki)}",
        )
        Console.print("{alg} private jwk {names(k)} {again(k, KeyFormat.Pkcs8, pkcs8)}")
        Console.print("{alg} public jwk {names(p)} {again(p, KeyFormat.Spki, spki)}")
        Console.print(
          "{alg} raw {crypto.export_key(p, KeyFormat.Raw).map(Bytes.len)} spki of private {crypto.export_key(k, KeyFormat.Spki).map(Bytes.len)}",
        )
      },
      (Err(e), _) => Console.print("{alg} {e}"),
      (_, Err(e)) => Console.print("{alg} {e}"),
    }
  }
  let alg = Algorithm.RsassaPkcs1(Digest.Sha256)
  let sign = [Usage.Sign]
  let checks = [Usage.Verify]
  Console.print("raw {imported(KeyFormat.Raw, checks, spki)}")
  Console.print(
    "spki cut {imported(KeyFormat.Spki, checks, Bytes.slice(spki, 0, Bytes.len(spki) - 1))}",
  )
  Console.print(
    "spki extended {imported(KeyFormat.Spki, checks, Bytes.concat([spki, Bytes.from_list([0])]))}",
  )
  Console.print("pkcs8 as spki {imported(KeyFormat.Spki, checks, pkcs8)}")
  Console.print("pkcs8 cut {imported(KeyFormat.Pkcs8, sign, Bytes.slice(pkcs8, 0, 600))}")
  Console.print("pkcs8 that cannot sign {imported(KeyFormat.Pkcs8, sign, flip(pkcs8, 60))}")
  match crypto.import_key(KeyFormat.Spki, alg, checks, true, Secret.of(spki)) {
    Ok(p) => {
      let text = crypto.export_key(p, KeyFormat.Jwk)
        .map(fn(b) { String.from_bytes(b).unwrap_or("") })
        .unwrap_or("")
      let n = member(text, "n")
      Console.print("jwk as written {jwk(text)}")
      Console.print("jwk alg PS256 {jwk(String.replace(text, "RS256", "PS256"))}")
      Console.print("jwk n with a zero byte {jwk(String.replace(text, n, "AA" + n))}")
      Console.print("jwk 1024-bit n {jwk(String.replace(text, n, String.slice(n, 0, 171)))}")
      Console.print("jwk even e {jwk(String.replace(text, "\"e\":\"AQAB\"", "\"e\":\"AQAC\""))}")
      Console.print("jwk oth {jwk(String.replace(text, "\"kty\"", "\"oth\":[],\"kty\""))}")
    },
    Err(e) => Console.print("jwk {e}"),
  }
  match crypto.import_key(KeyFormat.Pkcs8, alg, sign, true, Secret.of(pkcs8)) {
    Ok(k) => {
      let text = crypto.export_key(k, KeyFormat.Jwk)
        .map(fn(b) { String.from_bytes(b).unwrap_or("") })
        .unwrap_or("")
      let qi = member(text, "qi")
      let bare = String.replace(text, ",\"qi\":\"" + qi + "\"", "")
      Console.print("jwk private without qi {imported(KeyFormat.Jwk, sign, String.to_bytes(bare))}")
    },
    Err(e) => Console.print("jwk private {e}"),
  }
}

/// Whether `b` imports as an RSASSA-PKCS1-v1_5 SHA-256 key in `format`.
fn imported(format: KeyFormat, usages: List<Usage>, b: Bytes) -> Result<Unit, KeyError> {
  crypto.import_key(format, Algorithm.RsassaPkcs1(Digest.Sha256), usages, true, Secret.of(b))
    .map(fn(_) { () })
}

/// Whether JWK text imports as a public RSASSA-PKCS1-v1_5 SHA-256 key.
fn jwk(text: String) -> Result<Unit, KeyError> {
  imported(KeyFormat.Jwk, [Usage.Verify], String.to_bytes(text))
}

/// The member names of `key`'s JWK, sorted.
fn names(key: CryptoKey) -> Result<List<String>, KeyError> {
  crypto.export_key(key, KeyFormat.Jwk)
    .map(fn(b) {
      match Json.parse(String.from_bytes(b).unwrap_or("")) {
        Ok(Json.Object(members)) => List.sort(Map.keys(members)),
        _ => [],
      }
    })
}

/// Whether `key`'s JWK reads back to a key that writes `der` again.
fn again(key: CryptoKey, format: KeyFormat, der: Bytes) -> Bool {
  match crypto.export_key(key, KeyFormat.Jwk) {
    Ok(jwk) => match crypto.import_key(
      KeyFormat.Jwk,
      crypto.algorithm(key),
      crypto.usages(key),
      true,
      Secret.of(jwk),
    ) {
      Ok(k) => crypto.export_key(k, format) == Ok(der) && crypto.kind(k) == crypto.kind(key),
      Err(_) => false,
    },
    Err(_) => false,
  }
}

/// The string value of member `name` in JWK text.
fn member(text: String, name: String) -> String {
  match Json.parse(text) {
    Ok(j) => Json.get_string(j, name).unwrap_or(""),
    Err(_) => "",
  }
}

fn hex(b: Bytes) -> String {
  let digits = "0123456789abcdef"
  var out = ""
  for i in 0..Bytes.len(b) {
    let x = Bytes.get(b, i).unwrap_or(0)
    out = out + String.slice(digits, x / 16, x / 16 + 1) + String.slice(digits, x % 16, x % 16 + 1)
  }
  out
}

fn unhex(s: String) -> Bytes {
  var out: List<Int> = []
  for i in 0..String.len(s) / 2 {
    out = out.push(
      nibble(String.slice(s, 2 * i, 2 * i + 1)) * 16
        + nibble(String.slice(s, 2 * i + 1, 2 * i + 2)),
    )
  }
  Bytes.from_list(out)
}

fn nibble(c: String) -> Int {
  var v = 0
  for d in 0..16 { if String.slice("0123456789abcdef", d, d + 1) == c { v = d } }
  v
}

/// `b` with bit 4 of byte `at` flipped.
fn flip(b: Bytes, at: Int) -> Bytes {
  let x = Bytes.get(b, at).unwrap_or(0)
  let y = if x / 16 % 2 == 1 { x - 16 } else { x + 16 }
  Bytes.concat([Bytes.slice(b, 0, at), Bytes.from_list([y]), Bytes.slice(b, at + 1, Bytes.len(b))])
}
