// milestone: M3
// spec: RFC 0002 §2.6, design §17.280 (4)
// Spec: https://www.rfc-editor.org/rfc/rfc1952#section-2.3

// Decompressed bytes are the contract: files written by other tools decode to their text on
// every backend. `tests/vectors/compress` holds `blossom.txt` and four encodings of it, embedded
// here as Base64 (`sakura_rt`'s `tests/compress.rs` checks they are current): `gzip -9` (a
// name and a time in the header), Python's `zlib.compress` at level 9, the raw stream, and a
// gzip header with every optional field (FTEXT, FHCRC, FEXTRA, FNAME, FCOMMENT). Each is
// decoded whole and as a source of 5-byte items.
import std/compress
import std/compress.{CompressionError, Format}
import std/stream.{Source}

fn file(text: String) -> Bytes {
  Bytes.from_base64(text, Bytes.Alphabet.Standard).unwrap_or(Bytes.from_list([]))
}

fn streamed(z: Bytes, f: Format) -> Result<Bytes, CompressionError> {
  let src: Source<Bytes, {}> = Source.from_list([z]).chunks(5)
  try {
    compress.decompress_source(src, f, 4_096, fn(plain) {
      Bytes.concat(plain.fold([], fn(acc, b) { acc.push(b) }))
    })
  }
}

pub fn main() -> Unit ! {Console} {
  let files = [
    (
      "blossom.txt.gz",
      Format.Gzip,
      file(
        "",
      ),
    ),
    (
      "blossom.zz",
      Format.Deflate,
      file(
        "",
      ),
    ),
    (
      "blossom.deflate",
      Format.DeflateRaw,
      file(
        "",
      ),
    ),
    (
      "blossom-fields.gz",
      Format.Gzip,
      file(
        "",
      ),
    ),
  ]
  var first: Option<Bytes> = None
  for entry in files {
    let (name, f, z) = entry
    match compress.decompress(z, f, 4_096) {
      Ok(b) => {
        let same = match first {
          None => {
            first = Some(b)
            true
          },
          Some(a) => a == b,
        }
        Console.print(
          "{name}: {Bytes.len(b)} bytes, same text {same}, streamed {streamed(z, f) == Ok(b)}",
        )
      },
      Err(CompressionError(reason)) => Console.print("{name}: {reason}"),
    }
  }
  match first {
    Some(b) => {
      let text = String.from_bytes(b).unwrap_or("")
      let lines = String.split(text, "\n")
      Console.print("{List.len(lines) - 1} lines")
      for line in List.slice(lines, 0, 3) { Console.print(line) }
    },
    None => Console.print("nothing decoded"),
  }
}
