// milestone: M3
// spec: RFC 0002 §2.2
// Spec: https://url.spec.whatwg.org/#url-serializing

// A URL's password is a `Secret<String>`: `to_string`, `to_url` and `origin` leave it out, a
// resolved reference that keeps the authority keeps it, and only `Secret.expose` with a reason
// reads it. `UrlParts` is not `Show` because of it, so the record cannot be printed whole.
import std/url.{Url, UrlParts}

pub fn main() -> Unit ! {Console} {
  match Url.parse("https://ann:hunter2@api.example.test:8443/v1?k=1") {
    Ok(p) => {
      Console.print("to_string: {Url.to_string(p)}")
      Console.print("to_url: {Url.to_url(p)}")
      Console.print("origin: {Url.origin(p)}")
      Console.print("username: {p.username}, has password: {p.password.is_some()}")
      match Url.resolve(p, "../v2") {
        Ok(r) =>
          Console.print("resolved: {Url.to_string(r)}, has password: {r.password.is_some()}"),
        Err(e) => Console.print("resolved: {e.reason}"),
      }
      match Url.resolve(p, "//other.test/") {
        Ok(r) =>
          Console.print("new authority: {Url.to_string(r)}, has password: {r.password.is_some()}"),
        Err(e) => Console.print("new authority: {e.reason}"),
      }
      let length = p.password.map(fn(s) { String.len(Secret.expose(s, @trust("length only"))) })
      Console.print("password length: {length}")
    },
    Err(e) => Console.print("{e.reason}"),
  }
}
