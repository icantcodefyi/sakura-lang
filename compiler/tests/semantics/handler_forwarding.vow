// milestone: M2
// covers: HandlerExpr WithExpr

effect Greeter { fn greet(name: String) -> String }

fn plain() -> Handler<Greeter> { handler Greeter { fn greet(name) { "hello, {name}" } } }

// A clause that performs its own effect reaches the next handler out.
fn loud() -> Handler<Greeter, {Greeter}> {
  handler Greeter { fn greet(name) { String.to_upper(Greeter.greet(name)) + "!" } }
}

pub fn main() -> Unit ! {Console} {
  with plain() { Console.print(Greeter.greet("vow")) }
  with plain(), loud() { Console.print(Greeter.greet("vow")) }
}
