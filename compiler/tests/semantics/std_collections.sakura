// milestone: M1
// covers: Postfix ArgList

pub fn main() -> Unit ! {Console} {
  let words = String.split("b a c a", " ")
  Console.print("{List.sort(words)} {List.unique(words)} {List.reverse(words)}")
  Console.print("{List.join(words, "-")} {List.contains(words, "c")} {List.find(words, fn(w) { w > "a" })}")
  let counts = List.fold(words, Map.empty(), fn(m, w) { Map.update(m, w, fn(n) { Option.unwrap_or(n, 0) + 1 }) })
  Console.print("{counts} {Map.keys(counts)}")
  Console.print("{List.zip([1, 2, 3], words)} {List.enumerate(["x"])} {List.range(0, 3)}")
  Console.print("{String.trim("  pad  ")}|{String.pad_left("5", 3, "0")}|{String.repeat("ab", 2)}")
  Console.print("{Int.pow(2, 20)} {Int.clamp(50, 0, 10)} {Float.format(3.14159, 2)} {Float.sqrt(16.0)}")
}
