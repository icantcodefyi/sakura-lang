// milestone: M3
// covers: performance-r1 WS-P7; design §17.149 (a generic def updating a `List<A>`)

// Consumes `xs`: called with an owned list, it updates that list in place.
fn fill<A>(xs: List<A>, x: A) -> List<A> {
  var out = xs
  var i = 0
  while i < List.len(out) {
    out = List.set(out, i, x)
    i = i + 1
  }
  out
}

fn repeat<A>(x: A, n: Int) -> List<A> {
  var out: List<A> = []
  var i = 0
  while i < n {
    out = List.push(out, x)
    i = i + 1
  }
  out
}

fn tally<K: Hash>(keys: List<K>) -> Map<K, Int> {
  var m: Map<K, Int> = Map.empty()
  for k in keys { m = Map.insert(m, k, Option.unwrap_or(Map.get(m, k), 0) + 1) }
  m
}

pub fn main() -> Unit ! {Console} {
  let words = repeat("a", 40)
  let kept = words
  let zs = fill(words, "z")
  Console.print("{List.len(kept)} {kept[0]} {kept[39]} {zs[0]} {zs[39]}")
  let owned = fill(repeat(1, 50), 2)
  Console.print("{List.sum(owned)}")
  let pairs = fill(repeat((1, "x"), 3), (2, "y"))
  Console.print("{pairs}")
  Console.print("{tally(["b", "a", "b"])} {tally([3, 1, 3, 3])}")
}
