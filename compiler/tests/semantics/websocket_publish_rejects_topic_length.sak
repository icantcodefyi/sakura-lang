// milestone: M3
// expect-exit: 70
// expect-defect: D020
// spec: design §7.2, §17.286 (8), §17.289 (9); RFC 0002 §2.10, §6; plan web-apis.md phase 8s
// Spec: https://www.rfc-editor.org/rfc/rfc6455#section-10.4

// A topic is at most 256 bytes: `subscribe` to a longer one is the performer's defect (`D020`,
// blaming this perform), checked before the handler sees it.
import std/websocket.{WebSocket}

pub fn main() -> Unit ! {Console} {
  with WebSocket.scripted([]) {
    let _ = try {
      WebSocket.accept(
        WebSocket.upgrade_request("/ws", []),
        WebSocket.upgrade(),
        fn(sock) {
          WebSocket.subscribe(sock, String.repeat("t", 256))
          Console.print("256 bytes subscribed")
          WebSocket.subscribe(sock, String.repeat("t", 257))
          Console.print("257 bytes subscribed")
        },
      )
    }
  }
}
