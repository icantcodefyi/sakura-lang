// milestone: M3
// spec: RFC 0002 §2.7
// Spec: https://www.rfc-editor.org/rfc/rfc5903#section-8.1

// ECDH over P-256 (`tests/vectors/ecdh_p256.txt`, RFC 5903 §8.1): each side's `derive_bits` with
// the other's public key is the RFC's shared x-coordinate, compared and never printed. The
// private keys are imported as PKCS #8 without their public key, which import computes, and the
// public keys raw (uncompressed points). Two pairs generated under one seed agree the same way.
import std/crypto
import std/crypto.{Algorithm, Curve, DeriveParams, KeyFormat, Usage}

pub fn main() -> Unit ! {Console} {
  let alg = Algorithm.Ecdh(Curve.P256)
  let bare = "3041020100301306072a8648ce3d020106082a8648ce3d030107042730250201010420"
  let i = crypto.import_key(
    KeyFormat.Pkcs8,
    alg,
    [Usage.DeriveBits],
    false,
    Secret.of(unhex(bare + "c88f01f510d9ac3f70a292daa2316de544e9aab8afe84049c62a9c57862d1433")),
  )
  let r = crypto.import_key(
    KeyFormat.Pkcs8,
    alg,
    [Usage.DeriveBits],
    false,
    Secret.of(unhex(bare + "c6ef9c5d78ae012a011164acb397ce2088685d8f06bf9be0b283ab46476bee53")),
  )
  let gi = crypto.import_key(
    KeyFormat.Raw,
    alg,
    [],
    true,
    Secret.of(
      unhex(
        "04dad0b65394221cf9b051e1feca5787d098dfe637fc90b9ef945d0c37725811805271a0461cdb8252d61f1c456fa3e59ab1f45b33accf5f58389e0577b8990bb3",
      ),
    ),
  )
  let gr = crypto.import_key(
    KeyFormat.Raw,
    alg,
    [],
    true,
    Secret.of(
      unhex(
        "04d12dfb5289c8d4f81208b70270398c342296970a0bccb74c736fc7554494bf6356fbf3ca366cc23e8157854c13c58d6aac23f046ada30f8353e74f33039872ab",
      ),
    ),
  )
  let shared = unhex("d6840f6b42f6edafd13116e0e12565202fef8e9ece7dce03812464d04b9442de")
  match (i, r, gi, gr) {
    (Ok(i), Ok(r), Ok(gi), Ok(gr)) => {
      Console.print(
        "initiator {crypto.derive_bits(i, DeriveParams.EcdhWith(gr), 256) == Ok(shared)}",
      )
      Console.print(
        "responder {crypto.derive_bits(r, DeriveParams.EcdhWith(gi), 256) == Ok(shared)}",
      )
      Console.print(
        "264 bits {crypto.derive_bits(i, DeriveParams.EcdhWith(gr), 264).map(Bytes.len)}",
      )
    },
    _ => Console.print("the RFC's keys do not import"),
  }
  let (a, b) = with Random.seeded(5) {
    (
      crypto.generate_key_pair(alg, [Usage.DeriveBits], false),
      crypto.generate_key_pair(alg, [Usage.DeriveBits], false),
    )
  }
  let ab = crypto.derive_bits(a.private, DeriveParams.EcdhWith(b.public), 256)
  let ba = crypto.derive_bits(b.private, DeriveParams.EcdhWith(a.public), 256)
  Console.print("generated agree {ab == ba} {ab.map(Bytes.len)}")
  Console.print("public usages {crypto.usages(a.public)} private usages {crypto.usages(a.private)}")
}

fn unhex(s: String) -> Bytes {
  var out: List<Int> = []
  for i in 0..String.len(s) / 2 {
    out = out.push(
      nibble(String.slice(s, 2 * i, 2 * i + 1)) * 16
        + nibble(String.slice(s, 2 * i + 1, 2 * i + 2)),
    )
  }
  Bytes.from_list(out)
}

fn nibble(c: String) -> Int {
  var v = 0
  for d in 0..16 { if String.slice("0123456789abcdef", d, d + 1) == c { v = d } }
  v
}
