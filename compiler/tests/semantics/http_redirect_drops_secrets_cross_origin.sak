// milestone: M3
// spec: RFC 0002 §2.4; design §17.263 (4)
// Spec: https://fetch.spec.whatwg.org/#http-redirect-fetch

// A hop to another origin (scheme, host or port) drops every `secret_headers` entry and any
// ordinary header named `authorization` or named like a secret one, as Fetch drops
// `Authorization`; a same-origin hop keeps them, and they stay dropped for the rest of the
// chain, even back on the first origin. `logged` prints the names a hop would send (a secret's
// value is never shown).
import std/http.{Http, Path}
import std/request.{Get, Request}
import std/response.{HttpError, Response}
import std/url.{Url}

fn redirect(location: String) -> Response {
  Response { ..Response.status(302, ""), headers: [("location", location)] }
}

fn logged() -> Handler<Http, {Console, Http}> {
  handler Http {
    fn send(req) {
      let secret = List.map(req.secret_headers, fn(h) { h.0 })
      let plain = List.map(req.headers, fn(h) { h.0 })
      Console.print("  {req.url} secret {secret} headers {plain}")
      Http.send(req)
    }
    fn stream(req, body) { Http.stream(req, body) }
    fn read_chunk(b, max) { Http.read_chunk(b, max) }
  }
}

pub fn main() -> Unit ! {Console} {
  let script = [
    (Path("/start"), redirect("/same")),
    (Path("/same"), redirect("https://a.example:8443/port")),
    (Path("/port"), redirect("https://a.example/back")),
    (Path("/back"), Response.status(200, "back")),
  ]
  let req = Http.bearer(
    Request {
      ..Request.of(Get, Url.from("https://a.example/start")),
      headers: [("Authorization", "Basic old"), ("X-Api-Key", "plain"), ("accept", "*/*")],
      secret_headers: [("x-api-key", Secret.of("k3y"))],
    },
    Secret.of("t0ken"),
  )
  with Http.scripted(script), logged(), Http.scoped(["a.example:443", "a.example:8443"]) {
    let got: Result<Response, HttpError> = try { Http.send(req) }
    Console.print("{got.map(fn(r) { r.status })}")
  }
}
