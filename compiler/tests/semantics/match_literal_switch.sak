// milestone: M1
// covers: design §17.200 (a literal `match` is one `Switch`: first match with wildcard and guarded rows between literal rows; past 64 arms the JS joins leave the inline form, inside a loop too); MatchExpr MatchArm Literal TuplePat

fn pick(x: Int) -> String {
  match x {
    1 => "one",
    n if n > 100 => "big",
    2 => "two",
    _ if x == 3 => "three by guard",
    3 => "three",
    _ => "other",
  }
}

fn kind(s: String) -> Int {
  match s {
    "a" | "b" => 1,
    t if t == "zz" => 2,
    "c" => 3,
    _ => 0,
  }
}

fn grid(p: (Int, String)) -> Int {
  match p {
    (0, "x") => 1,
    (_, "y") => 2,
    (0, _) => 3,
    (1, "x") => 4,
    _ => 5,
  }
}

fn squares(n: Int) -> Int {
  var i = 0
  var total = 0
  while i < n {
    let sq = match i {
      0 => 0,
      1 => 1,
      2 => 4,
      3 => 9,
      4 => 16,
      5 => 25,
      6 => 36,
      7 => 49,
      8 => 64,
      9 => 81,
      10 => 100,
      11 => 121,
      12 => 144,
      13 => 169,
      14 => 196,
      15 => 225,
      16 => 256,
      17 => 289,
      18 => 324,
      19 => 361,
      20 => 400,
      21 => 441,
      22 => 484,
      23 => 529,
      24 => 576,
      25 => 625,
      26 => 676,
      27 => 729,
      28 => 784,
      29 => 841,
      30 => 900,
      31 => 961,
      32 => 1024,
      33 => 1089,
      34 => 1156,
      35 => 1225,
      36 => 1296,
      37 => 1369,
      38 => 1444,
      39 => 1521,
      40 => 1600,
      41 => 1681,
      42 => 1764,
      43 => 1849,
      44 => 1936,
      45 => 2025,
      46 => 2116,
      47 => 2209,
      48 => 2304,
      49 => 2401,
      50 => 2500,
      51 => 2601,
      52 => 2704,
      53 => 2809,
      54 => 2916,
      55 => 3025,
      56 => 3136,
      57 => 3249,
      58 => 3364,
      59 => 3481,
      60 => 3600,
      61 => 3721,
      62 => 3844,
      63 => 3969,
      64 => 4096,
      65 => 4225,
      66 => 4356,
      67 => 4489,
      68 => 4624,
      69 => 4761,
      _ => 0,
    }
    total = total + sq
    i = i + 1
  }
  total
}

pub fn main() -> Unit ! {Console} {
  Console.print("{pick(1)} {pick(2)} {pick(3)} {pick(150)} {pick(-1)}")
  Console.print("{kind("a")} {kind("b")} {kind("zz")} {kind("c")} {kind("d")}")
  Console.print(
    "{grid((0, "x"))} {grid((0, "y"))} {grid((0, "z"))} {grid((1, "x"))} {grid((1, "y"))} {grid((2, "x"))}",
  )
  Console.print("{squares(70)} {squares(75)}")
}
