// milestone: M3
// spec: RFC 0002 §2.7
// Spec: https://www.rfc-editor.org/rfc/rfc7748#section-5.2

// RFC 7748 §5.2's two vectors and §6.1's exchange in both directions (`tests/vectors/x25519.txt`):
// `derive_bits` with `EcdhWith(peer)` is X25519 of the private scalar (PKCS #8) and the peer's
// public u-coordinate (raw). The shared secrets are compared with the RFC's, never printed;
// fewer bits are its prefix, more than 256 are `Length`, and a small-order peer (here zero) is
// `ZeroSecret`. Generated from the table.
import std/crypto
import std/crypto.{Algorithm, CryptoKey, DeriveParams, KeyError, KeyFormat, Usage}

pub fn main() -> Unit ! {Console} {
  for (case, k, u, out) in [
    (
      "5.2",
      "a546e36bf0527c9d3b16154b82465edd62144c0ac1fc5a18506a2244ba449ac4",
      "e6db6867583030db3594c1a424b15f7c726624ec26b3353b10a903a6d0ab1c4c",
      "c3da55379de9c6908e94ea4df28d084f32eccf03491c71f754b4075577a28552",
    ),
    (
      "5.2",
      "4b66e9d4d1b4673c5ad22691957d6af5c11b6421e0ea01d42ca4169e7918ba0d",
      "e5210f12786811d3f4b7959d0538ae2c31dbe7106fc03c3efc4cd549c715a493",
      "95cbde9476e8907d7aade45cb4b873f88b595a68799fa152e6f8f7647aac7957",
    ),
    (
      "6.1-alice-shared",
      "77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a",
      "de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f",
      "4a5d9d5ba4ce2de1728e3bf480350f25e07e21c947d19e3376f09b3c1e161742",
    ),
    (
      "6.1-bob-shared",
      "5dab087e624a8a4b79e17f8b83800ee66f3bb1292618b6fd1c2f8b27ff88e0eb",
      "8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a",
      "4a5d9d5ba4ce2de1728e3bf480350f25e07e21c947d19e3376f09b3c1e161742",
    ),
  ] {
    match (private_key(k), public_key(u)) {
      (Ok(s), Ok(p)) => {
        let peer = DeriveParams.EcdhWith(p)
        let full = crypto.derive_bits(s, peer, 256) == Ok(unhex(out))
        let half = crypto.derive_bits(s, peer, 128) == Ok(Bytes.slice(unhex(out), 0, 16))
        Console.print("{case} {full} {half} {crypto.derive_bits(s, peer, 264).map(Bytes.len)}")
      },
      _ => Console.print("{case} does not import"),
    }
  }
  match (private_key(String.repeat("07", 32)), public_key(String.repeat("00", 32))) {
    (Ok(s), Ok(zero)) =>
      Console.print(
        "small order {crypto.derive_bits(s, DeriveParams.EcdhWith(zero), 256).map(Bytes.len)}",
      ),
    _ => Console.print("small order does not import"),
  }
}

fn private_key(k: String) -> Result<CryptoKey, KeyError> {
  let pkcs8 = unhex("302e020100300506032b656e04220420" + k)
  crypto.import_key(KeyFormat.Pkcs8, Algorithm.X25519, [Usage.DeriveBits], false, Secret.of(pkcs8))
}

fn public_key(u: String) -> Result<CryptoKey, KeyError> {
  crypto.import_key(KeyFormat.Raw, Algorithm.X25519, [], true, Secret.of(unhex(u)))
}

fn hex(b: Bytes) -> String {
  let digits = "0123456789abcdef"
  var out = ""
  for i in 0..Bytes.len(b) {
    let x = Bytes.get(b, i).unwrap_or(0)
    out = out + String.slice(digits, x / 16, x / 16 + 1) + String.slice(digits, x % 16, x % 16 + 1)
  }
  out
}

fn unhex(s: String) -> Bytes {
  var out: List<Int> = []
  for i in 0..String.len(s) / 2 {
    out = out.push(
      nibble(String.slice(s, 2 * i, 2 * i + 1)) * 16
        + nibble(String.slice(s, 2 * i + 1, 2 * i + 2)),
    )
  }
  Bytes.from_list(out)
}

fn nibble(c: String) -> Int {
  var v = 0
  for d in 0..16 { if String.slice("0123456789abcdef", d, d + 1) == c { v = d } }
  v
}
