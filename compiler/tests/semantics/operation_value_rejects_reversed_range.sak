// milestone: M3
// expect-exit: 70
// expect-defect: D020
// spec: design §7.2, §17.115, §17.288 (12)

// An operation used as a function value checks its `requires` inside its wrapper, as a
// contracted def called as a value does: `D020` names `Random.int`'s clause, with no
// call-site span.
pub fn main() -> Unit ! {Console} {
  with Random.seeded(7) {
    let draw = Random.int
    Console.print("{draw(1, 1)}")
    Console.print("{draw(3, 2)}")
  }
}
