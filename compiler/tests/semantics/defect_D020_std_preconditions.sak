pub fn main() -> Unit ! {Console} {
  Console.print("{Int.clamp(7, 1, 5)}")
  Console.print("{Int.pow(2, 10)}")
  Console.print("{Int.clamp(7, 5, 1)}")
  Console.print("never printed")
}
