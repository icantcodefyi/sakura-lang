// milestone: M3
// spec: RFC 0002 §2.3
// Spec: https://www.rfc-editor.org/rfc/rfc7578#section-4

// A form encoded as `multipart/form-data` with RFC 7578's example boundary `AaB03x` (§4.1), the
// bytes printed line by line, then parsed back: a text field (its LF made CRLF, as HTML
// submits it), two files under one name (§4.3) and a file with no media type
// (`application/octet-stream`, §4.4). Last, RFC 7578 §4.5's example part as printed in the
// RFC, which has no close delimiter and is `Malformed` at its end, and the same part closed
// with `--AaB03x--`: a text field whose deprecated `content-transfer-encoding` (§4.7) is not
// decoded.
import std/blob.{Blob, FileData}
import std/form.{Form, FormError, FormLimits, Part}

fn file(name: String, text: String, media_type: String) -> Part {
  Part.File(FileData {
    blob: Blob.of(String.to_bytes(text), media_type),
    name,
    last_modified: Instant.from_unix_millis(0),
  })
}

fn describe(r: Result<Form, FormError>) -> List<String> {
  match r {
    Ok(f) =>
      List.map(f.entries, fn(e) {
        match e.1 {
          Part.Text(v) => "{e.0} = Text({[v]})",
          Part.File(fd) =>
            "{e.0} = File({[fd.name]}, {[fd.blob.media_type]}, {Blob.text(fd.blob)})",
        }
      }),
    Err(e) => ["{e.reason}"],
  }
}

pub fn main() -> Unit ! {Console} {
  let form = Form {
    entries: [
      ("field1", Part.Text("Joe owes \u{20AC}100.\nThanks")),
      ("files", file("file1.txt", "...contents of file1.txt...", "text/plain")),
      ("files", file("file2.gif", "GIF89a", "image/gif")),
      ("blob", file("data.bin", "raw", "")),
    ],
  }
  let body = Form.encode_multipart(form, "AaB03x")
  for line in String.split(String.from_bytes(body).unwrap_or(""), "\r\n") { Console.print(line) }
  let limits = FormLimits { max_parts: 10, max_bytes: 4_096, max_field_bytes: 1_024 }
  let ct = "multipart/form-data; boundary=AaB03x"
  for line in describe(Form.parse_multipart(body, ct, limits)) { Console.print(line) }
  let example = "--AaB03x\r\ncontent-disposition: form-data; name=\"field1\"\r\ncontent-type: text/plain;charset=UTF-8\r\ncontent-transfer-encoding: quoted-printable\r\n\r\nJoe owes =E2=82=AC100.\r\n--AaB03x"
  for line in describe(Form.parse_multipart(String.to_bytes(example), ct, limits)) {
    Console.print("as printed: {line}")
  }
  let closed = String.to_bytes(example + "--\r\n")
  for line in describe(Form.parse_multipart(closed, ct, limits)) { Console.print("closed: {line}") }
}
