utf-8 bytes: Ok("hé")
text: Ok("hé")
empty: Ok("")
not utf-8: Err(BadRequest { detail: "body is not UTF-8" })
over limit: Err(BadRequest { detail: "body exceeds 1 bytes" })
json: Ok(42)
json not utf-8: Err(BadRequest { detail: "body is not UTF-8" })
json over limit: Err(BadRequest { detail: "body exceeds 1 bytes" })
decode: Err(DecodeError { path: "", message: "expected an integer, found a boolean" })
json not a number: Err(BadRequest { detail: ": expected an integer, found a boolean" })
