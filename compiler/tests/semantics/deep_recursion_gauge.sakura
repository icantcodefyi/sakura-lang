// milestone: M3
// mode: test
// covers: performance-r1 WS-P3; design §17.112 (the gauge is restored after a defect)

fn zero() -> Int { List.len([]) }

fn sum_until(n: Int) -> Int { if n == 0 { 1 / zero() } else { n + sum_until(n - 1) } }

fn sum(n: Int) -> Int { if n == 0 { 0 } else { n + sum(n - 1) } }

fn is_even(n: Int) -> Bool { if n == 0 { true } else { is_odd(n - 1) } }

fn is_odd(n: Int) -> Bool { if n == 0 { false } else { is_even(n - 1) } }

// A non-recursive direct def between two recursions: the inner one starts its own driver.
fn tri(n: Int) -> Int { sum(n) }

fn outer(n: Int) -> Int { if n == 0 { 0 } else { tri(3) + outer(n - 1) } }

test "a defect deep in a recursion, then deep recursions again" {
  expect_defect(fn() { sum_until(1_000_000) })
  expect_eq(sum(1_000_000), 500000500000)
  expect_defect(fn() { sum_until(500) })
  expect_eq(is_even(1_000_001), false)
  expect_eq(outer(1_000_000), 6000000)
}
