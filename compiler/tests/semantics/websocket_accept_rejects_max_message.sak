// milestone: M3
// expect-exit: 70
// expect-defect: D020
// spec: design §7.2, §17.286 (8), §17.289 (2); RFC 0002 §2.10; plan web-apis.md phase 8s
// Spec: https://www.rfc-editor.org/rfc/rfc6455#section-10.4

// `WebSocket.accept` requires `options.max_message > 0`: no message fits in zero bytes, so the
// bound is the performer's defect (`D020`, blaming this perform), checked before the handler
// reads the handshake or upgrades anything.
import std/websocket.{Upgrade, WebSocket}

pub fn main() -> Unit ! {Console} {
  Console.print("before")
  with WebSocket.scripted([]) {
    let _ = try {
      WebSocket.accept(
        WebSocket.upgrade_request("/ws", []),
        Upgrade { ..WebSocket.upgrade(), max_message: 0 },
        fn(_sock) { Console.print("accepted") },
      )
    }
  }
}
