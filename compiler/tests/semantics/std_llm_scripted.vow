// milestone: M3
// needs: the schema of `T` inside handler clauses of generic operations (D090 today)
// mode: test
// covers: WithExpr TryExpr Lambda

import std/llm.{Answer, Llm, Request, ToolCall, Use}
import std/prompt.{Prompt}

test "scripted generate decodes and checks the output" {
  let req: Request<List<Int>> = Llm.request("Numbers only.", Prompt.text("three numbers"))
  with Llm.scripted(["[1, 2, 3]", "not json"]) {
    expect_eq(try { Llm.generate(req) }, Ok([1, 2, 3]))
    expect((try { Llm.generate(req) }).is_err())
  }
}

test "scripted step tells tool calls from answers" {
  let req: Request<Int> = Llm.request("Count.", Prompt.text("how many?"))
  with Llm.scripted([
        "\{\"tool_use\": [\{\"name\": \"count\", \"input\": \{\"of\": \"a\"\}\}]\}",
        "7",
      ]) {
    let first = try { Llm.step(req, [], []) }
    expect_eq(
      first,
      Ok(
        Use([
          ToolCall {
            id: "call_0_0",
            name: "count",
            input: Json.Object(Map.of([("of", Json.String("a"))])),
          },
        ]),
      ),
    )
    expect_eq(try { Llm.step(req, [], []) }, Ok(Answer(7)))
  }
}

test "scripted stream reports a partial, then the value" {
  let req: Request<Int> = Llm.request("Count.", Prompt.text("how many?"))
  with Llm.scripted(["5"]) {
    let n = try { Llm.stream(req, fn(p) { Console.print(p.text) }) }
    expect_eq(n, Ok(5))
    expect_output(["5"])
  }
}
