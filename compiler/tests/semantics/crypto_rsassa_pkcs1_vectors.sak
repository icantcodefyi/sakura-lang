// milestone: M3
// spec: RFC 0002 §2.7
// Spec: https://www.rfc-editor.org/rfc/rfc8017#section-8.2

// RSASSA-PKCS1-v1_5 (RFC 8017 §8.2, JOSE's RS256, RS384 and RS512) with Project Wycheproof's
// 2048-bit keys (`tests/vectors/rsassa_pkcs1.txt`), two tests of each hash: the private key imported
// as PKCS #8 and the public key as SPKI. The scheme is deterministic, so `sign` writes the table's
// signature byte for byte, which the output shows as `true` (a signature is never printed); the
// table's signature verifies, and other data and a flipped bit do not.
// On native, which has no tier 2, `import_key` answers `Unavailable("RSASSA-PKCS1-v1_5")` (`.native.stdout`, RFC 0002 §2.7's declared difference). Generated from the table.
import std/crypto
import std/crypto.{Algorithm, Digest, KeyFormat, Usage}

pub fn main() -> Unit ! {Console} {
  for (hash, id, pkcs8, spki, data, signature) in [
    (
      "Sha256",
      81,
      "",
      "",
      "",
      "",
    ),
    (
      "Sha256",
      82,
      "",
      "",
      "0000000000000000000000000000000000000000",
      "",
    ),
    (
      "Sha384",
      89,
      "",
      "",
      "",
      "",
    ),
    (
      "Sha384",
      90,
      "",
      "",
      "0000000000000000000000000000000000000000",
      "",
    ),
    (
      "Sha512",
      97,
      "",
      "",
      "",
      "",
    ),
    (
      "Sha512",
      98,
      "",
      "",
      "0000000000000000000000000000000000000000",
      "",
    ),
  ] {
    let alg = Algorithm.RsassaPkcs1(digest(hash))
    let private = crypto.import_key(
      KeyFormat.Pkcs8,
      alg,
      [Usage.Sign],
      false,
      Secret.of(unhex(pkcs8)),
    )
    let public = crypto.import_key(
      KeyFormat.Spki,
      alg,
      [Usage.Verify],
      true,
      Secret.of(unhex(spki)),
    )
    match (private, public) {
      (Ok(k), Ok(p)) => {
        let msg = unhex(data)
        let sig = unhex(signature)
        let mine = with Random.seeded(0) { crypto.sign(k, msg) }
        Console.print(
          "{hash} tcId {id} sign {mine == sig} verify {p.verify(sig, msg)} other {p.verify(sig, String.to_bytes("other"))} flipped {p.verify(flip(sig, 9), msg)}",
        )
      },
      (Err(e), _) => Console.print("{hash} tcId {id} {e}"),
      (_, Err(e)) => Console.print("{hash} tcId {id} {e}"),
    }
  }
}

fn digest(name: String) -> Digest {
  match name {
    "Sha256" => Digest.Sha256,
    "Sha384" => Digest.Sha384,
    _ => Digest.Sha512,
  }
}

fn hex(b: Bytes) -> String {
  let digits = "0123456789abcdef"
  var out = ""
  for i in 0..Bytes.len(b) {
    let x = Bytes.get(b, i).unwrap_or(0)
    out = out + String.slice(digits, x / 16, x / 16 + 1) + String.slice(digits, x % 16, x % 16 + 1)
  }
  out
}

fn unhex(s: String) -> Bytes {
  var out: List<Int> = []
  for i in 0..String.len(s) / 2 {
    out = out.push(
      nibble(String.slice(s, 2 * i, 2 * i + 1)) * 16
        + nibble(String.slice(s, 2 * i + 1, 2 * i + 2)),
    )
  }
  Bytes.from_list(out)
}

fn nibble(c: String) -> Int {
  var v = 0
  for d in 0..16 { if String.slice("0123456789abcdef", d, d + 1) == c { v = d } }
  v
}

/// `b` with bit 4 of byte `at` flipped.
fn flip(b: Bytes, at: Int) -> Bytes {
  let x = Bytes.get(b, at).unwrap_or(0)
  let y = if x / 16 % 2 == 1 { x - 16 } else { x + 16 }
  Bytes.concat([Bytes.slice(b, 0, at), Bytes.from_list([y]), Bytes.slice(b, at + 1, Bytes.len(b))])
}
