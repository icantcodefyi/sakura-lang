// milestone: M3
// covers: performance-r1 WS-P10; design §17.181 (2), §17.156 (1) (handler_cancel_bound's loop
// performing through two identity forwarders: dispatch past them still tests cancellation
// first, so the cancelled task stops at the same perform)

error Stop

effect Counter {
  fn next() -> Int
}

fn counter() -> Handler<Counter> {
  handler Counter {
    var n = 0
    fn next() {
      n = n + 1
      n
    }
  }
}

fn forward() -> Handler<Counter, {Counter}> {
  handler Counter {
    fn next() { Counter.next() }
  }
}

pub fn main() -> Unit ! {Console} {
  with Clock.virtual(), Task.deterministic(7) {
    let outcome = try {
      Task.all([
        fn() {
          with counter(), forward(), forward() {
            var n = 0
            for _ in 0..1_000_000 {
              n = Counter.next()
              if n == 1 {
                Console.print("started")
                Clock.sleep(Duration.millis(10))
              }
            }
            Console.print("finished")
            n
          }
        },
        fn() {
          Clock.sleep(Duration.millis(1))
          fail Stop
        },
      ])
    }
    Console.print("{outcome}")
    Console.print("joined")
  }
}
