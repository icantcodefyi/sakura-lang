// milestone: M5
// covers: design §10.2, §17.171 (the native Sql host)
// spec: §10.2

// `Sql` held to the JS runtime's rows on every backend (the native host reads and decodes them
// itself): records by column name, tuples by position, one column, NULL as `None`, 0/1 as
// `Bool`, a refinement, a JSON text column, an `Int` parameter bound as INTEGER, repeated and
// numeric column names, each decode error's text, SQLite's own messages, and transactions that
// commit, roll back and nest.
import std/json.{Json}
import std/sql.{Sql, SqlError}

type Person = { name: String, age: Int, nick: Option<String>, admin: Bool }

type Small = Int where it < 10

type Tagged = { id: Small, tags: List<String> }

fn shown<T: Show>(r: Result<T, SqlError>) -> String {
  match r {
    Ok(v) => "{v}",
    Err(e) => e.message,
  }
}

fn names() -> List<String> ! {Sql, Fail<SqlError>} {
  Sql.query(sql"select name from people order by name")
}

pub fn main() -> Unit ! {Console, Fail<SqlError>} {
  with Sql.memory() {
    let _ = Sql.execute(sql"create table people (name text, age integer, nick text, admin integer)")
    let n = Sql.execute(
      sql"insert into people values ({"ada"}, {36}, null, {true}), ({"bob"}, {7}, {"b"}, {false})",
    )
    Console.print("{n}")
    let people: List<Person> = Sql.query(
      sql"select name, age, nick, admin from people order by name",
    )
    Console.print("{people}")
    let pairs: List<(String, Int)> = Sql.query(sql"select name, age from people order by age")
    Console.print("{pairs}")
    let ages: List<Float> = Sql.query(sql"select age from people order by age")
    Console.print("{ages}")
    let halves: List<Int> = Sql.query(sql"select {7} / 2")
    Console.print("{halves}")
    let cols: List<(Int, Int, Int)> = Sql.query(sql"select 1 as '2', 2 as '1', 3 as x, 4 as x")
    Console.print("{cols}")
    let _ = Sql.execute(sql"create table tagged (id integer, tags text)")
    let _ = Sql.execute(
      sql"insert into tagged values (1, {Json.encode(["a", "b"])}), (12, {Json.encode(["c"])})",
    )
    let one: Result<List<Tagged>, SqlError> = try {
      Sql.query(sql"select id, tags from tagged where id = 1")
    }
    Console.print(shown(one))
    let big: Result<List<Tagged>, SqlError> = try {
      Sql.query(sql"select id, tags from tagged where id = 12")
    }
    Console.print(shown(big))
    let missing: Result<List<Person>, SqlError> = try { Sql.query(sql"select name from people") }
    Console.print(shown(missing))
    let text: Result<List<String>, SqlError> = try { Sql.query(sql"select age from people") }
    Console.print(shown(text))
    let flag: Result<List<Bool>, SqlError> = try { Sql.query(sql"select age from people") }
    Console.print(shown(flag))
    let nested: Result<List<List<Int>>, SqlError> = try { Sql.query(sql"select tags from tagged") }
    Console.print(shown(nested))
    let blob: Result<List<Bytes>, SqlError> = try { Sql.query(sql"select null") }
    Console.print(shown(blob))
    let syntax: Result<List<Int>, SqlError> = try { Sql.query(sql"selec 1") }
    Console.print(shown(syntax))
    let table: Result<Int, SqlError> = try { Sql.execute(sql"insert into nope values (1)") }
    Console.print(shown(table))

    let undone: Result<Int, SqlError> = try {
      Sql.transaction(fn() {
        let _ = Sql.execute(sql"insert into people values ('cy', 1, null, 0)")
        fail SqlError { message: "abandoned" }
      })
    }
    Console.print("{shown(undone)} {names()}")
    let kept = Sql.transaction(fn() {
      let _ = Sql.execute(sql"insert into people values ('dee', 2, null, 0)")
      let inner: Result<Int, SqlError> = try {
        Sql.transaction(fn() {
          let _ = Sql.execute(sql"insert into people values ('eve', 3, null, 0)")
          fail SqlError { message: "inner" }
        })
      }
      List.len(names()) + List.len([shown(inner)])
    })
    Console.print("{kept} {names()}")
  }
}
