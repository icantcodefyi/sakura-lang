// milestone: M3
// covers: design §17.118 (direct regions on WASM: owned arguments survive a gauge abort and the frame restart), §17.211 (1) (a clause that writes its state and can abort; twins aborting with their `with`s open), §17.211 (2) (a callback's twin aborting inside `List.map`'s; a callback with no twin; a callback with a bound perform)

type Acc = { total: Int, label: String }

// Non-tail recursion over owned values: past the gauge the region is run again through frames.
fn walk(xs: List<Int>, s: String, n: Int) -> Int {
  if n == 0 { List.len(xs) + String.len(s) } else { walk(xs, s, n - 1) + 1 }
}

fn fold_acc(a: Acc, n: Int) -> Acc {
  if n == 0 { a } else { fold_acc(Acc { total: a.total + n, label: a.label }, n - 1) }
}

fn deep_acc(a: Acc, n: Int) -> Int { if n == 0 { a.total } else { deep_acc(a, n - 1) + 1 } }

fn half(x: Float, n: Int) -> Float { if n == 0 { x } else { half(x, n - 1) * 1.0 } }

// A non-recursive region that enters a recursive one: an abort deep inside leaves both.
fn shallow(xs: List<Int>, n: Int) -> Int { walk(xs, "ab", n) * 2 }

effect Count {
  fn bump(n: Int) -> Int
}

// A clause that writes its state, then recurses past the gauge.
fn counting() -> Handler<Count> {
  handler Count {
    var hits = 0
    fn bump(n) {
      hits = hits + 1
      walk([1], "x", n) + hits
    }
  }
}

// A clause that can abort runs through frames, and so does a region reaching it: each state
// write happens once.
fn bumps(n: Int) -> Int { with counting() { Count.bump(3) + Count.bump(n) + Count.bump(3) } }

// Twins with open `with`s and no bound perform abort past the gauge: each closes its
// activations before its region runs again through frames.
fn deep(xs: List<Int>, n: Int) -> Int { with counting() { with counting() { walk(xs, "ab", n) } } }

fn mid(xs: List<Int>, n: Int) -> Int { with counting() { deep(xs, n) + 1 } }

// A callback with a bound perform has no closure twin: `List.map`'s twin is abandoned before
// the perform, whose trace record is written once.
fn tally(xs: List<Int>) -> List<Int> {
  List.map(xs, fn(x) {
    (with counting() { Count.bump(1) }) + (if x == 2 { walk(xs, "t", 200000) } else { 0 })
  })
}

// A callback's twin aborting at element two: `List.map`'s twin frees what it built.
fn deep_at_two(xs: List<Int>) -> List<Int> {
  List.map(xs, fn(x) { if x == 2 { walk(xs, "m", 200000) } else { x } })
}

pub fn main() -> Unit ! {Console} {
  let xs = [1, 2, 3]
  Console.print("{walk(xs, "hello", 10)} {walk(xs, "hello", 200000)} {xs}")
  let a = fold_acc(Acc { total: 0, label: "acc" }, 1000)
  Console.print("{a.total} {a.label} {deep_acc(a, 100000)}")
  Console.print("{half(2.5, 10)} {half(2.5, 100000)}")
  var i = 0
  var t = 0
  while i < 20 {
    t = t + shallow(xs, 5000)
    i = i + 1
  }
  Console.print("{t} {shallow(xs, 3)}")
  Console.print("{bumps(3)} {bumps(200000)}")
  // Under a frame's `with`, the clause runs through frames: each write happens once.
  with counting() {
    let a = Count.bump(200000)
    let b = Count.bump(3)
    Console.print("{a} {b}")
  }
  Console.print("{mid(xs, 200000)} {mid(xs, 3)}")
  with counting() {
    // Performed through a lambda, so found from the frame's activation after the inner `with`.
    let probe = fn(n: Int) -> Int { Count.bump(n) }
    with counting() {
      let c = Count.bump(2)
      let d = mid(xs, 200000)
      let e = Count.bump(3)
      Console.print("{c} {d} {e}")
    }
    Console.print("{probe(0)}")
  }
  Console.print("{deep_at_two([1, 2, 3])}")
  // A callback that performs has no twin: `List.map`'s twin is abandoned before it calls it.
  let seen = List.map([1, 2, 3], fn(x) {
    Console.print("saw {x}")
    x * 2
  })
  Console.print("{seen}")
  Console.print("{tally(xs)}")
}
