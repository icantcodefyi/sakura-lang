// milestone: M1
// covers: VarStmt ForStmt WhileStmt JumpStmt AssignStmt

// `break`/`continue` leave the loop body's own `var`s behind: only the `var`s declared outside
// the loop are carried to the next iteration (found by sakura_eval's differential generator).
pub fn main() -> Unit ! {Console} {
  var u = 0
  for i in 0..3 {
    var t = 0
    for j in 0..2 { t = t + 1 }
    if i == 1 { continue }
    u = u + t
  }
  Console.print("for {u}")
  var w = 0
  while w < 5 {
    w = w + 1
    var t = 10
    t = t + w
    if w == 2 { continue }
    if w == 4 { break }
    u = u + t
  }
  Console.print("while {u} {w}")
  for k in 0..3 {
    let x = {
      var t = k
      t = t + 1
      if k == 1 { break }
      t
    }
    Console.print("block {x}")
  }
}
