    ("http://foo/abcd?efgh?ijkl", Some("http://example.org/foo/bar"), true),
    ("http://2001::1]", Some("http://example.org/foo/bar"), false),
    ("http://[0:0:0:0:0:0:13.1.68.3]", Some("http://example.org/foo/bar"), true),
    ("madeupscheme:/example.com/", Some("http://example.org/foo/bar"), true),
    ("ftps:/example.com/", Some("http://example.org/foo/bar"), true),
    ("mailto:/example.com/", Some("http://example.org/foo/bar"), true),
    ("gopher:example.com/", Some("http://example.org/foo/bar"), true),
    ("/a/b/c", Some("http://example.org/foo/bar"), true),
