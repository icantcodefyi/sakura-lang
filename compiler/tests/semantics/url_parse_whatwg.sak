// milestone: M3
// spec: RFC 0002 §2.2
// Spec: https://url.spec.whatwg.org/#concept-basic-url-parser

// 150 cases of WPT's urltestdata.json (`tests/vectors/url.jsonl`): each input is parsed,
// against its base when it has one, and printed as the standard's components (href, protocol,
// username, password, hostname, port, pathname, search, hash, and the origin when the case
// names one), so `.stdout` is the upstream expectation. `to_string` omits the password, so the
// expected href does too. The cases and `.stdout` are generated from the table; edit neither
// by hand (`SAKURA_BLESS=1 cargo test -p sakura_cli --test semantics url_vectors`).
import std/url.{Url, UrlParts}

fn row(p: UrlParts, with_origin: Bool) -> String {
  let password = p.password.map(fn(s) { Secret.expose(s, @trust("the conformance check")) })
  let fields = [
    Url.to_string(p),
    p.scheme + ":",
    p.username,
    password.unwrap_or(""),
    p.host.unwrap_or(""),
    p.port.map(fn(n) { Int.to_string(n) }).unwrap_or(""),
    p.path,
    p.query.map(fn(q) { if q == "" { "" } else { "?" + q } }).unwrap_or(""),
    p.fragment.map(fn(f) { if f == "" { "" } else { "#" + f } }).unwrap_or(""),
  ]
  let all = if with_origin { List.push(fields, Url.origin(p)) } else { fields }
  List.join(all, " | ")
}

pub fn main() -> Unit ! {Console} {
  // BEGIN generated from tests/vectors/url.jsonl: (input, base, the case names an origin)
  let cases = [
    ("http://example\u{9}.\u{A}org", Some("http://example.org/foo/bar"), true),
    ("non-special://:@test/x", None, true),
    ("lolscheme:x x#x x", None, false),
    ("http://f: /c", Some("http://example.org/foo/bar"), false),
    ("", Some("http://example.org/foo/bar"), true),
    (":/", Some("http://example.org/foo/bar"), true),
    ("#;?", Some("http://example.org/foo/bar"), true),
    ("\\x", Some("http://example.org/foo/bar"), true),
    ("http://\u{E9}@example.com", None, true),
    ("http:\\\\foo.com\\", Some("http://example.org/foo/bar"), true),
