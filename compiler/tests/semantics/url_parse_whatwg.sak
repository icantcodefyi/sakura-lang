    ("http://example.org/test?>", None, false),
    ("a", None, false),
    ("test-a-colon-slash.html", Some("a:/"), false),
    ("non-spec:/test?a#b\u{0}c", None, false),
    ("#link", Some("https://example.org/##link"), false),
    ("wss:// !\"$%&'()*+,-.;<=>@[]^_`\{|\}~@host/", None, true),
    ("wss://host/ !\"$%&'()*+,-./:;<=>@[\\]^_`\{|\}~", None, true),
    ("abc:rootless", Some("abc:/path"), false),
    ("http://1.2.3.4.5", Some("http://other.com/"), false),
    ("http://1.2.3.08", None, false),
    ("http://01.2.3.4.5.", None, false),
    ("http://foo.1.2.3.4.", None, false),
    ("http://foo.0x4.", None, false),
    ("https://\u{0}y", None, false),
    ("https://x/\u{FFFF}y", None, false),
    ("non-special:x/?#\u{0}y", None, false),
    ("https://example.com/\"quoted\"", None, true),
    ("data://example.com:8080/pathname?search#hash", None, true),
    ("javascript://example.com:8080/pathname?search#hash", None, true),
    ("mailto://example.com:8080/pathname?search#hash", None, true),
    ("mailto://[:1]", None, false),
    ("intent://[:1]", None, false),
    ("urn://[:1]", None, false),
    ("turn://[:1]", None, false),
    ("stun://[:1]", None, false),
    ("steam://x:0/a", None, true),
    ("chrome-native://x:0", None, true),
    ("///\\//\\//test", Some("http://example.org/"), false),
    ("/\\/\\//example.org/../path", Some("http://example.org/"), false),
    ("non-special:\\\\opaque\\path", None, true),
    ("\\/a", Some("foo://foo/a"), false),
  ]
  // END generated
  for c in List.enumerate(cases) {
    let (input, base, with_origin) = c.1
    let parsed = match base {
      None => Url.parse(input),
      Some(b) => {
        match Url.parse(b) {
          Ok(bp) => Url.resolve(bp, input),
          Err(e) => Err(e),
        }
      },
    }
    match parsed {
      Ok(p) => Console.print("{c.0}: {row(p, with_origin)}"),
      Err(_) => Console.print("{c.0}: failure"),
    }
  }
}
