      "sc://\u{1}\u{2}\u{3}\u{4}\u{5}\u{6}\u{7}\u{8}\u{B}\u{C}\u{E}\u{F}\u{10}\u{11}\u{12}\u{13}\u{14}\u{15}\u{16}\u{17}\u{18}\u{19}\u{1A}\u{1B}\u{1C}\u{1D}\u{1E}\u{1F}\u{7F}!\"$%&'()*+,-.;=_`\{\}~/",
      None,
      true,
    ),
    ("http://facebook.com/?foo=%7B%22abc%22", None, true),
    ("http:", Some("https://example.org/foo/bar"), false),
    ("http://foo.bar/baz?qux#foo>bar", None, true),
    ("http://192.168.257.com", Some("http://other.com/"), true),
    ("http://10000000000", Some("http://other.com/"), false),
