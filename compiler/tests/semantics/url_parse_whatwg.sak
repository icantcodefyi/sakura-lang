    ("/C|\\foo\\bar", Some("file:///tmp/mock/path"), false),
    ("file:///home/me", Some("file:///tmp/mock/path"), false),
    ("file://localhost/", Some("file:///tmp/mock/path"), false),
    ("file:///w|/m", None, false),
    ("http://example.com/foo/./", None, true),
    ("http://example.com/foo/bar/../ton/../../a", None, true),
    ("http://example.com////../..", None, true),
    ("http://example.com/foo%2", None, true),
    ("http://example.com/(%28:%3A%29)", None, true),
    ("http://example.com/\u{4F60}\u{597D}\u{4F60}\u{597D}", None, true),
    ("data:test# \u{BB}", None, true),
    ("http://user:pass@/", None, false),
    ("http://foo:-80/", None, false),
    ("gopher://foo:443/", None, true),
    ("wss://foo:81/", None, true),
    ("madeupscheme:/example.com/", None, true),
    ("data:/example.com/", None, true),
    ("https:example.com/", None, true),
    ("data:example.com/", None, true),
    ("http://@www.example.com", None, true),
    ("http:/:b@www.example.com", None, true),
    ("http://@/www.example.com", None, false),
    ("http:a:@www.example.com", None, true),
    ("http:/@:www.example.com", None, false),
    ("..", Some("http://www.example.com/test"), true),
    ("\u{4E2D}/test.txt", Some("http://www.example.com/test"), true),
    ("file:.", None, false),
    ("http://[:]", Some("http://other.com/"), false),
    ("non-special:opaque  x?hi", None, true),
    ("http://\u{FDD0}zyx.com", Some("http://other.com/"), false),
    ("http://%ef%bc%85%ef%bc%94%ef%bc%91.com", Some("http://other.com/"), false),
    ("http://hello%00", Some("http://other.com/"), false),
    ("https://x x:12", None, false),
    ("http://[::1.2.3.4x]", Some("http://other.com/"), false),
    ("http://[::%31]", Some("http://other.com/"), false),
    ("http://\u{1F600}@host/", None, true),
    ("#x", Some("about:blank"), true),
    ("http://host/?'", None, true),
    ("i", Some("sc:sd/sd"), false),
    ("../i", Some("sc:/pa/pa"), true),
    ("/i", Some("sc://ho/pa"), true),
