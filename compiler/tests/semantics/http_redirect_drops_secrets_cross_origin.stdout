  https://a.example/start secret ["x-api-key", "authorization"] headers ["Authorization", "X-Api-Key", "accept"]
  https://a.example/same secret ["x-api-key", "authorization"] headers ["Authorization", "X-Api-Key", "accept"]
  https://a.example:8443/port secret [] headers ["accept"]
  https://a.example/back secret [] headers ["accept"]
Ok(200)
