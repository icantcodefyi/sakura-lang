// covers: Defect; design §4.1; §17.260 (G05): `MIN / -1` is D001

fn min() -> Int { -9_223_372_036_854_775_807 - 1 }

fn neg_one() -> Int { 0 - 1 }

pub fn main() -> Unit ! {Console} {
  Console.print("before")
  Console.print("{min() / neg_one()}")
  Console.print("never printed")
}
