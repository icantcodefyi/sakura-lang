// milestone: M3
// expect-exit: 70
// expect-defect: D020
// spec: RFC 0002 §2.5, §6 (`capacity`/`max_lag` required); design §7.2, §17.280 (4); plan web-apis.md phase 10

// `tee`'s lag bound is explicit and positive: `max_lag` 0 is the caller's defect (`D020`,
// blaming this call), checked before any task starts or any item is pulled.
import std/stream.{Source}

pub fn main() -> Unit ! {Console, Task} {
  let src: Source<Int, {}> = Source.from_list([1, 2, 3])
  Console.print("before")
  let n = src.tee(0, fn(a, _b) { a.fold(0, fn(acc, x) { acc + x }) })
  Console.print("never {n}")
}
