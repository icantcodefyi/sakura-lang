// milestone: M3
// expect-exit: 70
// expect-defect: D020
// covers: performance-r1 WS-S; design §17.111–§17.116

// A call through a function value passes no site (design §17.115): the clause is primary.
fn positive(x: Int) -> Int
  requires nonzero: x > 0
  ensures result > 0
{ x }

pub fn main() -> Unit ! {Console} { let _ = List.map([0], positive) }
