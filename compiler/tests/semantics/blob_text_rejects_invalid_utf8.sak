// milestone: M3
// spec: RFC 0002 §2.3
// Spec: https://w3c.github.io/FileAPI/#text-method-algo

// `Blob.text` is strict where the File API substitutes U+FFFD: a malformed UTF-8 sequence is
// `Utf8Error` with its byte offset in the blob, counting a leading byte order mark. Decoding
// with replacement is `Encoding.decode(b.bytes, Encoding.Utf8, Errors.Replace)`.
import std/blob.{Blob}
import std/encoding.{Encoding, Errors}

pub fn main() -> Unit ! {Console} {
  for bytes in [
    [0x61, 0xC3, 0x28],
    [0xEF, 0xBB, 0xBF, 0x61, 0xFF],
    [0xED, 0xA0, 0x80],
    [0xF0, 0x9F, 0x98],
    [0xEF, 0xBB],
  ] {
    let b = Blob.of(Bytes.from_list(bytes), "text/plain")
    let replaced = Encoding.decode(b.bytes, Encoding.Utf8, Errors.Replace).map(String.chars)
    Console.print("{Blob.text(b)} / {replaced}")
  }
}
