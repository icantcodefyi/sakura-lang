// milestone: M3
// expect-exit: 70
// expect-defect: D020
// spec: RFC 0002 §1; plan web-apis.md phase 8
// Spec: https://websockets.spec.whatwg.org/#dom-websocket-close

// `close`'s code is 1000 or 3000 to 4999 and its reason at most 123 bytes (`closable`): which
// code a program passes is a fact about the program, so another one is the caller's defect
// (`requires`), as `close()` throws `InvalidAccessError` on the web.
import std/websocket.{WebSocket}

pub fn main() -> Unit ! {Console} {
  Console.print("{WebSocket.closable(1000, "")} {WebSocket.closable(1001, "")}")
  with WebSocket.scripted([]) {
    let _ = try {
      WebSocket.connect(
        "ws://example.test/",
        WebSocket.options(),
        fn(sock) { WebSocket.close(sock, 1001, "going away") },
      )
    }
  }
}
