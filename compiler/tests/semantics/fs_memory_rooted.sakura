// milestone: M3
// mode: test
// covers: WithExpr TryExpr Lambda

// Design §17.119: `Fs.memory(files)` is `Fs.rooted` over an in-memory directory, so `root()`,
// `Dir.subdir` and `Fs.rooted` compose exactly as on the host. `sakura test` runs this without
// `SAKURA_PERMISSIONS`: a memory directory needs no grants.

import std/fs.{Dir, Fs, FsError, Write}
import std/path.{Path}

fn files() -> List<(Path, Bytes)> {
  [
    (Path.of("data/a.txt"), String.to_bytes("hello world")),
    (Path.of("data/sub/b.txt"), String.to_bytes("b")),
    (Path.of("top.txt"), String.to_bytes("t")),
  ]
}

test "the §15.6 narrowing reads through the fake" {
  with Fs.memory(files()) {
    let r = try {
      with Fs.rooted(Dir.subdir(Fs.root(), "data")) {
        Untrusted.trust(Fs.read_text(Path.of("a.txt")), @trust("test"))
      }
    }
    expect_eq(r, Ok("hello world"))
  }
}

test "a write under the narrowed handler is visible to the outer one" {
  with Fs.memory(files()) {
    let wrote = try {
      with Fs.rooted(Dir.subdir(Fs.root(), "data")) { Fs.write(Path.of("x.txt"), String.to_bytes("x")) }
    }
    expect_eq(wrote, Ok(()))
    expect_eq(try { Fs.read(Path.of("data/x.txt")) }, Ok(String.to_bytes("x")))
  }
}

test "subdir needs an existing directory" {
  with Fs.memory(files()) {
    expect_fail(fn() { Dir.subdir(Fs.root(), "nope") }, FsError { path: "nope", reason: "no such directory" })
    expect_fail(
      fn() { Dir.subdir(Fs.root(), "data/a.txt") },
      FsError { path: "data/a.txt", reason: "not a directory" },
    )
    expect_eq(try { Fs.exists(Path.of("data/sub")) }, Ok(true))
    expect_fail(fn() { Fs.read(Path.of("data")) }, FsError { path: "data", reason: "is a directory" })
  }
}

test "a write into a missing directory fails as on the host" {
  with Fs.memory(files()) {
    expect_fail(
      fn() { Fs.write(Path.of("missing/x.txt"), String.to_bytes("x")) },
      FsError { path: "missing/x.txt", reason: "not found" },
    )
    expect(!Fs.exists(Path.of("missing")))
  }
}

error Abort

test "a failing with_file body leaves what it wrote" {
  with Fs.memory(files()) {
    let r = try {
      Fs.with_file(Path.of("top.txt"), Write, fn(f) {
        Fs.write_chunk(f, String.to_bytes("ab"))
        expect_eq(try { Fs.read(Path.of("top.txt")) }, Ok(String.to_bytes("ab")))
        Fs.write_chunk(f, String.to_bytes("c"))
        fail Abort
      })
    }
    expect(r.is_err())
    expect_eq(try { Fs.read(Path.of("top.txt")) }, Ok(String.to_bytes("abc")))
  }
}

test "one handler value is one store; each expression is a fresh one" {
  let fake = Fs.memory([])
  with fake { expect_eq(try { Fs.write(Path.of("x.txt"), String.to_bytes("x")) }, Ok(())) }
  with fake { expect(Fs.exists(Path.of("x.txt"))) }
  with Fs.memory([]) { expect(!Fs.exists(Path.of("x.txt"))) }
}

test "list returns files and implied directories, sorted" {
  with Fs.memory(files()) {
    let names = try { List.map(Fs.list(Path.of(".")), fn(e) { (e.name, e.is_dir) }) }
    expect_eq(names, Ok([("data", true), ("top.txt", false)]))
    let inner = try {
      with Fs.rooted(Dir.subdir(Fs.root(), "data")) { List.map(Fs.list(Path.of(".")), fn(e) { e.name }) }
    }
    expect_eq(inner, Ok(["a.txt", "sub"]))
  }
}
