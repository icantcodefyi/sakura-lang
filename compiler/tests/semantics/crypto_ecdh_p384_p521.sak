// milestone: M3
// spec: RFC 0002 §2.7
// Spec: https://www.rfc-editor.org/rfc/rfc5903#section-8.2

// ECDH over P-384 and P-521 (`tests/vectors/ecdh_p384.txt`, `ecdh_p521.txt`, RFC 5903 §8.2 and
// §8.3): each side's `derive_bits` with the other's public key is the RFC's shared x-coordinate,
// 384 or 528 bits, compared and never printed; one more byte is `Length`. The private keys are
// PKCS #8 without their public key and the public keys raw points. Two pairs generated under one
// seed agree the same way (on P-521 the draw's top seven bits are cleared, the order being just
// under 2^521). On native, which has no tier 2, `import_key` answers `Unavailable(...)` and no pair is generated (`.native.stdout`, RFC 0002 §2.7's declared difference). Generated from the tables.
import std/crypto
import std/crypto.{Algorithm, Curve, DeriveParams, KeyFormat, Usage}

pub fn main() -> Unit ! {Console} {
  for (bits, i, r, gi, gr, shared) in [
    (
      384,
      "304e020100301006072a8648ce3d020106052b81040022043730350201010430099f3c7034d4a2c699884d73a375a67f7624ef7c6b3c0f160647b67414dce655e35b538041e649ee3faef896783ab194",
      "304e020100301006072a8648ce3d020106052b8104002204373035020101043041cb0779b4bdb85d47846725fbec3c9430fab46cc8dc5060855cc9bda0aa2942e0308312916b8ed2960e4bd55a7448fc",
      "04667842d7d180ac2cde6f74f37551f55755c7645c20ef73e31634fe72b4c55ee6de3ac808acb4bdb4c88732aee95f41aa9482ed1fc0eeb9cafc4984625ccfc23f65032149e0e144ada024181535a0f38eeb9fcff3c2c947dae69b4c634573a81c",
      "04e558dbef53eecde3d3fccfc1aea08a89a987475d12fd950d83cfa41732bc509d0d1ac43a0336def96fda41d0774a3571dcfbec7aacf3196472169e838430367f66eebe3c6e70c416dd5f0c68759dd1fff83fa40142209dff5eaad96db9e6386c",
      "11187331c279962d93d604243fd592cb9d0a926f422e47187521287e7156c5c4d603135569b9e9d09cf5d4a270f59746",
    ),
    (
      521,
      "3060020100301006072a8648ce3d020106052b810400230449304702010104420037ade9319a89f4dabdb3ef411aaccca5123c61acab57b5393dce47608172a095aa85a30fe1c2952c6771d937ba9777f5957b2639bab072462f68c27a57382d4a52",
      "3060020100301006072a8648ce3d020106052b810400230449304702010104420145ba99a847af43793fdd0e872e7cdfa16be30fdc780f97bccc3f078380201e9c677d600b343757a3bdbf2a3163e4c2f869cca7458aa4a4effc311f5cb151685eb9",
      "040015417e84dbf28c0ad3c278713349dc7df153c897a1891bd98bab4357c9ecbee1e3bf42e00b8e380aeae57c2d107564941885942af5a7f4601723c4195d176ced3e017cae20b6641d2eeb695786d8c946146239d099e18e1d5a514c739d7cb4a10ad8a788015ac405d7799dc75e7b7d5b6cf2261a6a7f1507438bf01beb6ca3926f9582",
      "0400d0b3975ac4b799f5bea16d5e13e9af971d5e9b984c9f39728b5e5739735a219b97c356436adc6e95bb0352f6be64a6c2912d4ef2d0433ced2b6171640012d9460f015c68226383956e3bd066e797b623c27ce0eac2f551a10c2c724d9852077b87220b6536c5c408a1d2aebb8e86d678ae49cb57091f4732296579ab44fcd17f0fc56a",
      "01144c7d79ae6956bc8edb8e7c787c4521cb086fa64407f97894e5e6b2d79b04d1427e73ca4baa240a34786859810c06b3c715a3a8cc3151f2bee417996d19f3ddea",
    ),
  ] {
    let alg = curve(bits)
    let full = if bits == 384 { 384 } else { 528 }
    let private = fn(der) {
      crypto.import_key(KeyFormat.Pkcs8, alg, [Usage.DeriveBits], false, Secret.of(unhex(der)))
    }
    let public = fn(point) {
      crypto.import_key(KeyFormat.Raw, alg, [], true, Secret.of(unhex(point)))
    }
    match (private(i), private(r), public(gi), public(gr)) {
      (Ok(i), Ok(r), Ok(gi), Ok(gr)) => {
        let ab = crypto.derive_bits(i, DeriveParams.EcdhWith(gr), full)
        let ba = crypto.derive_bits(r, DeriveParams.EcdhWith(gi), full)
        let over = crypto.derive_bits(i, DeriveParams.EcdhWith(gr), full + 8)
        Console.print(
          "P-{bits} initiator {ab == Ok(unhex(shared))} responder {ba == Ok(unhex(shared))} {over}",
        )
        let (a, b) = with Random.seeded(5) {
          (
            crypto.generate_key_pair(alg, [Usage.DeriveBits], false),
            crypto.generate_key_pair(alg, [Usage.DeriveBits], false),
          )
        }
        let x = crypto.derive_bits(a.private, DeriveParams.EcdhWith(b.public), full)
        let y = crypto.derive_bits(b.private, DeriveParams.EcdhWith(a.public), full)
        Console.print("P-{bits} generated agree {x == y} {x.map(Bytes.len)}")
      },
      (Err(e), _, _, _) => Console.print("P-{bits} {e}"),
      _ => Console.print("P-{bits} the RFC's keys do not import"),
    }
  }
}

fn curve(bits: Int) -> Algorithm {
  if bits == 384 { Algorithm.Ecdh(Curve.P384) } else { Algorithm.Ecdh(Curve.P521) }
}

fn hex(b: Bytes) -> String {
  let digits = "0123456789abcdef"
  var out = ""
  for i in 0..Bytes.len(b) {
    let x = Bytes.get(b, i).unwrap_or(0)
    out = out + String.slice(digits, x / 16, x / 16 + 1) + String.slice(digits, x % 16, x % 16 + 1)
  }
  out
}

fn unhex(s: String) -> Bytes {
  var out: List<Int> = []
  for i in 0..String.len(s) / 2 {
    out = out.push(
      nibble(String.slice(s, 2 * i, 2 * i + 1)) * 16
        + nibble(String.slice(s, 2 * i + 1, 2 * i + 2)),
    )
  }
  Bytes.from_list(out)
}

fn nibble(c: String) -> Int {
  var v = 0
  for d in 0..16 { if String.slice("0123456789abcdef", d, d + 1) == c { v = d } }
  v
}

/// `b` with bit 4 of byte `at` flipped.
fn flip(b: Bytes, at: Int) -> Bytes {
  let x = Bytes.get(b, at).unwrap_or(0)
  let y = if x / 16 % 2 == 1 { x - 16 } else { x + 16 }
  Bytes.concat([Bytes.slice(b, 0, at), Bytes.from_list([y]), Bytes.slice(b, at + 1, Bytes.len(b))])
}
