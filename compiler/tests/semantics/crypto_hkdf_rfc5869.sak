// milestone: M3
// spec: RFC 0002 §2.7
// Spec: https://www.rfc-editor.org/rfc/rfc5869#appendix-A

// RFC 5869 test cases 1-3, HKDF-SHA-256 (the table in `tests/vectors/hkdf.txt`); case 3 has an
// empty salt and info. `derive_bits` takes bits, so L bytes is 8 * L. Generated from the table.
import std/crypto
import std/crypto.{Algorithm, DeriveParams, Digest, HkdfParams, KeyFormat, Usage}

pub fn main() -> Unit ! {Console} {
  for (case, ikm, salt, info, len) in [
    (
      "1",
      "0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b",
      "000102030405060708090a0b0c",
      "f0f1f2f3f4f5f6f7f8f9",
      42,
    ),
    (
      "2",
      "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f",
      "606162636465666768696a6b6c6d6e6f707172737475767778797a7b7c7d7e7f808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9fa0a1a2a3a4a5a6a7a8a9aaabacadaeaf",
      "b0b1b2b3b4b5b6b7b8b9babbbcbdbebfc0c1c2c3c4c5c6c7c8c9cacbcccdcecfd0d1d2d3d4d5d6d7d8d9dadbdcdddedfe0e1e2e3e4e5e6e7e8e9eaebecedeeeff0f1f2f3f4f5f6f7f8f9fafbfcfdfeff",
      82,
    ),
    ("3", "0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b", "", "", 42),
  ] {
    let alg = Algorithm.Hkdf(Digest.Sha256)
    match crypto.import_key(KeyFormat.Raw, alg, [Usage.DeriveBits], false, Secret.of(unhex(ikm))) {
      Ok(k) => {
        let params = DeriveParams.HkdfWith(HkdfParams { salt: unhex(salt), info: unhex(info) })
        Console.print("{case} {crypto.derive_bits(k, params, 8 * len).map(hex)}")
      },
      Err(e) => Console.print("{case} {e}"),
    }
  }
}

fn hex(b: Bytes) -> String {
  let digits = "0123456789abcdef"
  var out = ""
  for i in 0..Bytes.len(b) {
    let x = Bytes.get(b, i).unwrap_or(0)
    out = out + String.slice(digits, x / 16, x / 16 + 1) + String.slice(digits, x % 16, x % 16 + 1)
  }
  out
}

fn unhex(s: String) -> Bytes {
  var out: List<Int> = []
  for i in 0..String.len(s) / 2 {
    out = out.push(
      nibble(String.slice(s, 2 * i, 2 * i + 1)) * 16
        + nibble(String.slice(s, 2 * i + 1, 2 * i + 2)),
    )
  }
  Bytes.from_list(out)
}

fn nibble(c: String) -> Int {
  var v = 0
  for d in 0..16 { if String.slice("0123456789abcdef", d, d + 1) == c { v = d } }
  v
}
