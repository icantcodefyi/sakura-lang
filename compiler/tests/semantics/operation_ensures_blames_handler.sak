// milestone: M3
// expect-exit: 70
// expect-defect: D021
// spec: design §7.2, §17.286 (8)

// An operation's `ensures` is checked when a perform returns normally: a handler that answers
// outside it is the callee's defect (`D021`, naming the operation and the clause).
effect Meter {
  fn take(n: Int) -> Int
    ensures bounded: result <= n
}

fn overshooting() -> Handler<Meter> {
  handler Meter {
    fn take(n) { n + 1 }
  }
}

pub fn main() -> Unit ! {Console} {
  with overshooting() {
    Console.print("before")
    Console.print("{Meter.take(1)}")
  }
}
