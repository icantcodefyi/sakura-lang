// milestone: M3
// expect-exit: 70
// expect-defect: D030
// expect-stderr: tok-SENSITIVE-123
// covers: Secret
// Design §17.159 (2): a pure `f` under `Secret.map` cannot perform, but its defect message can
// carry the clear value. The leak is audited (the `@trust` reason), not prevented.

pub fn main() -> Unit ! {Console} {
  Console.print("before")
  let token = Secret.of("tok-SENSITIVE-123")
  let _ = Secret.map(
    token,
    fn(t) { Option.expect(None, t) },
    @trust("probe: a defect prints the value"),
  )
  Console.print("never printed")
}
