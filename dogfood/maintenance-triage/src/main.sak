      "drill-press-belt-slip",
      "jointer-belt-squeal",
      "lathe-belt-cover",
      "planer-belt-wear",
    ],
  )
  expect_eq(List.map(search_entries(fixture_entries(), "belt"), fn(h) { h.id }), ids)
  expect_eq(search_entries(fixture_entries(), "xy"), [])
}

