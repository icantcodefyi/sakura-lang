fn charge(card: Card, amount: Int) -> Receipt ! {Payments, Fail<CheckoutError>} {
  Payments.charge(card, amount)
}

fn checkout(cart: Cart, card: Card) -> Receipt ! {Payments, Fail<CheckoutError>} {
  let total = List.fold(cart.items, 0, fn(sum, i) { sum + i.price })
  ?receipt
}
// @landing-context holes

type Item = { name: String, price: Int }
type Cart = { items: List<Item> }
type Card = { token: String }
type Receipt = { id: String, total: Int }
error Declined
error Expired
type CheckoutError = Declined | Expired
effect Payments {
  fn charge(card: Card, amount: Int) -> Receipt ! {Fail<CheckoutError>}
}
