pub fn charge(card: Card, amount: Cents) -> Receipt ! {Http, Payments, Fail<ChargeError>}
// @landing-context
{
  let _ = try { Http.get("https://status.example/ping") } catch { _ => fail Declined }
  Payments.charge(card, amount)
}

import std/http.{Http}

type Cents = Int where it >= 0
type Card = { token: String }
type Receipt = { id: String, amount: Cents }
error Declined
type ChargeError = Declined

effect Payments {
  fn charge(card: Card, amount: Cents) -> Receipt ! {Fail<ChargeError>}
}
