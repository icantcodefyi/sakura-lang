* text=auto eol=lf

*.sh text eol=lf
*.rs text eol=lf
*.md text eol=lf
*.mdx text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Keep text lockfile diffs reviewable; omit them from language statistics.
Cargo.lock text eol=lf linguist-generated=true
bun.lock text eol=lf linguist-generated=true
bun.lockb binary linguist-generated=true
package-lock.json text eol=lf linguist-generated=true
yarn.lock text eol=lf linguist-generated=true
pnpm-lock.yaml text eol=lf linguist-generated=true

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf binary

# Snapshots are byte-exact data (design §17.196 (1)).
*.snap -text

# Line-ending fixtures keep their bytes (design §17.180 (4b)).
compiler/tests/semantics/line_endings_crlf.sak -text whitespace=cr-at-eol
