error BadCount(text: String)

fn parse_count(text: String) -> Int ! {Fail<BadCount>} {
  match String.parse_int(text) {
    Some(n) => n,
    None => fail BadCount { text },
  }
}
pub fn recover(text: String, fallback: Int) -> Int {
  try { parse_count(text) } catch { BadCount { .. } => fallback }
}

test "visible example" {
  expect_eq(recover("bad", 6), 6)
}
