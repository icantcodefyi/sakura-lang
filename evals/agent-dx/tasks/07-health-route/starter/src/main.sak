import std/request.{Get, Request, Text}
import std/response.{Response}
import std/router.{Router}
import std/url.{Url}

fn version(req: Request) -> Response { Response.status(200, "v1") }
pub fn app() -> Router<{}> {
  Router.new().get("/version", version)
}

test "visible example" {
  expect_eq(Router.handle(app(), Request.of(Get, Url.from("/version"))).body, Text("v1"))
}
