import std/cli.{Cli, CliError}

type Args = { name: String, upper: Bool, prefix: Option<String> }
pub fn render(args: List<String>) -> String ! {Fail<CliError>} {
  let parsed: Args = Cli.parse(args)
  if parsed.upper { String.to_upper(parsed.name) } else { parsed.name }
}

test "visible example" {
  expect_eq(render(["--name", "Mina"]), "Mina")
}
