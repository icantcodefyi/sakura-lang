// Mandelbrot from Are We Fast Yet (smarr/are-we-fast-yet@74306fec benchmarks/JavaScript/
// mandelbrot.js, itself adapted from the Benchmarks Game's Ruby program contributed by Karl von
// Laudermann and modified by Jeremy Echols, Detlef Reichl, Joseph LaFata and Peter Zotov; revised
// BSD licence, Copyright © 2004-2013 Brent Fulgham). run(n) is AWFY's mandelbrot(n): the XOR of
// every output byte of an n×n bitmap, 50 iterations per point.
// Deviation: Sakura Lang has no bitwise operators, so `byteAcc << 1` is `byte_acc * 2`,
// `byteAcc <<= (8 - bitNum)` is a multiplication by 2^(8 - bit_num), and `sum ^= byteAcc` is
// `xor`, a loop over the bits of two bytes (once per eight points; the ports use `^`).
import std/cli.{Cli}

/// a XOR b for 0 <= a, b, digit by binary digit.
fn xor(a: Int, b: Int) -> Int {
  var x = a
  var y = b
  var bit = 1
  var r = 0
  while x > 0 || y > 0 {
    if x % 2 != y % 2 { r = r + bit }
    x = x / 2
    y = y / 2
    bit = bit * 2
  }
  r
}

fn mandelbrot(size: Int) -> Int {
  var sum = 0
  var byte_acc = 0
  var bit_num = 0
  var y = 0
  while y < size {
    let ci = 2.0 * Int.to_float(y) / Int.to_float(size) - 1.0
    var x = 0
    while x < size {
      var zrzr = 0.0
      var zi = 0.0
      var zizi = 0.0
      let cr = 2.0 * Int.to_float(x) / Int.to_float(size) - 1.5
      var z = 0
      var not_done = true
      var escape = 0
      while not_done && z < 50 {
        let zr = zrzr - zizi + cr
        zi = 2.0 * zr * zi + ci
        // preserve recalculation
        zrzr = zr * zr
        zizi = zi * zi
        if zrzr + zizi > 4.0 {
          not_done = false
          escape = 1
        }
        z = z + 1
      }
      byte_acc = byte_acc * 2 + escape
      bit_num = bit_num + 1
      // Separate blocks skip the shift when it is unnecessary, which is most cases.
      if bit_num == 8 {
        sum = xor(sum, byte_acc)
        byte_acc = 0
        bit_num = 0
      } else if x == size - 1 {
        byte_acc = byte_acc * Int.pow(2, 8 - bit_num)
        sum = xor(sum, byte_acc)
        byte_acc = 0
        bit_num = 0
      }
      x = x + 1
    }
    y = y + 1
  }
  sum
}

pub fn run(n: Int) -> Int { mandelbrot(n) }

pub fn main() -> Unit ! {Cli, Console} {
  for arg in Cli.args() { Console.print("{run(Option.expect(String.parse_int(arg), "size"))}") }
}
