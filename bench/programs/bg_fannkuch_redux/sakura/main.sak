// fannkuch-redux, the Benchmarks Game's task (benchmarksgame-team.pages.debian.net/
// benchmarksgame/description/fannkuchredux.html): for every permutation of 0..n−1, in the
// task's order (rotations counted in count[], the next permutation made incrementally), flip the
// first k + 1 elements until the first is 0; keep the maximum flip count and the checksum
// (+flips for even permutation indices, −flips for odd). Follows the task description
// (Oleg Mazurov's count[] order, as the task page credits him). Sakura Lang
// has no mutable arrays, so perm, perm1 and count are persistent Lists updated with `List.set`
// (perm = perm1 shares the list and the first flip copies it, where Java copies it element by
// element). Deviation: for n = 0 (where the Java program indexes count[−1]) the checksum and the
// maximum are 0. run(n) is the digest (bench/README.md) of the bytes the program writes for n.
import std/bytes.{Standard}
import std/cli.{Cli}

fn at(xs: List<Int>, i: Int) -> Int { Option.expect(xs[i], "index") }

/// (checksum, maximum flips) over all n! permutations.
fn fannkuch(n: Int) -> (Int, Int) {
  if n == 0 { return (0, 0) }
  var perm1 = List.range(0, n)
  var count = List.map(List.range(0, n), fn(_) { 0 })
  var max_flips = 0
  var perm_count = 0
  var checksum = 0
  var r = n
  while true {
    while r != 1 {
      count = List.set(count, r - 1, r)
      r = r - 1
    }
    var perm = perm1
    var flips = 0
    var k = at(perm, 0)
    while k != 0 {
      let k2 = (k + 1) / 2
      var i = 0
      while i < k2 {
        let t = at(perm, i)
        perm = List.set(perm, i, at(perm, k - i))
        perm = List.set(perm, k - i, t)
        i = i + 1
      }
      flips = flips + 1
      k = at(perm, 0)
    }
    max_flips = Int.max(max_flips, flips)
    checksum = if perm_count % 2 == 0 { checksum + flips } else { checksum - flips }
    // The next permutation: rotate the first r + 1 elements left until a level has rotations left.
    while true {
      if r == n { return (checksum, max_flips) }
      let perm0 = at(perm1, 0)
      var i = 0
      while i < r {
        perm1 = List.set(perm1, i, at(perm1, i + 1))
        i = i + 1
      }
      perm1 = List.set(perm1, r, perm0)
      count = List.set(count, r, at(count, r) - 1)
      if at(count, r) > 0 { break }
      r = r + 1
    }
    perm_count = perm_count + 1
  }
  (checksum, max_flips) // unreachable: the loop above returns
}

/// What the Benchmarks Game program writes for n.
fn text(n: Int) -> String {
  let (checksum, max_flips) = fannkuch(n)
  "{checksum}\nPfannkuchen({n}) = {max_flips}\n"
}

/// The suite's digest of an output: h = (31·h + byte) mod 1,000,000,007 over every byte.
fn digest(b: Bytes) -> Int {
  let len = Bytes.len(b)
  var h = 0
  var i = 0
  while i < len {
    h = (h * 31 + Option.expect(Bytes.get(b, i), "byte")) % 1000000007
    i = i + 1
  }
  h
}

pub fn run(n: Int) -> Int { digest(String.to_bytes(text(n))) }

/// The output for n as base64: `Console` writes lines of text, not raw bytes.
pub fn output(n: Int) -> String { Bytes.to_base64(String.to_bytes(text(n)), Standard, true) }

// `sakura run main.sak -- <n>...` prints run(n) for each argument; `-- output <n>` prints output(n).
pub fn main() -> Unit ! {Cli, Console} {
  let args = Cli.args()
  if List.first(args) == Some("output") {
    Console.print(output(Option.expect(String.parse_int(Option.expect(args[1], "size")), "size")))
  } else {
    for arg in args { Console.print("{run(Option.expect(String.parse_int(arg), "size"))}") }
  }
}
