// mandelbrot, the Benchmarks Game's task (benchmarksgame-team.pages.debian.net/benchmarksgame/
// description/mandelbrot.html): plot [-1.5-i, 0.5+i] on an n-by-n bitmap and write it as a
// portable bitmap (PBM P4), 50 iterations, escape when |z|² > 4, as the reference C program
// (contributed by Greg Buchholz) does. Sakura Lang has no bitwise operators, so the eight pixels
// of a byte are packed with arithmetic (`acc * 2 + bit`, and a row's last partial byte is scaled
// by 2^(8 - n % 8)), which gives the same bytes as the reference's shifts and ors. The output is
// binary (bytes 0x80 and over), so it is built as `Bytes`, one `Bytes.from_list` per row,
// joined once with `Bytes.concat`; `Console` has no raw byte output, so `output(n)` is base64.
// run(n) is the digest (bench/README.md) of the bytes the program writes for n.
import std/bytes.{Standard}
import std/cli.{Cli}

/// One row of packed pixels: bit 1 for a point inside the set, most significant bit first.
fn row(n: Int, y: Int) -> Bytes {
  let ci = 2.0 * Int.to_float(y) / Int.to_float(n) - 1.0
  var bytes: List<Int> = []
  var acc = 0
  var bits = 0
  var x = 0
  while x < n {
    let cr = 2.0 * Int.to_float(x) / Int.to_float(n) - 1.5
    var zr = 0.0
    var zi = 0.0
    var tr = 0.0
    var ti = 0.0
    var i = 0
    while i < 50 && tr + ti <= 4.0 {
      zi = 2.0 * zr * zi + ci
      zr = tr - ti + cr
      tr = zr * zr
      ti = zi * zi
      i = i + 1
    }
    acc = acc * 2 + (if tr + ti <= 4.0 { 1 } else { 0 })
    bits = bits + 1
    if bits == 8 {
      bytes = List.push(bytes, acc)
      acc = 0
      bits = 0
    } else if x == n - 1 {
      bytes = List.push(bytes, acc * Int.pow(2, 8 - n % 8))
      acc = 0
      bits = 0
    }
    x = x + 1
  }
  Bytes.from_list(bytes)
}

/// What the Benchmarks Game program writes for n.
fn bitmap(n: Int) -> Bytes {
  var parts = [String.to_bytes("P4\n{n} {n}\n")]
  var y = 0
  while y < n {
    parts = List.push(parts, row(n, y))
    y = y + 1
  }
  Bytes.concat(parts)
}

/// The suite's digest of an output: h = (31·h + byte) mod 1,000,000,007 over every byte.
fn digest(b: Bytes) -> Int {
  let len = Bytes.len(b)
  var h = 0
  var i = 0
  while i < len {
    h = (h * 31 + Option.expect(Bytes.get(b, i), "byte")) % 1000000007
    i = i + 1
  }
  h
}

pub fn run(n: Int) -> Int { digest(bitmap(n)) }

/// The output for n as base64: `Console` writes lines of text, not raw bytes.
pub fn output(n: Int) -> String { Bytes.to_base64(bitmap(n), Standard, true) }

// `sakura run main.sak -- <n>...` prints run(n) for each argument; `-- output <n>` prints output(n).
pub fn main() -> Unit ! {Cli, Console} {
  let args = Cli.args()
  if List.first(args) == Some("output") {
    Console.print(output(Option.expect(String.parse_int(Option.expect(args[1], "size")), "size")))
  } else {
    for arg in args { Console.print("{run(Option.expect(String.parse_int(arg), "size"))}") }
  }
}
