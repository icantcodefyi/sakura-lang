// Primes below n. Each prime p with p*p < n clears its multiples from p*p with `List.set`,
// which copies one trie path per write (design §17.126); the controls write the same indices
// in place.
import std/cli.{Cli}

pub fn run(n: Int) -> Int {
  var flags: List<Bool> = []
  var i = 0
  while i < n {
    flags = List.push(flags, i >= 2)
    i = i + 1
  }
  var p = 2
  while p * p < n {
    if Option.unwrap_or(flags[p], false) {
      var j = p * p
      while j < n {
        flags = List.set(flags, j, false)
        j = j + p
      }
    }
    p = p + 1
  }
  var count = 0
  for f in flags { if f { count = count + 1 } }
  count
}

// `sakura run main.sakura -- <n>...` prints run(n) for each argument.
pub fn main() -> Unit ! {Cli, Console} {
  for arg in Cli.args() { Console.print("{run(Option.expect(String.parse_int(arg), "size"))}") }
}
