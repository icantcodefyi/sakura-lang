// Record/variant/Option pipeline: n generated items, five rounds of `..` updates and matching.
import std/cli.{Cli}

type Shape = Circle(Int) | Rect(Int, Int) | Square(Int)
type Item = { id: Int, shape: Shape, tag: Option<Int> }

fn next(seed: Int) -> Int { seed * 48271 % 2147483647 }

fn area(s: Shape) -> Int {
  match s {
    Circle(r) => 3 * r * r,
    Rect(w, h) => w * h,
    Square(a) => a * a,
  }
}

fn grow(it: Item) -> Item {
  let shape = match it.shape {
    Circle(r) => Rect(r, r + 1),
    Rect(w, h) => Square((w + h) % 100),
    Square(a) => Circle(a % 50 + 1),
  }
  Item {
    ..it,
    shape,
    tag: match it.tag {
      Some(t) => if t > 5 { None } else { Some(t + 1) },
      None => Some(0),
    },
  }
}

pub fn run(n: Int) -> Int {
  var seed = 42
  var items: List<Item> = []
  var i = 0
  while i < n {
    seed = next(seed)
    let k = seed % 100
    let shape = if k < 33 { Circle(k) } else if k < 66 { Rect(k, k % 7 + 1) } else {
      Square(k % 13)
    }
    let tag = if k % 4 == 0 { None } else { Some(k % 9) }
    items = List.push(items, Item { id: i, shape, tag })
    i = i + 1
  }
  var total = 0
  var r = 0
  while r < 5 {
    items = List.map(items, grow)
    for it in items { total = total + area(it.shape) + Option.unwrap_or(it.tag, 0) + it.id % 3 }
    r = r + 1
  }
  total
}

// `sakura run main.sak -- <n>...` prints run(n) for each argument.
pub fn main() -> Unit ! {Cli, Console} {
  for arg in Cli.args() { Console.print("{run(Option.expect(String.parse_int(arg), "size"))}") }
}
