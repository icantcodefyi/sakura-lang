// Are We Fast Yet's Queens (smarr/are-we-fast-yet@74306fec benchmarks/JavaScript/queens.js;
// Copyright (c) 2015-2016 Stefan Marr, MIT, derived from the SOM benchmarks). run(n) runs
// AWFY's benchmark() n times and sums the results encoded as 1 for true and 0 for false
// (AWFY's verifyResult accepts true). Deviation, forced by Sakura Lang: objects and arrays are
// immutable, so the four array fields are a record threaded through placeQueen() and
// setRowColumn(), each a List built with AWFY's length and fill value and updated with
// `List.set` (AWFY writes them in place).
import std/cli.{Cli}

type Queens = {
  free_rows: List<Bool>,
  free_maxs: List<Bool>,
  free_mins: List<Bool>,
  queen_rows: List<Int>,
}

fn filled<A>(length: Int, value: A) -> List<A> {
  var xs: List<A> = []
  var i = 0
  while i < length {
    xs = List.push(xs, value)
    i = i + 1
  }
  xs
}

fn queens() -> Bool {
  let q = Queens {
    free_rows: filled(8, true),
    free_maxs: filled(16, true),
    free_mins: filled(16, true),
    queen_rows: filled(8, 0 - 1),
  }
  let (_, placed) = place_queen(q, 0)
  placed
}

fn place_queen(start: Queens, c: Int) -> (Queens, Bool) {
  var q = start
  var r = 0
  while r < 8 {
    if get_row_column(q, r, c) {
      q.queen_rows = List.set(q.queen_rows, r, c)
      q = set_row_column(q, r, c, false)

      if c == 7 { return (q, true) }

      let (next, placed) = place_queen(q, c + 1)
      q = next
      if placed { return (q, true) }
      q = set_row_column(q, r, c, true)
    }
    r = r + 1
  }
  (q, false)
}

fn get_row_column(q: Queens, r: Int, c: Int) -> Bool {
  Option.expect(q.free_rows[r], "row")
    && Option.expect(q.free_maxs[c + r], "max")
    && Option.expect(q.free_mins[c - r + 7], "min")
}

fn set_row_column(q: Queens, r: Int, c: Int, v: Bool) -> Queens {
  Queens {
    ..q,
    free_rows: List.set(q.free_rows, r, v),
    free_maxs: List.set(q.free_maxs, c + r, v),
    free_mins: List.set(q.free_mins, c - r + 7, v),
  }
}

fn benchmark() -> Bool {
  var result = true
  var i = 0
  while i < 10 {
    result = result && queens()
    i = i + 1
  }
  result
}

pub fn run(n: Int) -> Int {
  var sum = 0
  var i = 0
  while i < n {
    sum = sum + (if benchmark() { 1 } else { 0 })
    i = i + 1
  }
  sum
}

// `sakura run main.sak -- <n>...` prints run(n) for each argument.
pub fn main() -> Unit ! {Cli, Console} {
  for arg in Cli.args() { Console.print("{run(Option.expect(String.parse_int(arg), "size"))}") }
}
