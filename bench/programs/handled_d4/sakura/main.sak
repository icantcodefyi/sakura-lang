// A hot loop performing Tick, whose handler is 4 frame(s) from the perform (3 unrelated
// handlers installed inside it). run(n) = sum of (counter % 7) over n operations.
import std/cli.{Cli}

effect Tick {
  fn next() -> Int
}

fn counter() -> Handler<Tick> {
  handler Tick {
    var value = 0
    fn next() {
      value = value + 1
      value
    }
  }
}

effect Pad1 {
  fn pad() -> Int
}

fn pad1() -> Handler<Pad1> {
  handler Pad1 {
    fn pad() { 1 }
  }
}

effect Pad2 {
  fn pad() -> Int
}

fn pad2() -> Handler<Pad2> {
  handler Pad2 {
    fn pad() { 2 }
  }
}

effect Pad3 {
  fn pad() -> Int
}

fn pad3() -> Handler<Pad3> {
  handler Pad3 {
    fn pad() { 3 }
  }
}

pub fn run(n: Int) -> Int {
  with counter() {
    with pad1() {
      with pad2() {
        with pad3() {
          var acc = 0
          var i = 0
          while i < n {
            acc = acc + Tick.next() % 7
            i = i + 1
          }
          acc
        }
      }
    }
  }
}

// `sakura run main.sakura -- <n>...` prints run(n) for each argument.
pub fn main() -> Unit ! {Cli, Console} {
  for arg in Cli.args() { Console.print("{run(Option.expect(String.parse_int(arg), "size"))}") }
}
