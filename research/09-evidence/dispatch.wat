;; Research microbenchmark, not Sakura compiler/runtime code. Fixed 16-byte frame.
(module
  (type $step (func (param i32) (result i32)))
  (memory (export "memory") 1 1)
  (table 2 2 funcref)
  (elem (i32.const 0) $step $tail)
  (func $step (type $step) (param $n i32) (result i32)
    (i32.store (i32.const 0) (i32.add (i32.load (i32.const 0)) (i32.const 1)))
    (i32.sub (local.get $n) (i32.const 1)))
  (func $tail (type $step) (param $n i32) (result i32)
    (if (i32.eqz (local.get $n)) (then (return (i32.const 0))))
    (i32.store (i32.const 0) (i32.add (i32.load (i32.const 0)) (i32.const 1)))
    (return_call_indirect (type $step)
      (i32.sub (local.get $n) (i32.const 1)) (i32.const 1)))
  (func (export "trampoline") (param $rounds i32) (result i32) (local $n i32)
    (i32.store (i32.const 0) (i32.const 0))
    (loop $outer
      (local.set $n (i32.const 1000000))
      (loop $dispatch
        (local.set $n (call_indirect (type $step) (local.get $n) (i32.const 0)))
        (br_if $dispatch (local.get $n)))
      (local.set $rounds (i32.sub (local.get $rounds) (i32.const 1)))
      (br_if $outer (local.get $rounds)))
    (i32.load (i32.const 0)))
  (func (export "tail") (param $rounds i32) (result i32)
    (i32.store (i32.const 0) (i32.const 0))
    (loop $outer
      (drop (call $tail (i32.const 1000000)))
      (local.set $rounds (i32.sub (local.get $rounds) (i32.const 1)))
      (br_if $outer (local.get $rounds)))
    (i32.load (i32.const 0)))
  (func (export "profile") (result i32 i32)
    (memory.fill (i32.const 16) (i32.const 7) (i32.const 16))
    (memory.copy (i32.const 32) (i32.const 16) (i32.const 16))
    (i32.load8_u (i32.const 32)) (i32.const 9))
  (func (export "div") (param i64 i64) (result i64)
    (i64.div_s (local.get 0) (local.get 1)))
  (func (export "rem") (param i64 i64) (result i64)
    (i64.rem_s (local.get 0) (local.get 1)))
)
